<Project>

  <!--
    全局编译设置。
    注意：AnalysisLevel 先设为 none，等契约稳定后再逐步收紧，
    否则首轮会出现大量 CA 规则噪音，掩盖真正的设计问题。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!--
      宿主（Sparrow.App / 测试）的目标框架：WGC 需要 Windows SDK 投影。
      插件仍用上面的 net10.0；插件的 CopyPluginToHost 也按这个属性找宿主输出目录，
      不能再用插件自己的 $(TargetFramework)，否则名字一变插件就复制到旧目录。
    -->
    <SparrowHostTargetFramework>net10.0-windows10.0.19041.0</SparrowHostTargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>none</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      NuGet 漏洞审计要联网查服务索引；受限网络下会抛 NU1900。
      本地构建不阻塞、不产生噪音；真正的审计放到 CI 的漏洞检查任务。
    -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

</Project>
