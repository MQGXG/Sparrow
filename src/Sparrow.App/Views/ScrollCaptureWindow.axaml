<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sparrow.App.Views.ScrollCaptureWindow"
        Title="SparrowScroll"
        Width="320"
        SizeToContent="Height"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

  <Border Background="{StaticResource OverlayBrush}"
          BorderBrush="{StaticResource AccentBorderBrush}"
          BorderThickness="1"
          CornerRadius="10"
          Padding="12,10"
          BoxShadow="0 12 32 0 #99000000">

    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
      <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
        <TextBlock Text="滚动页面，完成后点「完成」"
                   FontSize="12"
                   Foreground="{StaticResource TextPrimaryBrush}" />
        <TextBlock x:Name="ProgressText"
                   Text="等待滚动…"
                   FontSize="10"
                   Foreground="{StaticResource TextMutedBrush}" />
      </StackPanel>

      <StackPanel Grid.Row="0"
                  Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="6"
                  Margin="12,0,0,0">
        <Button x:Name="FinishButton"
                Classes="accent small"
                Content="完成"
                Click="OnFinishClick" />
        <Button Classes="ghost small"
                Content="取消"
                Click="OnCancelClick" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
