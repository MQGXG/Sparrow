<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sparrow.App.ViewModels"
        xmlns:controls="using:Sparrow.App.Controls"
        x:Class="Sparrow.App.Views.PaletteWindow"
        x:DataType="vm:PaletteViewModel"
        Title="Sparrow"
        Width="660"
        MaxHeight="560"
        SizeToContent="Height"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

  <!-- 抬起的浮层：阴影比描边更能表达层级 -->
  <Border x:Name="Shell"
          Background="{StaticResource SurfaceBrush}"
          BorderBrush="{StaticResource LineStrongBrush}"
          BorderThickness="1"
          CornerRadius="14"
          BoxShadow="0 24 64 0 #99000000"
          ClipToBounds="True">

    <!-- 出现时轻微上移 + 淡入，避免「啪」地弹出来 -->
    <Border.RenderTransform>
      <TranslateTransform Y="0">
        <TranslateTransform.Transitions>
          <Transitions>
            <DoubleTransition Property="Y" Duration="0:0:0.16" Easing="CubicEaseOut" />
          </Transitions>
        </TranslateTransform.Transitions>
      </TranslateTransform>
    </Border.RenderTransform>

    <Border.Transitions>
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
      </Transitions>
    </Border.Transitions>

    <StackPanel>

      <!-- 搜索行：图标 + 无边框输入框 -->
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="18,16,18,14">
        <Path Grid.Column="0"
              Width="16"
              Height="16"
              Margin="0,0,12,0"
              VerticalAlignment="Center"
              Stroke="{StaticResource TextMutedBrush}"
              StrokeThickness="1.6"
              StrokeLineCap="Round"
              Data="M9 3a6 6 0 1 0 0 12 6 6 0 0 0 0-12 M13.2 13.2 L17 17" />

        <TextBox x:Name="SearchBox"
                 Grid.Column="1"
                 Classes="bare"
                 PlaceholderText="搜索工具，或直接回车处理剪贴板内容"
                 Text="{Binding Query, Mode=TwoWay}"
                 VerticalAlignment="Center" />

        <Border Grid.Column="2" Classes="kbd" Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Esc" />
        </Border>
      </Grid>

      <Border Height="1" Background="{StaticResource LineBrush}" />

      <!-- 执行中的进度条：OCR 这类工具要 2 秒以上，没有反馈会以为没反应 -->
      <ProgressBar IsIndeterminate="True"
                   IsVisible="{Binding IsExecuting}"
                   Height="2"
                   MinHeight="2"
                   Background="Transparent"
                   Foreground="{StaticResource AccentBrush}" />

      <!-- 工具列表 -->
      <Panel>
        <ListBox x:Name="ResultList"
                 Margin="6,6"
                 MaxHeight="320"
                 ItemsSource="{Binding Items}"
                 SelectedItem="{Binding Selected, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ToolItemViewModel">
              <Grid ColumnDefinitions="*,Auto" Margin="12,9">
                <StackPanel Spacing="3">
                  <controls:HighlightTextBlock SourceText="{Binding Name}"
                                               Term="{Binding HighlightTerm}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                  <controls:HighlightTextBlock SourceText="{Binding Description}"
                                               Term="{Binding HighlightTerm}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Grid.Column="1"
                        Classes="chip"
                        Margin="14,0,0,0">
                  <TextBlock Text="{Binding CategoryLabel}"
                             FontSize="10"
                             Foreground="{StaticResource TextMutedBrush}" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- 空状态 -->
        <StackPanel IsVisible="{Binding IsEmpty}"
                    Margin="0,26,0,30"
                    Spacing="6"
                    HorizontalAlignment="Center">
          <TextBlock Text="没有匹配的工具"
                     FontSize="13"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     HorizontalAlignment="Center" />
          <TextBlock Text="试试 json、base64、ocr"
                     FontSize="11"
                     Foreground="{StaticResource TextMutedBrush}"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Panel>

      <!-- 成功结果 -->
      <Border IsVisible="{Binding HasResult}"
              Margin="14,2,14,0"
              Padding="12,10"
              CornerRadius="10"
              Background="{StaticResource SurfaceRaisedBrush}"
              BorderBrush="{StaticResource LineBrush}"
              BorderThickness="1">
        <Grid RowDefinitions="Auto,Auto">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding ResultTitle}"
                       FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}"
                       VerticalAlignment="Center" />

            <Button Grid.Column="1"
                    Classes="ghost small"
                    Content="复制"
                    Click="OnCopyClick" />
          </Grid>

          <ScrollViewer Grid.Row="1" MaxHeight="190" Margin="0,8,0,0">
            <SelectableTextBlock Text="{Binding ResultText}"
                                 FontFamily="{StaticResource MonoFont}"
                                 FontSize="12"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 TextWrapping="Wrap" />
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- 失败结果 -->
      <Border IsVisible="{Binding HasError}"
              Margin="14,2,14,0"
              Padding="12,10"
              CornerRadius="10"
              Background="{StaticResource DangerBgBrush}"
              BorderBrush="{StaticResource DangerLineBrush}"
              BorderThickness="1">
        <TextBlock Text="{Binding ErrorText}"
                   Foreground="{StaticResource DangerBrush}"
                   FontSize="12"
                   TextWrapping="Wrap" />
      </Border>

      <!-- 键盘提示 -->
      <StackPanel Orientation="Horizontal"
                  Spacing="6"
                  Margin="18,12,18,14">
        <Border Classes="kbd"><TextBlock Text="↑ ↓" /></Border>
        <TextBlock Text="选择" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />

        <Border Classes="kbd" Margin="8,0,0,0"><TextBlock Text="Enter" /></Border>
        <TextBlock Text="执行" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />

        <Border Classes="kbd" Margin="8,0,0,0"><TextBlock Text="Ctrl+C" /></Border>
        <TextBlock Text="复制" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />

        <Border Classes="kbd" Margin="8,0,0,0"><TextBlock Text="Esc" /></Border>
        <TextBlock Text="关闭" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
      </StackPanel>

    </StackPanel>
  </Border>
</Window>
