<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sparrow.App.ViewModels"
        xmlns:views="using:Sparrow.App.Views"
        xmlns:converters="using:Sparrow.App.Converters"
        x:Class="Sparrow.App.Views.ClipboardPanelWindow"
        x:DataType="vm:ClipboardHistoryViewModel"
        Title="麻雀 · 剪贴板"
        Width="440"
        Height="720"
        MinWidth="380"
        MinHeight="480"
        RequestedThemeVariant="Dark"
        Icon="avares://Sparrow.App/Assets/sparrow-64.png"
        ShowInTaskbar="False"
        WindowDecorations="None"
        CanResize="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <!-- 标题行的两个开关态：置顶 / 搜索展开时图标转琥珀 -->
    <Style Selector="Path.icon.pinned">
      <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Path.icon.active">
      <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    </Style>
  </Window.Styles>

  <!-- 无边框 + 自绘圆角：Windows 10 没有 DWM 圆角属性，只能这样画 -->
  <Border x:Name="Shell"
          Background="{StaticResource WindowBgGradientBrush}"
          BorderBrush="{StaticResource LineStrongBrush}"
          BorderThickness="1"
          CornerRadius="14"
          BoxShadow="0 18 48 0 #99000000"
          ClipToBounds="True">

    <Panel>

      <Border Background="{StaticResource DotGridBrush}" IsHitTestVisible="False" />

      <Grid RowDefinitions="Auto,*">

        <!-- 无边框窗口的拖动区与关闭入口。
             Background 必须给：没有背景的 Grid 不参与命中测试，事件会穿透到底下的 Shell -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              Height="26"
              Margin="14,6,10,0"
              Background="Transparent"
              PointerPressed="OnTitleBarPointerPressed">
          <StackPanel Grid.Column="0"
                      Orientation="Horizontal"
                      Spacing="6"
                      VerticalAlignment="Center">
            <Path Classes="icon icon-xs"
                  VerticalAlignment="Center"
                  Data="{StaticResource IconClipboard}" />
            <TextBlock Text="剪贴板"
                       FontSize="11"
                       Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      Spacing="2"
                      VerticalAlignment="Center">
            <Button x:Name="SearchToggle"
                    Classes="ghost"
                    Width="24"
                    Height="20"
                    Padding="0"
                    ToolTip.Tip="搜索"
                    AutomationProperties.Name="搜索"
                    Click="OnTitleSearchClick">
              <Path x:Name="SearchToggleIcon"
                    Classes="icon icon-xs"
                    Data="{StaticResource IconSearch}" />
            </Button>
            <Button x:Name="PinButton"
                    Classes="ghost"
                    Width="24"
                    Height="20"
                    Padding="0"
                    ToolTip.Tip="把面板置顶（不被其他窗口盖住）"
                    AutomationProperties.Name="置顶"
                    Click="OnTitlePinClick">
              <Path x:Name="PinIcon"
                    Classes="icon icon-xs"
                    Data="{StaticResource IconPin}" />
            </Button>
            <Button Classes="ghost"
                    Width="24"
                    Height="20"
                    Padding="0"
                    ToolTip.Tip="收起面板（Esc）"
                    AutomationProperties.Name="关闭"
                    Click="OnTitleCloseClick">
              <Path Classes="icon icon-xs"
                    Data="{StaticResource IconClose}" />
            </Button>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1"
              RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto"
              RowSpacing="8"
              Margin="14,10,14,10">

      <!-- 搜索行默认收起，点标题行的 🔍 才展开 -->
      <Grid x:Name="SearchRow"
            Grid.Row="0"
            ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto"
            IsVisible="False">
        <TextBox x:Name="SearchBox"
                 Text="{Binding Query, Mode=TwoWay}"
                 PlaceholderText="搜索内容、标签、来源…">
          <TextBox.InnerLeftContent>
            <Path Classes="icon icon-sm"
                  Data="{StaticResource IconSearch}" />
          </TextBox.InnerLeftContent>
        </TextBox>
        <Button Grid.Column="1"
                Classes="ghost small"
                Width="30"
                Padding="0"
                Margin="8,0,0,0"
                IsVisible="{Binding CanUndoDelete}"
                ToolTip.Tip="撤销删除"
                AutomationProperties.Name="撤销删除"
                Click="OnUndoDeleteClick">
          <Path Classes="icon icon-xs"
                Data="{StaticResource IconUndo}" />
        </Button>
        <!-- 危险确认保留文字：图标在这一步没有「确定要删」的语义。
             「清空」入口收进了右侧 ⋯ 菜单，这一行只在确认态出现 -->
        <Button Grid.Column="2"
                Classes="ghost small danger"
                Content="确认清空"
                Margin="8,0,0,0"
                IsVisible="{Binding IsClearConfirmVisible}"
                Click="OnClearConfirmClick" />
        <Button Grid.Column="3"
                Classes="ghost small"
                Width="30"
                Padding="0"
                Margin="6,0,0,0"
                IsVisible="{Binding IsClearConfirmVisible}"
                ToolTip.Tip="取消"
                AutomationProperties.Name="取消"
                Click="OnClearCancelClick">
          <Path Classes="icon icon-xs"
                Data="{StaticResource IconClose}" />
        </Button>
        <Button Grid.Column="5"
                Classes="ghost small"
                Width="30"
                Padding="0"
                Margin="8,0,0,0"
                ToolTip.Tip="更多：不记录某个来源的复制、清空全部历史"
                AutomationProperties.Name="更多">
          <Path Classes="icon icon-xs icon-dot"
                Data="{StaticResource IconMore}" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="{Binding ExclusionButtonLabel}"
                        IsEnabled="{Binding CanToggleExclusion}"
                        Click="OnExclusionClick" />
              <Separator />
              <!-- 低频危险操作收在这里：搜索行只留撤销，避免一行塞六个控件 -->
              <MenuItem Header="清空全部历史…"
                        Click="OnClearClick" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <ComboBox Grid.Column="4"
                  ItemsSource="{Binding SourceFilters}"
                  SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                  MinWidth="96"
                  Margin="8,0,0,0"
                  VerticalAlignment="Center" />
      </Grid>

      <ItemsControl Grid.Row="1" ItemsSource="{Binding Kinds}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ClipboardFilterViewModel">
              <Button Classes="hud-chip"
                      Margin="0,0,6,6"
                      Classes.selected="{Binding IsSelected}"
                      IsVisible="{Binding IsShown}"
                      ToolTip.Tip="{Binding Name}"
                      Tag="{Binding}"
                      Click="OnKindClick">
                <!-- 图标 + 计数：原来「名称 + 计数」五个 chip 会把搜索行挤扁 -->
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Path Classes="icon icon-xs"
                        VerticalAlignment="Center"
                        Data="{Binding Name, Converter={x:Static converters:ClipboardKindIconConverter.Instance}}" />
                  <TextBlock Text="{Binding Count}"
                             Classes="num"
                             Opacity="0.85"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      <ItemsControl Grid.Row="2"
                    ItemsSource="{Binding TagFilters}"
                    IsVisible="{Binding HasTagFilters}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ClipboardFilterViewModel">
            <Button Classes="hud-chip"
                    Margin="0,0,6,6"
                    Classes.selected="{Binding IsSelected}"
                    Tag="{Binding}"
                    Click="OnTagFilterClick">
              <TextBlock Text="{Binding Name}" />
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 粘贴队列：和工作区剪贴板页同一套能力，Ctrl+点击行可增减 -->
      <Border Grid.Row="3"
              IsVisible="{Binding HasQueue}"
              Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource LineBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="10,7">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Border Classes="hud-tick" Height="11" />
            <TextBlock Text="粘贴队列"
                       Classes="section"
                       VerticalAlignment="Center" />
          </StackPanel>

          <ScrollViewer Grid.Column="1"
                        Margin="10,0"
                        VerticalScrollBarVisibility="Disabled"
                        HorizontalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Queue}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ClipboardQueueItemViewModel">
                  <Button Classes="hud-chip"
                          Content="{Binding Label}"
                          Tag="{Binding}"
                          ToolTip.Tip="点击移出队列"
                          Click="OnQueueRemoveClick" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
            <Button x:Name="QueueCopyNextButton"
                    Classes="ghost small"
                    Width="30"
                    Padding="0"
                    ToolTip.Tip="复制下一条：写入剪贴板，自己在目标应用按 Ctrl+V"
                    AutomationProperties.Name="复制下一条"
                    Click="OnCopyNextClick">
              <Path Classes="icon icon-xs"
                    Data="{StaticResource IconPaste}" />
            </Button>
            <Button x:Name="QueueClearButton"
                    Classes="ghost small"
                    Width="30"
                    Padding="0"
                    ToolTip.Tip="清空队列"
                    AutomationProperties.Name="清空队列"
                    Click="OnQueueClearClick">
              <Path Classes="icon icon-xs"
                    Data="{StaticResource IconTrash}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="4"
              Classes="panel"
              Padding="4">
        <Grid>
          <ScrollViewer IsVisible="{Binding HasItems}">
            <ItemsControl ItemsSource="{Binding Groups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ClipboardGroupViewModel">
                  <StackPanel Margin="0,2,0,8">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="8,2,8,4">
                      <Border Classes="hud-tick" Height="10" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding Title}"
                                 FontSize="10"
                                 FontWeight="SemiBold"
                                 LetterSpacing="0.8"
                                 Margin="6,0,0,0"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource TextMutedBrush}" />
                      <Border Grid.Column="2"
                              Classes="hud-line"
                              Margin="10,0"
                              VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3"
                                 Classes="num"
                                 Text="{Binding Items.Count}"
                                 VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ClipboardEntryViewModel">
                          <Border Margin="0,5"
                                  Padding="8,8"
                                  CornerRadius="10"
                                  Background="{StaticResource SurfaceBrush}"
                                  BorderBrush="{StaticResource LineBrush}"
                                  BorderThickness="1"
                                  Cursor="Hand"
                                  Classes="clip-row"
                                  Classes.selected="{Binding IsSelected}"
                                  Tag="{Binding}"
                                  Loaded="OnRowLoaded"
                                  Tapped="OnItemClick"
                                  DoubleTapped="OnItemDoubleTapped"
                                  PointerPressed="OnItemPointerPressed"
                                  PointerMoved="OnItemPointerMoved"
                                  PointerReleased="OnItemPointerReleased">
                            <Border.Styles>
                              <Style Selector="Border.clip-row:pointerover">
                                <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                              </Style>
                              <Style Selector="Border.clip-row.selected">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                              </Style>
                              <!-- 图标按钮：22×22，悬停只换底色和描边色 -->
                              <Style Selector="Button.row-icon">
                                <Setter Property="Width" Value="22" />
                                <Setter Property="Height" Value="22" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="CornerRadius" Value="4" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                              </Style>
                              <Style Selector="Button.row-icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                              </Style>
                              <Style Selector="Button.row-icon:pointerover Path">
                                <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                              </Style>

                              <!--
                                悬停浮层：默认藏在右侧 16px 且透明，悬停或选中时从右滑入。
                                用 Opacity 而不是 IsVisible——IsVisible 是瞬时切换，没有过渡；
                                默认态必须同时 IsHitTestVisible=False，否则看不见的按钮还能被点到。
                              -->
                              <Style Selector="Border.clip-row Border.row-actions">
                                <Setter Property="Opacity" Value="0" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Setter Property="RenderTransform" Value="translate(16px,0)" />
                              </Style>
                              <Style Selector="Border.clip-row:pointerover Border.row-actions">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="IsHitTestVisible" Value="True" />
                                <Setter Property="RenderTransform" Value="translate(0px,0)" />
                              </Style>
                              <Style Selector="Border.clip-row.selected Border.row-actions">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="IsHitTestVisible" Value="True" />
                                <Setter Property="RenderTransform" Value="translate(0px,0)" />
                              </Style>
                            </Border.Styles>

                            <Panel>
                              <StackPanel Spacing="6">
                                <!-- 元信息常驻：类型 · 字数/尺寸 · 时间 · 来源；右侧留 26px 给来源图标 -->
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6"
                                            Margin="0,0,26,0">
                                  <TextBlock Text="{Binding KindLabel}"
                                             FontSize="10"
                                             Foreground="{StaticResource TextMutedBrush}" />
                                  <TextBlock Text="{Binding SizeLabel}"
                                             FontSize="10"
                                             Foreground="{StaticResource TextMutedBrush}" />
                                  <TextBlock Text="·"
                                             FontSize="10"
                                             Foreground="{StaticResource TextMutedBrush}" />
                                  <TextBlock Text="{Binding TimeLabel}"
                                             FontSize="10"
                                             Foreground="{StaticResource TextMutedBrush}" />
                                  <TextBlock Text="·"
                                             FontSize="10"
                                             IsVisible="{Binding HasSource}"
                                             Foreground="{StaticResource TextMutedBrush}" />
                                  <TextBlock Text="{Binding SourceLabel}"
                                             FontSize="10"
                                             TextTrimming="CharacterEllipsis"
                                             IsVisible="{Binding HasSource}"
                                             Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>

                                <!-- 图片条目：缩略图按比例，限高 120 -->
                                <Border IsVisible="{Binding HasThumbnail}"
                                        MaxHeight="120"
                                        CornerRadius="6"
                                        ClipToBounds="True">
                                  <Image Source="{Binding Thumbnail, Converter={x:Static converters:ByteArrayToBitmapConverter.Instance}, ConverterParameter=thumb}"
                                         MaxHeight="120"
                                         Stretch="Uniform"
                                         HorizontalAlignment="Center" />
                                </Border>

                                <!-- 链接条目：首字母色块 + 域名 + URL -->
                                <StackPanel IsVisible="{Binding IsLink}"
                                            Orientation="Horizontal"
                                            Spacing="10">
                                  <Border Width="36"
                                          Height="36"
                                          CornerRadius="6"
                                          Background="{StaticResource AccentSoftBrush}"
                                          VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LinkInitial}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                  </Border>
                                  <StackPanel Spacing="2"
                                              VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LinkHost}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Preview}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                  </StackPanel>
                                </StackPanel>

                                <!-- 文件条目：文件图标 + 文件名 -->
                                <StackPanel IsVisible="{Binding IsFileSet}"
                                            Orientation="Horizontal"
                                            Spacing="10">
                                  <Border Width="36"
                                          Height="36"
                                          CornerRadius="6"
                                          Background="{StaticResource SurfaceRaisedBrush}"
                                          BorderBrush="{StaticResource LineBrush}"
                                          BorderThickness="1"
                                          VerticalAlignment="Center">
                                    <Panel>
                                      <!-- 文件已被删除时取不到图标，回退到类型图标 -->
                                      <Path Classes="icon icon-md"
                                            Data="{StaticResource IconFile}"
                                            IsVisible="{Binding !HasFileIcon}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                      <Image Source="{Binding FileIconPng, Converter={x:Static converters:ByteArrayToBitmapConverter.Instance}}"
                                             IsVisible="{Binding HasFileIcon}"
                                             Stretch="Uniform"
                                             Margin="3" />
                                    </Panel>
                                  </Border>
                                  <StackPanel Spacing="2"
                                              VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileTitle}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding FileSubtitle}"
                                               FontSize="10"
                                               IsVisible="{Binding HasFileSubtitle}"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                  </StackPanel>
                                </StackPanel>

                                <!-- 文本条目：最多两行 -->
                                <TextBlock Text="{Binding Preview}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           IsVisible="{Binding ShowPlainPreview}" />

                                <!-- 标签：图片条目已有「图片」类型，不再重复自动标签 -->
                                <TextBlock Text="{Binding TagLine}"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource AccentBrush}"
                                           IsVisible="{Binding ShowTagLine}" />
                              </StackPanel>

                              <!-- 来源应用图标：常驻右上角，hover 时工具条从右滑入盖住它 -->
                              <Border Classes="row-source"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      Width="18"
                                      Height="18"
                                      IsVisible="{Binding HasSource}">
                                <Panel>
                                  <!-- 来源进程已退出时拿不到真图标，回退到进程名首字母 -->
                                  <Border Background="{StaticResource SurfaceRaisedBrush}"
                                          BorderBrush="{StaticResource LineBrush}"
                                          BorderThickness="1"
                                          CornerRadius="4"
                                          IsVisible="{Binding !HasSourceIcon}">
                                    <TextBlock Text="{Binding SourceInitial}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                  </Border>
                                  <Image Source="{Binding SourceIconPng, Converter={x:Static converters:ByteArrayToBitmapConverter.Instance}}"
                                         IsVisible="{Binding HasSourceIcon}"
                                         Stretch="Uniform"
                                         Margin="1" />
                                </Panel>
                              </Border>

                              <!-- 悬停浮层：查看 / 复制 / 粘贴 / 打开 / 队列 / 收藏 / 删除 -->
                              <Border Classes="row-actions"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      Background="{StaticResource SurfaceRaisedBrush}"
                                      BorderBrush="{StaticResource LineBrush}"
                                      BorderThickness="1"
                                      CornerRadius="8"
                                      Padding="2">
                                <Border.Transitions>
                                  <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
                                    <TransformOperationsTransition Property="RenderTransform"
                                                                   Duration="0:0:0.16"
                                                                   Easing="CubicEaseOut" />
                                  </Transitions>
                                </Border.Transitions>
                                <StackPanel Orientation="Horizontal" Spacing="1">
                                  <Button Classes="row-icon"
                                          ToolTip.Tip="在面板内查看详情"
                                          AutomationProperties.Name="查看详情"
                                          Tag="{Binding}"
                                          Click="OnOpenDetailClick">
                                    <Path Classes="icon icon-xs"
                                          Data="{StaticResource IconEye}" />
                                  </Button>
                                  <Button Classes="row-icon"
                                          ToolTip.Tip="复制"
                                          AutomationProperties.Name="复制"
                                          Tag="{Binding}"
                                          Click="OnRowCopyClick">
                                    <Path Classes="icon icon-xs"
                                          Data="{StaticResource IconCopy}" />
                                  </Button>
                                  <Button Classes="row-icon"
                                          ToolTip.Tip="粘贴到刚才的应用"
                                          AutomationProperties.Name="粘贴到刚才的应用"
                                          Tag="{Binding}"
                                          Click="OnRowPasteClick">
                                    <Path Classes="icon icon-xs"
                                          Data="{StaticResource IconPaste}" />
                                  </Button>
                                  <Button Classes="row-icon"
                                          ToolTip.Tip="用默认程序打开"
                                          AutomationProperties.Name="打开"
                                          IsVisible="{Binding CanOpen}"
                                          Tag="{Binding}"
                                          Click="OnRowOpenClick">
                                    <Path Classes="icon icon-xs"
                                          Data="{StaticResource IconOpen}" />
                                  </Button>
                                  <Button Classes="row-icon"
                                          ToolTip.Tip="加入 / 移出顺序粘贴队列"
                                          AutomationProperties.Name="顺序粘贴队列"
                                          Tag="{Binding}"
                                          Click="OnQueueToggleClick">
                                    <TextBlock Classes="num"
                                               Text="{Binding QueueBadge}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                  </Button>
                                  <Button Classes="row-icon"
                                          ToolTip.Tip="收藏 / 取消收藏"
                                          AutomationProperties.Name="收藏"
                                          Tag="{Binding}"
                                          Click="OnFavoriteClick">
                                    <Path Classes="icon icon-xs star"
                                          Classes.favorite="{Binding IsFavorite}"
                                          Data="{StaticResource IconStar}" />
                                  </Button>
                                  <Button Classes="row-icon"
                                          ToolTip.Tip="删除（可撤销）"
                                          AutomationProperties.Name="删除"
                                          Tag="{Binding}"
                                          Click="OnRowDeleteClick">
                                    <Path Classes="icon icon-xs"
                                          Data="{StaticResource IconTrash}" />
                                  </Button>
                                </StackPanel>
                              </Border>
                            </Panel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <StackPanel IsVisible="{Binding IsEmpty}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="8">
            <TextBlock Text="剪贴板还是空的"
                       HorizontalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Text="复制点什么，再按一次热键试试"
                       HorizontalAlignment="Center"
                       FontSize="10"
                       Foreground="{StaticResource TextMutedBrush}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- 状态栏：条数 / 容量配额 + 随队列变化的快捷键提示 -->
      <Grid Grid.Row="5" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <TextBlock Classes="num"
                   Text="{Binding StatusBarText}"
                   MaxWidth="200"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Classes="num"
                   Text="{Binding StatusText}"
                   IsVisible="{Binding HasStatus}"
                   Foreground="{StaticResource AccentBrush}"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="2"
                   Classes="num"
                   Text="{Binding StatusHint}"
                   MaxWidth="230"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
      </Grid>

      <!-- 容量条：最窄保留 3%，空库也能看出这条是进度 -->
      <ProgressBar Grid.Row="6"
                   Minimum="0"
                   Maximum="1"
                   Value="{Binding CapacityRatio}"
                   Height="2"
                   MinHeight="2"
                   Margin="0,4,0,0"
                   CornerRadius="1"
                   Background="{StaticResource LineBrush}"
                   Foreground="{StaticResource AccentBrush}" />
    </Grid>

    <!-- 详情覆盖层：盖住搜索和列表，← / Esc 回到列表；复制后整个面板收起 -->
    <Panel x:Name="DetailLayer" IsVisible="False">
      <Border Background="#CC07090B"
              PointerPressed="OnDetailBackdropPressed" />
      <Border Margin="10"
              CornerRadius="10"
              BorderBrush="{StaticResource LineStrongBrush}"
              BorderThickness="1"
              ClipToBounds="True"
              Background="{StaticResource WindowBgGradientBrush}">
        <views:ClipboardDetailView x:Name="DetailView"
                                   CloseRequested="OnDetailCloseRequested"
                                   Copied="OnDetailCopied" />
      </Border>
    </Panel>
      </Grid>
    </Panel>
  </Border>
</Window>
