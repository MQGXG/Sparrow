<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sparrow.App.ViewModels"
        xmlns:views="using:Sparrow.App.Views"
        xmlns:converters="using:Sparrow.App.Converters"
        x:Class="Sparrow.App.Views.ClipboardPanelWindow"
        x:DataType="vm:ClipboardHistoryViewModel"
        Title="麻雀 · 剪贴板"
        Width="440"
        Height="720"
        MinWidth="380"
        MinHeight="480"
        RequestedThemeVariant="Dark"
        Icon="avares://Sparrow.App/Assets/sparrow-32.png"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">

  <Panel>

    <Border Background="{StaticResource DotGridBrush}" IsHitTestVisible="False" />

    <!-- 只有搜索 + 筛选 + 列表：不带主窗的品牌栏和切换行 -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto"
          RowSpacing="8"
          Margin="14,12,14,10">

      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
        <TextBox x:Name="SearchBox"
                 Text="{Binding Query, Mode=TwoWay}"
                 PlaceholderText="搜索内容、标签、来源…" />
        <Button Grid.Column="1"
                Classes="ghost small"
                Content="撤销删除"
                Margin="8,0,0,0"
                IsVisible="{Binding CanUndoDelete}"
                Click="OnUndoDeleteClick" />
        <Button Grid.Column="2"
                Classes="ghost small"
                Content="清空"
                Margin="8,0,0,0"
                IsVisible="{Binding !IsClearConfirmVisible}"
                Click="OnClearClick" />
        <Button Grid.Column="2"
                Classes="ghost small danger"
                Content="确认清空"
                Margin="8,0,0,0"
                IsVisible="{Binding IsClearConfirmVisible}"
                Click="OnClearConfirmClick" />
        <Button Grid.Column="3"
                Classes="ghost small"
                Content="取消"
                Margin="6,0,0,0"
                IsVisible="{Binding IsClearConfirmVisible}"
                Click="OnClearCancelClick" />
        <Button Grid.Column="5"
                Classes="ghost small"
                Content="⋯"
                Width="30"
                Padding="0"
                Margin="8,0,0,0"
                ToolTip.Tip="更多：不记录某个来源的复制">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="{Binding ExclusionButtonLabel}"
                        IsEnabled="{Binding CanToggleExclusion}"
                        Click="OnExclusionClick" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <ComboBox Grid.Column="4"
                  ItemsSource="{Binding SourceFilters}"
                  SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                  MinWidth="96"
                  Margin="8,0,0,0"
                  VerticalAlignment="Center" />
      </Grid>

      <ItemsControl Grid.Row="1" ItemsSource="{Binding Kinds}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ClipboardFilterViewModel">
              <Button Classes="hud-chip"
                      Margin="0,0,6,6"
                      Classes.selected="{Binding IsSelected}"
                      IsVisible="{Binding IsShown}"
                      Tag="{Binding}"
                      Click="OnKindClick">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Text="{Binding Count}"
                             Classes="num"
                             Opacity="0.75"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      <ItemsControl Grid.Row="2"
                    ItemsSource="{Binding TagFilters}"
                    IsVisible="{Binding HasTagFilters}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ClipboardFilterViewModel">
            <Button Classes="hud-chip"
                    Margin="0,0,6,6"
                    Classes.selected="{Binding IsSelected}"
                    Tag="{Binding}"
                    Click="OnTagFilterClick">
              <TextBlock Text="{Binding Name}" />
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 粘贴队列：和工作区剪贴板页同一套能力，Ctrl+点击行可增减 -->
      <Border Grid.Row="3"
              IsVisible="{Binding HasQueue}"
              Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource LineBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="10,7">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Border Classes="hud-tick" Height="11" />
            <TextBlock Text="粘贴队列"
                       Classes="section"
                       VerticalAlignment="Center" />
          </StackPanel>

          <ScrollViewer Grid.Column="1"
                        Margin="10,0"
                        VerticalScrollBarVisibility="Disabled"
                        HorizontalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Queue}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ClipboardQueueItemViewModel">
                  <Button Classes="hud-chip"
                          Content="{Binding Label}"
                          Tag="{Binding}"
                          ToolTip.Tip="点击移出队列"
                          Click="OnQueueRemoveClick" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
            <Button x:Name="QueueCopyNextButton"
                    Classes="ghost small"
                    Content="复制下一条"
                    ToolTip.Tip="写入剪贴板，自己在目标应用按 Ctrl+V"
                    Click="OnCopyNextClick" />
            <Button x:Name="QueueClearButton"
                    Classes="ghost small"
                    Content="清空"
                    Click="OnQueueClearClick" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="4"
              Classes="panel"
              Padding="4">
        <Grid>
          <ScrollViewer IsVisible="{Binding HasItems}">
            <ItemsControl ItemsSource="{Binding Groups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ClipboardGroupViewModel">
                  <StackPanel Margin="0,2,0,8">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="8,2,8,4">
                      <Border Classes="hud-tick" Height="10" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding Title}"
                                 FontSize="10"
                                 FontWeight="SemiBold"
                                 LetterSpacing="0.8"
                                 Margin="6,0,0,0"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource TextMutedBrush}" />
                      <Border Grid.Column="2"
                              Classes="hud-line"
                              Margin="10,0"
                              VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3"
                                 Classes="num"
                                 Text="{Binding Items.Count}"
                                 VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ClipboardEntryViewModel">
                          <Border Margin="0,5"
                                  Padding="8,8"
                                  CornerRadius="10"
                                  Background="{StaticResource SurfaceBrush}"
                                  BorderBrush="{StaticResource LineBrush}"
                                  BorderThickness="1"
                                  Cursor="Hand"
                                  Classes="clip-row"
                                  Classes.selected="{Binding IsSelected}"
                                  Tag="{Binding}"
                                  Tapped="OnItemClick"
                                  DoubleTapped="OnItemDoubleTapped"
                                  PointerPressed="OnItemPointerPressed"
                                  PointerMoved="OnItemPointerMoved"
                                  PointerReleased="OnItemPointerReleased">
                            <Border.ContextMenu>
                              <ContextMenu>
                                <MenuItem Header="复制"
                                          Click="OnMenuCopy" />
                                <Separator />
                                <MenuItem Header="复制为纯文本"
                                          Tag="PlainText"
                                          Click="OnMenuTransform" />
                                <MenuItem Header="全部大写"
                                          Tag="Upper"
                                          Click="OnMenuTransform" />
                                <MenuItem Header="全部小写"
                                          Tag="Lower"
                                          Click="OnMenuTransform" />
                                <MenuItem Header="每词首字母大写"
                                          Tag="Capitalize"
                                          Click="OnMenuTransform" />
                                <MenuItem Header="句首大写"
                                          Tag="Sentence"
                                          Click="OnMenuTransform" />
                                <MenuItem Header="驼峰命名"
                                          Tag="Camel"
                                          Click="OnMenuTransform" />
                                <MenuItem Header="去掉首尾空白"
                                          Tag="Trim"
                                          Click="OnMenuTransform" />
                              </ContextMenu>
                            </Border.ContextMenu>
                            <Border.Styles>
                              <Style Selector="Border.clip-row:pointerover">
                                <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                              </Style>
                              <Style Selector="Border.clip-row.selected">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                              </Style>
                              <!-- 图标按钮：22×22，悬停只换底色和描边色 -->
                              <Style Selector="Button.row-icon">
                                <Setter Property="Width" Value="22" />
                                <Setter Property="Height" Value="22" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="CornerRadius" Value="4" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                              </Style>
                              <Style Selector="Button.row-icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                              </Style>
                              <Style Selector="Button.row-icon Path">
                                <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
                                <Setter Property="StrokeThickness" Value="1.4" />
                                <Setter Property="Width" Value="13" />
                                <Setter Property="Height" Value="13" />
                                <Setter Property="Stretch" Value="Uniform" />
                              </Style>
                              <Style Selector="Button.row-icon:pointerover Path">
                                <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                              </Style>

                              <!-- 操作浮层：默认不可见，悬停或选中才出现 -->
                              <Style Selector="Border.clip-row Border.row-actions">
                                <Setter Property="IsVisible" Value="False" />
                              </Style>
                              <Style Selector="Border.clip-row:pointerover Border.row-actions">
                                <Setter Property="IsVisible" Value="True" />
                              </Style>
                              <Style Selector="Border.clip-row.selected Border.row-actions">
                                <Setter Property="IsVisible" Value="True" />
                              </Style>
                            </Border.Styles>

                            <Panel>
                              <StackPanel Spacing="6">
                                <!-- 元信息常驻：类型 · 字数/尺寸 · 时间 · 来源 -->
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <TextBlock Text="{Binding KindLabel}"
                                             FontSize="10"
                                             Foreground="{StaticResource TextMutedBrush}" />
                                  <TextBlock Text="{Binding SizeLabel}"
                                             FontSize="10"
                                             Foreground="{StaticResource TextMutedBrush}" />
                                  <TextBlock Text="·"
                                             FontSize="10"
                                             Foreground="{StaticResource TextMutedBrush}" />
                                  <TextBlock Text="{Binding TimeLabel}"
                                             FontSize="10"
                                             Foreground="{StaticResource TextMutedBrush}" />
                                  <TextBlock Text="·"
                                             FontSize="10"
                                             IsVisible="{Binding HasSource}"
                                             Foreground="{StaticResource TextMutedBrush}" />
                                  <TextBlock Text="{Binding SourceLabel}"
                                             FontSize="10"
                                             TextTrimming="CharacterEllipsis"
                                             IsVisible="{Binding HasSource}"
                                             Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>

                                <!-- 图片条目：缩略图按比例，限高 120 -->
                                <Border IsVisible="{Binding HasThumbnail}"
                                        MaxHeight="120"
                                        CornerRadius="6"
                                        ClipToBounds="True">
                                  <Image Source="{Binding Thumbnail, Converter={x:Static converters:ByteArrayToBitmapConverter.Instance}}"
                                         MaxHeight="120"
                                         Stretch="Uniform"
                                         HorizontalAlignment="Center" />
                                </Border>

                                <!-- 链接条目：首字母色块 + 域名 + URL -->
                                <StackPanel IsVisible="{Binding IsLink}"
                                            Orientation="Horizontal"
                                            Spacing="10">
                                  <Border Width="36"
                                          Height="36"
                                          CornerRadius="6"
                                          Background="{StaticResource AccentSoftBrush}"
                                          VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LinkInitial}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                  </Border>
                                  <StackPanel Spacing="2"
                                              VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LinkHost}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Preview}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                  </StackPanel>
                                </StackPanel>

                                <!-- 文件条目：文件图标 + 文件名 -->
                                <StackPanel IsVisible="{Binding IsFileSet}"
                                            Orientation="Horizontal"
                                            Spacing="10">
                                  <Border Width="36"
                                          Height="36"
                                          CornerRadius="6"
                                          Background="{StaticResource SurfaceRaisedBrush}"
                                          BorderBrush="{StaticResource LineBrush}"
                                          BorderThickness="1"
                                          VerticalAlignment="Center">
                                    <TextBlock Text="件"
                                               FontSize="13"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                  </Border>
                                  <StackPanel Spacing="2"
                                              VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileTitle}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding FileSubtitle}"
                                               FontSize="10"
                                               IsVisible="{Binding HasFileSubtitle}"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                  </StackPanel>
                                </StackPanel>

                                <!-- 文本条目：最多两行 -->
                                <TextBlock Text="{Binding Preview}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           IsVisible="{Binding ShowPlainPreview}" />

                                <!-- 标签：图片条目已有「图片」类型，不再重复自动标签 -->
                                <TextBlock Text="{Binding TagLine}"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource AccentBrush}"
                                           IsVisible="{Binding ShowTagLine}" />
                              </StackPanel>

                              <!-- 悬停浮层：查看 / 队列 / 收藏，三个等宽图标 -->
                              <Border Classes="row-actions"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      Background="{StaticResource SurfaceRaisedBrush}"
                                      BorderBrush="{StaticResource LineBrush}"
                                      BorderThickness="1"
                                      CornerRadius="8"
                                      Padding="2">
                                <StackPanel Orientation="Horizontal" Spacing="1">
                                  <Button Classes="row-icon"
                                          Width="22"
                                          Height="22"
                                          Padding="0"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ToolTip.Tip="在面板内查看详情"
                                          Tag="{Binding}"
                                          Click="OnOpenDetailClick">
                                    <Path Width="13"
                                          Height="13"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource TextSecondaryBrush}"
                                          StrokeThickness="1.4"
                                          Data="M1.5 8S4 3.5 8 3.5 14.5 8 14.5 8 12 12.5 8 12.5 1.5 8 1.5 8z M8 6.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3z" />
                                  </Button>
                                  <Button Classes="row-icon"
                                          Width="22"
                                          Height="22"
                                          Padding="0"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ToolTip.Tip="加入 / 移出顺序粘贴队列"
                                          Tag="{Binding}"
                                          Click="OnQueueToggleClick">
                                    <TextBlock Text="{Binding QueueBadge}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                  </Button>
                                  <Button Classes="row-icon"
                                          Width="22"
                                          Height="22"
                                          Padding="0"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ToolTip.Tip="收藏 / 取消收藏"
                                          Tag="{Binding}"
                                          Click="OnFavoriteClick">
                                    <TextBlock Text="{Binding FavoriteGlyph}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                  </Button>
                                </StackPanel>
                              </Border>
                            </Panel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <StackPanel IsVisible="{Binding IsEmpty}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="8">
            <TextBlock Text="剪贴板还是空的"
                       HorizontalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Text="复制点什么，再按一次热键试试"
                       HorizontalAlignment="Center"
                       FontSize="10"
                       Foreground="{StaticResource TextMutedBrush}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- 状态栏：条数 / 容量配额 + 随队列变化的快捷键提示 -->
      <Grid Grid.Row="5" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <TextBlock Classes="num"
                   Text="{Binding StatusBarText}"
                   MaxWidth="200"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Classes="num"
                   Text="{Binding StatusText}"
                   IsVisible="{Binding HasStatus}"
                   Foreground="{StaticResource AccentBrush}"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="2"
                   Classes="num"
                   Text="{Binding StatusHint}"
                   MaxWidth="230"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
      </Grid>

      <!-- 容量条：最窄保留 3%，空库也能看出这条是进度 -->
      <ProgressBar Grid.Row="6"
                   Minimum="0"
                   Maximum="1"
                   Value="{Binding CapacityRatio}"
                   Height="2"
                   MinHeight="2"
                   Margin="0,4,0,0"
                   CornerRadius="1"
                   Background="{StaticResource LineBrush}"
                   Foreground="{StaticResource AccentBrush}" />
    </Grid>

    <!-- 详情覆盖层：盖住搜索和列表，← / Esc 回到列表；复制后整个面板收起 -->
    <Panel x:Name="DetailLayer" IsVisible="False">
      <Border Background="#CC07090B"
              PointerPressed="OnDetailBackdropPressed" />
      <Border Margin="10"
              CornerRadius="10"
              BorderBrush="{StaticResource LineStrongBrush}"
              BorderThickness="1"
              ClipToBounds="True"
              Background="{StaticResource WindowBgGradientBrush}">
        <views:ClipboardDetailView x:Name="DetailView"
                                   CloseRequested="OnDetailCloseRequested"
                                   Copied="OnDetailCopied" />
      </Border>
    </Panel>
  </Panel>
</Window>
