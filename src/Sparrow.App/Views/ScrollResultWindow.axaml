<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sparrow.App.Views.ScrollResultWindow"
        Title="Sparrow · 滚动截图"
        Width="820"
        Height="660"
        MinWidth="480"
        MinHeight="400"
        Icon="avares://Sparrow.App/Assets/sparrow-64.png"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">

  <Grid RowDefinitions="Auto,*,Auto" Margin="16"> 

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="3">
        <TextBlock Classes="subtitle"
                   Text="滚动截图" />
        <TextBlock x:Name="SizeText"
                   Classes="num" />
      </StackPanel>

      <Button Grid.Column="1"
              Classes="ghost small"
              Content="关闭"
              Click="OnCloseClick" />
    </Grid>

    <Grid Grid.Row="1"
          ColumnDefinitions="*,Auto"
          Margin="0,12,0,0">
      <Border Grid.Column="0"
              Classes="panel"
              Padding="8">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <Image x:Name="Preview"
                 Stretch="Uniform"
                 HorizontalAlignment="Stretch" />
        </ScrollViewer>
      </Border>

      <!-- 整图缩略 + 头尾裁剪手柄 -->
      <Border Grid.Column="1"
              Width="64"
              Margin="12,0,0,0"
              Padding="6"
              Classes="panel"
              ToolTip.Tip="拖动琥珀色手柄裁掉长图头尾">
        <Grid>
          <Image x:Name="TrimOverview"
                 Stretch="Fill"
                 Opacity="0.85" />

          <Canvas x:Name="TrimTrack"
                  Background="Transparent"
                  ClipToBounds="True"
                  Cursor="SizeNorthSouth"
                  PointerPressed="OnTrimPointerPressed"
                  PointerMoved="OnTrimPointerMoved"
                  PointerReleased="OnTrimPointerReleased"
                  PointerCaptureLost="OnTrimPointerCaptureLost">
            <Border x:Name="TrimTopShade" Background="#99000000" />
            <Border x:Name="TrimBottomShade" Background="#99000000" />
            <Border x:Name="TrimTopHandle" Height="6" Background="{StaticResource AccentBrush}" />
            <Border x:Name="TrimBottomHandle" Height="6" Background="{StaticResource AccentBrush}" />
          </Canvas>
        </Grid>
      </Border>
    </Grid>

    <!-- 和普通截图共用同一组结果动作 -->
    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,12,0,0">
      <Button Content="复制图片" Click="OnCopyImageClick" />
      <Button Content="保存" Click="OnSaveClick" />
      <Button Content="固定" Click="OnPinClick" />
      <Button Classes="accent" Content="识别文字" Click="OnRecognizeClick" />
    </StackPanel>

  </Grid>
</Window>
