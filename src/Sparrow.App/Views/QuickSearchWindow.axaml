<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sparrow.App.ViewModels"
        xmlns:controls="using:Sparrow.App.Controls"
        x:Class="Sparrow.App.Views.QuickSearchWindow"
        x:DataType="vm:QuickSearchViewModel"
        Title="Sparrow"
        Width="800"
        MaxHeight="720"
        SizeToContent="Height"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

  <!-- 与命令面板保持同一套浮层视觉：渐变底 + 阴影 + 点阵底纹 -->
  <Border x:Name="Shell"
          Background="{DynamicResource SurfaceGradientBrush}"
          BorderBrush="{DynamicResource LineStrongBrush}"
          BorderThickness="1"
          CornerRadius="14"
          BoxShadow="0 24 64 0 #99000000"
          ClipToBounds="True">

    <Border.RenderTransform>
      <TranslateTransform Y="0">
        <TranslateTransform.Transitions>
          <Transitions>
            <DoubleTransition Property="Y" Duration="0:0:0.16" Easing="CubicEaseOut" />
          </Transitions>
        </TranslateTransform.Transitions>
      </TranslateTransform>
    </Border.RenderTransform>

    <Border.Transitions>
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
      </Transitions>
    </Border.Transitions>

    <Panel>
      <Border Background="{DynamicResource DotGridBrush}"
              IsHitTestVisible="False"
              Opacity="0.6" />

      <StackPanel>

        <!-- 搜索行：抬起的输入框，和结果区形成层次 -->
        <Border Margin="16,16,16,10"
                Padding="12,5"
                CornerRadius="10"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Path Grid.Column="0"
                  Classes="icon icon-sm"
                  Margin="0,0,10,0"
                  VerticalAlignment="Center"
                  Stroke="{DynamicResource TextMutedBrush}"
                  Data="{StaticResource IconSearch}" />

            <TextBox x:Name="SearchBox"
                     Grid.Column="1"
                     Classes="bare"
                     PlaceholderText="搜索本机文件…"
                     Text="{Binding Query, Mode=TwoWay}"
                     VerticalAlignment="Center" />

            <Border Grid.Column="2" Classes="kbd" Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Esc" />
            </Border>
          </Grid>
        </Border>

        <Border Height="1" Background="{DynamicResource LineBrush}" />

        <!-- 结果列表：名称 + 路径 + 大小 + 修改时间 -->
        <Panel MinHeight="200">
          <ListBox x:Name="ResultList"
                   Margin="8,4"
                   MaxHeight="500"
                   ItemsSource="{Binding Items}"
                   SelectedItem="{Binding Selected, Mode=TwoWay}"
                   Background="Transparent"
                   BorderThickness="0">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="CornerRadius" Value="8" />
              </Style>
            </ListBox.Styles>

            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FileSearchItemViewModel">
                <Grid ColumnDefinitions="3,Auto,*,72,104" Margin="4,6,10,6">
                  <!-- 选中时左侧的琥珀强调条 -->
                  <Border Grid.Column="0"
                          Width="2"
                          CornerRadius="1"
                          Margin="0,4"
                          Background="{DynamicResource AccentBrush}"
                          IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />

                  <Panel Grid.Column="1"
                         Width="24"
                         Height="24"
                         Margin="4,0,12,0"
                         VerticalAlignment="Top">
                    <Panel IsVisible="{Binding !HasIcon}">
                      <Path Data="{StaticResource IconFolder}"
                            IsVisible="{Binding IsDirectory}"
                            Classes="icon icon-md" />
                      <Path Data="{StaticResource IconFile}"
                            IsVisible="{Binding IsFile}"
                            Classes="icon icon-md" />
                    </Panel>

                    <Image Source="{Binding Icon}"
                           IsVisible="{Binding HasIcon}"
                           Width="24"
                           Height="24"
                           Stretch="Uniform" />
                  </Panel>

                  <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                    <controls:HighlightTextBlock SourceText="{Binding Name}"
                                                 Term="{Binding HighlightTerm}"
                                                 FontSize="13"
                                                 FontWeight="SemiBold"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DirectoryPath}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>

                  <TextBlock Grid.Column="3"
                             Text="{Binding SizeText}"
                             Width="72"
                             TextAlignment="Right"
                             FontSize="11"
                             Foreground="{DynamicResource TextMutedBrush}"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />

                  <TextBlock Grid.Column="4"
                             Text="{Binding ModifiedText}"
                             Width="104"
                             TextAlignment="Right"
                             FontSize="11"
                             Foreground="{DynamicResource TextMutedBrush}"
                             VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- 空状态：索引加载 / 没输入 / 没结果都在这里给一句话 -->
          <StackPanel IsVisible="{Binding IsEmpty}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="8"
                      Margin="0,24">
            <Path Classes="icon icon-xl"
                  HorizontalAlignment="Center"
                  Opacity="0.5"
                  Stroke="{DynamicResource TextMutedBrush}"
                  Data="{StaticResource IconSearch}" />
            <TextBlock Text="{Binding StatusText}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="360" />
          </StackPanel>
        </Panel>

        <!-- 状态 + 快捷键 -->
        <Grid ColumnDefinitions="*,Auto" Margin="16,8,16,12">
          <TextBlock Text="{Binding StatusText}"
                     IsVisible="{Binding !IsEmpty}"
                     FontSize="11"
                     Foreground="{DynamicResource TextMutedBrush}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />

          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="6">
            <Border Classes="kbd"><TextBlock Text="↑ ↓" /></Border>
            <TextBlock Text="选择" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />

            <Border Classes="kbd" Margin="6,0,0,0"><TextBlock Text="Enter" /></Border>
            <TextBlock Text="打开" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />

            <Border Classes="kbd" Margin="6,0,0,0"><TextBlock Text="Ctrl+Enter" /></Border>
            <TextBlock Text="定位" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />

            <Border Classes="kbd" Margin="6,0,0,0"><TextBlock Text="Ctrl+C" /></Border>
            <TextBlock Text="复制" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>

      </StackPanel>
    </Panel>
  </Border>
</Window>
