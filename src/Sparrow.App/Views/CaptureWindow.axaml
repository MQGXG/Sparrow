<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Sparrow.App.Views"
        x:Class="Sparrow.App.Views.CaptureWindow"
        Title="SparrowCapture"
        WindowDecorations="None"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        Background="Transparent">

  <Window.Resources>
    <!-- 紧凑滑块：默认 Fluent 是 20px 拇指 / 32px 高，塞进 40px 属性条里像大圆点 -->
    <x:Double x:Key="SliderHorizontalHeight">16</x:Double>
    <x:Double x:Key="SliderHorizontalThumbWidth">12</x:Double>
    <x:Double x:Key="SliderHorizontalThumbHeight">12</x:Double>
    <CornerRadius x:Key="SliderThumbCornerRadius">6</CornerRadius>
    <x:Double x:Key="SliderTrackThemeHeight">3</x:Double>
    <!-- 默认上下各留 15；属性条只有 20 高，收到 4 才能让轨道真正居中 -->
    <GridLength x:Key="SliderPreContentMargin">4</GridLength>
    <GridLength x:Key="SliderPostContentMargin">4</GridLength>

    <!-- 标注工具图标（24×24 线稿） -->
    <StreamGeometry x:Key="ToolRect">M4 6.5h16v11H4z</StreamGeometry>
    <StreamGeometry x:Key="ToolEllipse">M12 5.5c4.4 0 8 2.9 8 6.5s-3.6 6.5-8 6.5-8-2.9-8-6.5 3.6-6.5 8-6.5z</StreamGeometry>
    <StreamGeometry x:Key="ToolDiamond">M12 3.5 20.5 12 12 20.5 3.5 12z</StreamGeometry>
    <StreamGeometry x:Key="ToolArrow">M5 19 19 5 M11.5 5H19v7.5</StreamGeometry>
    <StreamGeometry x:Key="ToolLine">M5 19 19 5</StreamGeometry>
    <StreamGeometry x:Key="ToolDistance">M4 12h16 M4 8v8 M20 8v8</StreamGeometry>
    <StreamGeometry x:Key="ToolAngle">M4 20 10 5 M4 20h16 M11 20a7 7 0 0 0-1.8-4.7</StreamGeometry>
    <StreamGeometry x:Key="ToolBracket">M8 4H5v16h3</StreamGeometry>
    <StreamGeometry x:Key="ToolBubble">M6 4h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-7l-4 4v-4H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z</StreamGeometry>
    <StreamGeometry x:Key="ToolEraser">M6 17.5 12.5 11 18.5 17 12 23.5z M6 17.5h12.5 M12.5 11 15 8.5a1.6 1.6 0 0 1 2.3 0l1.2 1.2a1.6 1.6 0 0 1 0 2.3L18.5 17</StreamGeometry>
    <StreamGeometry x:Key="ToolSpotlight">M12 8a4 4 0 1 0 .01 0 M12 1v2 M12 21v2 M1 12h2 M21 12h2 M4.2 4.2l1.4 1.4 M18.4 18.4l1.4 1.4 M19.8 4.2l-1.4 1.4 M5.6 18.4l-1.4 1.4</StreamGeometry>
    <StreamGeometry x:Key="ToolMagnifier">M11 4a7 7 0 1 0 .01 0 M16 16l4.5 4.5</StreamGeometry>
    <StreamGeometry x:Key="IconEye">M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z M12 9.2a2.8 2.8 0 1 0 .01 0</StreamGeometry>
    <StreamGeometry x:Key="ToolPen">M4 20l4.5-1L19 8.5 15.5 5 5 15.5z M13 7.5l3.5 3.5</StreamGeometry>
    <StreamGeometry x:Key="ToolHighlighter">M4 20h6 M14.5 4.5l5 5-8.5 8.5-4-4z</StreamGeometry>
    <StreamGeometry x:Key="IconTextWave">M3.5 12.5c1.6-3 3.2-3 4.8 0s3.2 3 4.8 0 3.2-3 4.8 0</StreamGeometry>
    <StreamGeometry x:Key="IconTextUnderline">M7 4.5v6a5 5 0 0 0 10 0v-6 M5.5 19.5h13</StreamGeometry>
    <StreamGeometry x:Key="IconTextStrike">M4.5 12h15 M8.3 8.2c0-1.6 1.6-2.7 3.7-2.7s3.7 1.1 3.7 2.7 M8.3 15.8c0 1.6 1.6 2.7 3.7 2.7s3.7-1.1 3.7-2.7</StreamGeometry>
    <StreamGeometry x:Key="ToolMosaic">M4 4h16v16H4z M4 9.3h16 M4 14.7h16 M9.3 4v16 M14.7 4v16</StreamGeometry>
    <StreamGeometry x:Key="ToolText">M6 6h12 M12 6v13 M9.5 19h5</StreamGeometry>
    <StreamGeometry x:Key="ToolNumber">M12 4a8 8 0 1 0 0 16 8 8 0 0 0 0-16z M10 10l1.5-1.2V16</StreamGeometry>
    <StreamGeometry x:Key="ToolWatermark">M4 5h16v14H4z M9.5 16 12 8.8 14.5 16 M10.3 13.4h3.4</StreamGeometry>
    <!-- 选择/退出标注：指针箭头 -->
    <StreamGeometry x:Key="ToolCursor">M6.5 4.5 11.9 18.2 13.6 12.9 18.9 11.2z</StreamGeometry>

    <!-- 动作图标（24×24 线稿，与工具图标同一套笔画语言） -->
    <StreamGeometry x:Key="IconScan">M4 8.5V6A2 2 0 0 1 6 4h2.5 M15.5 4H18a2 2 0 0 1 2 2v2.5 M20 15.5V18a2 2 0 0 1-2 2h-2.5 M8.5 20H6a2 2 0 0 1-2-2v-2.5 M8 9.5h8 M8 12.5h5.5</StreamGeometry>
    <StreamGeometry x:Key="IconTranslate">M4.5 7h8 M8.5 5v2 M11 7c-.5 3.2-2.7 5.8-5.6 6.9 M6 8.3c.7 2.2 2.5 4 4.8 4.8 M12.8 19.5l3.5-9.3 3.5 9.3 M14.2 16.4h4.4</StreamGeometry>
    <StreamGeometry x:Key="IconSave">M12 4v10.3 M7.9 10.6 12 14.7l4.1-4.1 M5 19.5h14</StreamGeometry>
    <StreamGeometry x:Key="IconScrollCapture">M6.5 4h11v16h-11z M12 7.5v8.6 M9.3 13.4 12 16.1l2.7-2.7</StreamGeometry>
    <StreamGeometry x:Key="IconOcrFrame">M4 8.5V6.3A2.3 2.3 0 0 1 6.3 4H8.5 M15.5 4h2.2A2.3 2.3 0 0 1 20 6.3v2.2 M20 15.5v2.2a2.3 2.3 0 0 1-2.3 2.3h-2.2 M8.5 20H6.3A2.3 2.3 0 0 1 4 17.7v-2.2</StreamGeometry>
    <StreamGeometry x:Key="IconMosaicBlur">M4.5 8.5c1.9-1.7 3.9-1.7 5.8 0s3.9 1.7 5.8 0 M4.5 12.5c1.9-1.7 3.9-1.7 5.8 0s3.9 1.7 5.8 0 M4.5 16.5c1.9-1.7 3.9-1.7 5.8 0s3.9 1.7 5.8 0</StreamGeometry>
    <StreamGeometry x:Key="IconCornerRadius">M5 20V10.5A5.5 5.5 0 0 1 10.5 5H20</StreamGeometry>
    <StreamGeometry x:Key="IconRedo">M16 5.5 20 9.5l-4 4 M19.5 9.5H10a5.5 5.5 0 0 0 0 11h3</StreamGeometry>
    <StreamGeometry x:Key="IconLockClosed">M7.5 10V7.6a4.5 4.5 0 0 1 9 0V10 M5.8 10h12.4v8.6H5.8z</StreamGeometry>
    <StreamGeometry x:Key="IconLockOpen">M7.5 10V7.6a4.5 4.5 0 0 1 8.6-2.9 M5.8 10h12.4v8.6H5.8z</StreamGeometry>
  </Window.Resources>

  <Window.Styles>
    <!--
      tooltip 延迟拉长：默认 400ms 太短，点按钮 / 展开弹层时 tooltip 会弹出来挡住点击。
      展开工具组时还会额外把触发按钮的 tooltip 临时摘掉（见 ShowToolGroupPopover）。
    -->
    <Style Selector="Button">
      <Setter Property="ToolTip.ShowDelay" Value="1400" />
    </Style>
    <Style Selector="ToggleButton">
      <Setter Property="ToolTip.ShowDelay" Value="1400" />
    </Style>

    <!-- 标注工具按钮：选中时琥珀描边 + 淡琥珀底 -->
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.tool.selected">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <!-- 选中态实心：Fluent 的 pointerover 会把背景刷回浅灰，这里压住 -->
    <Style Selector="Button.tool.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
    </Style>

    <!-- 键盘焦点：白色描边，和琥珀选中态区分 -->
    <Style Selector="Button.tool:focus-visible">
      <Setter Property="BorderBrush" Value="#FFFFFFFF" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="Button.swatch:focus-visible">
      <Setter Property="BorderBrush" Value="#FFFFFFFF" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.prop:focus-visible">
      <Setter Property="BorderBrush" Value="#FFFFFFFF" />
    </Style>

    <!-- 颜色色块：小圆点，选中加琥珀描边 -->
    <Style Selector="Button.swatch">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#66000000" />
    </Style>
    <Style Selector="Button.swatch.selected">
      <Setter Property="BorderBrush" Value="#FFFFFFFF" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- 工具栏按钮：32×32 图标按钮，参考 snow-shot 的 kButtonSize -->
    <Style Selector="Button.tool">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- 不可用的动作（比如没有可重做的）不抢注意力：只淡出，不再画底色 -->
    <Style Selector="Button.tool:disabled">
      <Setter Property="Opacity" Value="0.3" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- 选区工具条的输入框：无边框，悬停/获焦时才亮底，看起来像可编辑的读数 -->
    <Style Selector="TextBox.sel-input">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="20" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Foreground" Value="#F2F6FC" />
      <Setter Property="CaretBrush" Value="#F2F6FC" />
    </Style>
    <Style Selector="TextBox.sel-input:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
    <Style Selector="TextBox.sel-input:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>

    <!-- 单位切换：px ↔ DIP -->
    <Style Selector="Button.sel-unit">
      <Setter Property="Height" Value="20" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="3,0" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#B8C2CE" />
    </Style>
    <Style Selector="Button.sel-unit:pointerover">
      <Setter Property="Background" Value="#33FFFFFF" />
      <Setter Property="Foreground" Value="#F2F6FC" />
    </Style>

    <!-- 锁定宽高比 -->
    <Style Selector="ToggleButton.sel-lock">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <!-- Fluent 的 ToggleButton 勾选时会把内容层刷成实心强调色，这里改回半透明白 -->
    <Style Selector="ToggleButton.sel-lock /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.sel-lock:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
    <Style Selector="ToggleButton.sel-lock:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#33FFFFFF" />
      <Setter Property="BorderBrush" Value="#66FFFFFF" />
    </Style>
    <Style Selector="ToggleButton.sel-lock:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#40FFFFFF" />
      <Setter Property="BorderBrush" Value="#66FFFFFF" />
    </Style>
    <Style Selector="ToggleButton.sel-lock Path">
      <Setter Property="Stroke" Value="#B8C2CE" />
      <Setter Property="StrokeThickness" Value="1.5" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
    </Style>
    <Style Selector="ToggleButton.sel-lock:checked Path">
      <Setter Property="Stroke" Value="#FFFFFF" />
    </Style>

    <!-- 选区工具条的其余零件 -->
    <Style Selector="TextBlock.sel-comma">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#B8C2CE" />
    </Style>
    <Style Selector="TextBlock.sel-label">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Margin" Value="4,0,2,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#B8C2CE" />
    </Style>
    <Style Selector="Button.sel-ratio">
      <Setter Property="Height" Value="20" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#F2F6FC" />
    </Style>
    <Style Selector="Button.sel-ratio:pointerover">
      <Setter Property="Background" Value="#33FFFFFF" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Border.sel-sep">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="Background" Value="#40FFFFFF" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool.small">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
    </Style>
    <!--
      图标 20：参考实现是 24/32（75%），Sparrow 原来 18/32（56%），视觉上偏空。
      线宽基准 1.2 = 1.5 × 16/20：几何自然宽度 16 栅格缩到 20px 时正好 1.5px。
      其余图标在各自 Path 上写了 StrokeThickness = 1.5 × 自然宽度 / 20，
      渲染出来的线宽仍然统一是 1.5px。改了几何要重新量自然宽度并同步这个值。
    -->
    <Style Selector="Button.tool Path">
      <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="StrokeThickness" Value="1.2" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
    </Style>
    <Style Selector="Button.tool.selected Path">
      <Setter Property="Stroke" Value="{DynamicResource AccentOnBrush}" />
    </Style>

    <!-- 线宽按钮：三个大小不一的实心圆点，比数字更直观 -->
    <Style Selector="Button.tool Ellipse">
      <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.tool.selected Ellipse">
      <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- 主操作（识别）：整条工具条上唯一的琥珀实心按钮 -->
    <Style Selector="Button.tool.primary">
      <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.tool.primary Path">
      <Setter Property="Stroke" Value="{DynamicResource AccentOnBrush}" />
      <!-- 线宽不再单独加粗：统一走基准 1.33 + 各图标补偿，缩放后都是 1.5px -->
    </Style>
    <Style Selector="Button.tool.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentGradientHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
    </Style>

    <!-- 分组按钮右下角的小三角：提示这个按钮还带着选项 -->
    <Style Selector="Button.tool Path.group-caret">
      <Setter Property="Stretch" Value="None" />
      <Setter Property="Width" Value="5" />
      <Setter Property="Height" Value="4" />
      <Setter Property="Stroke" Value="Transparent" />
      <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Margin" Value="0,0,2,2" />
    </Style>
    <Style Selector="Button.tool.selected Path.group-caret">
      <Setter Property="Fill" Value="{DynamicResource AccentOnBrush}" />
    </Style>

    <!-- 工具组悬停弹出：水平选项条（参考 snow-shot 的 option popover） -->
    <Style Selector="Border.tool-popover">
      <Setter Property="Background" Value="{DynamicResource OverlayBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="BoxShadow" Value="0 8 20 0 #99000000" />
    </Style>
    <Style Selector="Border.tool-separator">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="Background" Value="{DynamicResource LineStrongBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 浮层卡片：主工具条和属性栏各一张，参考 LumaShot 的两段式布局 -->
    <Style Selector="Border.capture-bar">
      <Setter Property="Background" Value="{DynamicResource OverlayBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="BoxShadow" Value="0 8 24 0 #99000000" />
    </Style>

    <!-- 属性条的组间分隔线：跟着组一起隐藏 -->
    <Style Selector="Border.prop-sep">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Background" Value="{DynamicResource LineStrongBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 属性栏：左边说明文字 + 右边控件 -->
    <Style Selector="TextBlock.prop-label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.prop-value">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="MinWidth" Value="42" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.prop">
      <Setter Property="Height" Value="26" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.prop.selected">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- 分段按钮：并排的枚举选项，选中态用实心强调色（参考的 style bar 做法） -->
    <Style Selector="Button.prop.seg">
      <Setter Property="MinWidth" Value="26" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Button.prop.seg.selected">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentOnBrush}" />
    </Style>
    <!-- 用图标的分段按钮（形状切换）：图标 14，线宽 1.4，选中跟随强调色 -->
    <Style Selector="Button.prop.seg Path">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="StrokeThickness" Value="1.4" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="Button.prop.seg.selected Path">
      <Setter Property="Stroke" Value="{DynamicResource AccentOnBrush}" />
    </Style>
    <!-- 带色块预览的分段按钮：选中时用琥珀描边，不能铺实心底，否则预览被盖住 -->
    <Style Selector="Button.prop.seg.swatch-seg.selected">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <!-- 线型预览：实线 / 三段虚线 / 三点 -->
    <Style Selector="Border.seg-line">
      <Setter Property="Background" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.prop.seg.selected Border.seg-line">
      <Setter Property="Background" Value="{DynamicResource AccentOnBrush}" />
    </Style>
    <!-- 填充预览：空心 / 半透明 / 实心 -->
    <Style Selector="Border.seg-swatch">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.seg-swatch.soft">
      <Setter Property="Background" Value="#66E5A44C" />
    </Style>
    <Style Selector="Border.seg-swatch.solid">
      <Setter Property="Background" Value="#E5A44C" />
    </Style>
    <Style Selector="Slider.prop">
      <Setter Property="Width" Value="88" />
      <Setter Property="Height" Value="20" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
    <Style Selector="Slider.prop /template/ Thumb">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="#CCFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Slider.prop /template/ Thumb:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    </Style>
  </Window.Styles>

  <Canvas x:Name="Root" Background="Transparent">

    <!-- 冻结帧：按热键时抓的整屏图；没有时退回实时桌面 -->
    <Image x:Name="FrozenFrame"
           IsVisible="False"
           IsHitTestVisible="False"
           Stretch="Fill" />
    <!-- 遮罩：只压暗选区之外（Exclude 挖洞），选区保持原图亮度 -->
    <Path x:Name="DimLayer" Fill="#80000000" IsHitTestVisible="False" />

    <!-- 十字辅助线：还没框选时跟随光标，帮助对齐 -->
    <Canvas x:Name="CrosshairLayer" IsVisible="False" IsHitTestVisible="False">
      <Line x:Name="CrosshairV" Stroke="#73E5A44C" StrokeThickness="1" />
      <Line x:Name="CrosshairH" Stroke="#73E5A44C" StrokeThickness="1" />
    </Canvas>

    <!-- 悬停候选：鼠标停在哪个窗口就虚线框住哪个 -->
    <Rectangle x:Name="CandidateBox"
               IsVisible="False"
               IsHitTestVisible="False"
               Fill="Transparent"
               Stroke="#E5A44C"
               StrokeThickness="1.5"
               StrokeDashArray="4,3" />
    <Border x:Name="CandidateBadge"
            IsVisible="False"
            IsHitTestVisible="False"
            Background="{StaticResource OverlayBrush}"
            BorderBrush="{StaticResource LineStrongBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="6,3">
      <TextBlock x:Name="CandidateText"
                 FontSize="11"
                 Foreground="{StaticResource TextPrimaryBrush}" />
    </Border>

    <!-- 选区只画边框：填充透明，中间保持原图，不盖一层颜色 -->
    <Rectangle x:Name="SelectionHalo"
               IsVisible="False"
               IsHitTestVisible="False"
               Fill="Transparent"
               Stroke="#66000000"
               StrokeThickness="1" />
    <Rectangle x:Name="Selection"
               IsVisible="False"
               Fill="Transparent"
               Stroke="{StaticResource AccentBrush}"
               StrokeThickness="2" />

    <!-- 文字工具的就地输入：不显示输入框，只留闪烁的光标，和画布上的文字一样 -->
    <TextBox x:Name="TextNoteBox"
             IsVisible="False"
             MinWidth="2"
             MaxWidth="420"
             FontSize="16"
             Foreground="#E5A44C"
             Background="Transparent"
             BorderThickness="0"
             Padding="0"
             KeyDown="OnTextNoteKeyDown"
             LostFocus="OnTextNoteLostFocus" />

    <!-- 标注预览：只画在选区内，坐标相对选区左上角 -->
    <Canvas x:Name="NoteLayer"
            IsVisible="False"
            IsHitTestVisible="False"
            ClipToBounds="True" />

    <!-- 选中标注的缩放控制点：只在指针工具下显示，点击命中在代码里做 -->
    <Canvas x:Name="NoteHandleLayer"
            IsVisible="False"
            IsHitTestVisible="False"
            ClipToBounds="True" />

    <!-- 吸附参考线：拖动/拉伸时贴在屏幕边或中线 -->
    <Canvas x:Name="GuideLayer"
            IsVisible="False"
            IsHitTestVisible="False" />

    <!-- 8 个控制点：只负责显示，命中判定在窗口里做 -->
    <Canvas x:Name="HandleLayer"
            IsVisible="False"
            IsHitTestVisible="False" />

    <!-- 放大镜：拖动/拉伸时显示光标周围的像素，方便对齐 -->
    <Border x:Name="Magnifier"
            IsVisible="False"
            IsHitTestVisible="False"
            Width="132"
            Height="132"
            CornerRadius="66"
            ClipToBounds="True"
            Background="#E60E1114"
            BorderBrush="#66FFFFFF"
            BorderThickness="1"
            BoxShadow="0 10 24 0 #99000000">
      <Panel ClipToBounds="True">
        <Canvas ClipToBounds="True">
          <Image x:Name="MagnifierImage"
                 Stretch="Fill"
                 RenderOptions.BitmapInterpolationMode="None"
                 RenderTransformOrigin="0,0">
            <Image.RenderTransform>
              <ScaleTransform />
            </Image.RenderTransform>
          </Image>
        </Canvas>
        <Rectangle Width="1"
                   HorizontalAlignment="Center"
                   Fill="#B3E5A44C" />
        <Rectangle Height="1"
                   VerticalAlignment="Center"
                   Fill="#B3E5A44C" />
        <Ellipse Width="7"
                 Height="7"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Stroke="#FFFFFFFF"
                 StrokeThickness="1" />
      </Panel>
    </Border>

    <!-- 取色器：方形像素预览 + 坐标 + 色值，跟随光标（参考 snow-shot 的取色窗口） -->
    <Border x:Name="ColorProbe"
            IsVisible="False"
            IsHitTestVisible="False"
            Background="{StaticResource OverlayBrush}"
            BorderBrush="{StaticResource LineStrongBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8"
            BoxShadow="0 10 24 0 #99000000">
      <StackPanel Spacing="6">
        <Border Width="108"
                Height="108"
                CornerRadius="4"
                ClipToBounds="True"
                Background="#FF101214">
          <Panel ClipToBounds="True">
            <Canvas ClipToBounds="True">
              <Image x:Name="ProbePreviewImage"
                     Stretch="Fill"
                     RenderOptions.BitmapInterpolationMode="None"
                     RenderTransformOrigin="0,0">
                <Image.RenderTransform>
                  <ScaleTransform />
                </Image.RenderTransform>
              </Image>
            </Canvas>
            <!-- 中心像素框：对准当前采样点 -->
            <Border Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="#FFFFFFFF"
                    BorderThickness="1"
                    CornerRadius="2" />
          </Panel>
        </Border>
        <TextBlock x:Name="ProbePosition"
                   FontSize="10"
                   HorizontalAlignment="Center"
                   Foreground="{StaticResource TextMutedBrush}"
                   Text="0, 0" />
        <TextBlock x:Name="ProbeValue"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   FontFamily="{DynamicResource MonoFont}"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Text="#000000" />
        <!-- 当前颜色条：放在色值下方，撑满卡片宽度，避免和像素预览混淆 -->
        <Border x:Name="ProbeSwatch"
                Height="10"
                CornerRadius="2"
                Background="#FF000000" />
        <TextBlock FontSize="9"
                   HorizontalAlignment="Center"
                   Foreground="{StaticResource TextMutedBrush}"
                   Text="按 I 复制 · Shift+I 格式" />
      </StackPanel>
    </Border>

    <!--
      选区工具条：26 高、半透明黑底 + 白字，贴在选区左上角上方。
      字段：X / Y / 单位 / 比例锁 / 宽 × 高 / 比例预设 | 圆角。
      参考 snow-shot 的独立选区浮条（它没有 X/Y 的标签，靠顺序和 × 区分，这里照做）。
    -->
    <Border x:Name="SizeBadge"
            IsVisible="False"
            IsHitTestVisible="True"
            ToolTip.Tip="可直接输入 X/Y/宽/高/导出圆角；点单位切换物理像素 / DIP；锁图标锁定比例"
            Background="#73000000"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="6"
            Padding="6,2">
      <StackPanel Orientation="Horizontal" Spacing="0">
        <TextBox x:Name="PosXBox"
                 Classes="sel-input"
                 Width="34"
                 KeyDown="OnSizeBoxKeyDown"
                 LostFocus="OnSizeBoxLostFocus" />
        <TextBlock Classes="sel-comma" Text="," />
        <TextBox x:Name="PosYBox"
                 Classes="sel-input"
                 Width="34"
                 KeyDown="OnSizeBoxKeyDown"
                 LostFocus="OnSizeBoxLostFocus" />
        <Button x:Name="SizeUnitButton"
                Classes="sel-unit"
                Content="px"
                Click="OnSizeUnitClick"
                ToolTip.Tip="切换物理像素 / DIP" />
        <ToggleButton x:Name="SizeLockButton"
                      Classes="sel-lock"
                      IsChecked="False"
                      Click="OnSizeLockClick"
                      ToolTip.Tip="锁定宽高比">
          <Panel>
            <Path x:Name="LockOpenIcon" Data="{StaticResource IconLockOpen}" />
            <Path x:Name="LockClosedIcon" Data="{StaticResource IconLockClosed}" IsVisible="False" />
          </Panel>
        </ToggleButton>
        <TextBox x:Name="WidthBox"
                 Classes="sel-input"
                 KeyDown="OnSizeBoxKeyDown"
                 LostFocus="OnSizeBoxLostFocus" />
        <TextBlock Classes="sel-comma" Text="×" />
        <TextBox x:Name="HeightBox"
                 Classes="sel-input"
                 KeyDown="OnSizeBoxKeyDown"
                 LostFocus="OnSizeBoxLostFocus" />
        <Button x:Name="RatioButton"
                Classes="sel-ratio"
                Content="自由"
                ToolTip.Tip="宽高比预设">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedLeft">
              <MenuItem Header="自由" Click="OnRatioFreeMenu" />
              <MenuItem Header="1:1" Click="OnRatio1x1Menu" />
              <MenuItem Header="3:2" Click="OnRatio3x2Menu" />
              <MenuItem Header="4:3" Click="OnRatio4x3Menu" />
              <MenuItem Header="16:9" Click="OnRatio16x9Menu" />
              <MenuItem Header="2:3" Click="OnRatio2x3Menu" />
              <MenuItem Header="3:4" Click="OnRatio3x4Menu" />
              <MenuItem Header="9:16" Click="OnRatio9x16Menu" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <Border Classes="sel-sep" />
        <TextBlock Classes="sel-label" Text="导出" />
        <TextBox x:Name="RadiusBox"
                 Classes="sel-input"
                 Width="30"
                 KeyDown="OnSizeBoxKeyDown"
                 LostFocus="OnSizeBoxLostFocus" />
        <TextBlock Classes="sel-label" Text="px" />
      </StackPanel>
    </Border>

    <!-- 就地 OCR：行框叠在选区上，点一行复制一行 -->
    <Canvas x:Name="OcrLayer"
            IsVisible="False"
            Background="Transparent"
            ClipToBounds="True" />

    <!-- 译文叠层：盖在选区上显示译文图；点"显示原图"切回 -->
    <Image x:Name="TransLayer"
           IsVisible="False"
           IsHitTestVisible="False"
           Stretch="Fill" />

    <!-- 识别 / 翻译结果：文字留在图上（行框可点选复制），长文本去工作区看 -->
    <Border x:Name="HintBar"
            Canvas.Left="0"
            Canvas.Top="24"
            Background="{StaticResource OverlayBrush}"
            BorderBrush="{StaticResource LineStrongBrush}"
            BorderThickness="1"
            CornerRadius="999"
            Padding="14,6">
      <StackPanel Orientation="Horizontal">
        <TextBlock FontSize="11.5"
                   Text="拖拽框选"
                   Foreground="{StaticResource TextPrimaryBrush}" />
        <TextBlock FontSize="11.5"
                   Text=" · 单击选中 · 滚轮切层 · Tab 整窗/元素 · I 取色 · Esc 取消"
                   Foreground="{StaticResource TextSecondaryBrush}" />
      </StackPanel>
    </Border>

    <!-- 角度第二步提示：只在草稿已有一条边时出现 -->
    <Border x:Name="AngleHint"
            Canvas.Left="0"
            Canvas.Top="24"
            IsVisible="False"
            IsHitTestVisible="False"
            Background="{StaticResource OverlayBrush}"
            BorderBrush="{StaticResource LineStrongBrush}"
            BorderThickness="1"
            CornerRadius="999"
            Padding="14,6">
      <TextBlock FontSize="11.5"
                 Text="已定一条边 · 再拖一条边定角度 · Esc 取消"
                 Foreground="{StaticResource TextPrimaryBrush}" />
    </Border>

    <!-- 两段式浮层：主工具条一行，属性栏按当前工具出现（参考 LumaShot） -->
    <StackPanel x:Name="ActionBar" IsVisible="False" Cursor="Arrow" Spacing="8">

      <Border x:Name="MainBar" Classes="capture-bar" HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Border x:Name="ToolbarDragHandle"
                  Width="12"
                  Height="28"
                  Margin="0,2,2,2"
                  Background="Transparent"
                  Cursor="SizeAll"
                  ToolTip.Tip="拖动工具条"
                  PointerPressed="OnToolbarDragPressed">
            <Path Data="M5 7a1 1 0 1 0 .01 0 M5 12a1 1 0 1 0 .01 0 M5 17a1 1 0 1 0 .01 0 M10 7a1 1 0 1 0 .01 0 M10 12a1 1 0 1 0 .01 0 M10 17a1 1 0 1 0 .01 0"
                  Fill="{DynamicResource TextMutedBrush}"
                  Stretch="Uniform"
                  Width="12"
                  Height="18" />
          </Border>

          <StackPanel x:Name="ToolButtons" Orientation="Horizontal" Spacing="8">
          <!--
            工具组折叠：一个 position 内多个工具折叠成一个按钮，
            悬停弹出水平选项条（参考 snow-shot 的 positions）。
            入口 = 组内最后一个工具；点折叠按钮直接激活入口。
            组内原有按钮保留在树里（IsVisible=False），键盘和测试仍按工具 ID 走。
          -->
          <Button x:Name="ShapeGroupButton" Classes="tool group-trigger"
                  ToolTip.Tip="形状：矩形 / 椭圆 / 括号">
            <Panel>
              <Path x:Name="ShapeGroupIcon" Data="{StaticResource ToolRect}" />
              <Path Classes="group-caret" Data="M 0 0 L 5 0 L 2.5 3.5 Z" />
            </Panel>
          </Button>
          <Button x:Name="RectToolButton" Classes="tool" IsVisible="False"
                  ToolTip.Tip="矩形（2）" Click="OnRectToolClick">
            <Path Data="{StaticResource ToolRect}" />
          </Button>
          <Button x:Name="EllipseToolButton" Classes="tool" IsVisible="False"
                  ToolTip.Tip="椭圆（3）" Click="OnEllipseToolClick">
            <Path Data="{StaticResource ToolEllipse}" />
          </Button>
          <Button x:Name="DiamondToolButton" Classes="tool" IsVisible="False"
                  ToolTip.Tip="菱形" Click="OnDiamondToolClick">
            <Path Data="{StaticResource ToolDiamond}" />
          </Button>
          <Button x:Name="BracketToolButton" Classes="tool" IsVisible="False"
                  ToolTip.Tip="括号（[）" Click="OnBracketToolClick">
            <Path Data="{StaticResource ToolBracket}" />
          </Button>

          <Button x:Name="ArrowGroupButton" Classes="tool group-trigger"
                  ToolTip.Tip="箭头 / 直线 / 测距 / 角度">
            <Panel>
              <Path x:Name="ArrowGroupIcon" Data="{StaticResource ToolArrow}" StrokeThickness="1.053" />
              <Path Classes="group-caret" Data="M 0 0 L 5 0 L 2.5 3.5 Z" />
            </Panel>
          </Button>
          <Button x:Name="ArrowToolButton" Classes="tool" IsVisible="False"
                  ToolTip.Tip="箭头（4）" Click="OnArrowToolClick">
            <Path Data="{StaticResource ToolArrow}" StrokeThickness="1.053" />
          </Button>
          <Button x:Name="LineToolButton" Classes="tool" IsVisible="False"
                  ToolTip.Tip="直线（L）" Click="OnLineToolClick">
            <Path Data="{StaticResource ToolLine}" StrokeThickness="1.05" />
          </Button>
          <Button x:Name="DistanceToolButton" Classes="tool" IsVisible="False"
                  ToolTip.Tip="测距（D）" Click="OnDistanceToolClick">
            <Path Data="{StaticResource ToolDistance}" />
          </Button>
          <Button x:Name="AngleToolButton" Classes="tool" IsVisible="False"
                  ToolTip.Tip="角度（Shift+G）" Click="OnAngleToolClick">
            <Path Data="{StaticResource ToolAngle}" />
          </Button>

          <Button x:Name="PenGroupButton" Classes="tool group-trigger"
                  ToolTip.Tip="画笔 / 高亮">
            <Panel>
              <Path x:Name="PenGroupIcon" Data="{StaticResource ToolPen}" StrokeThickness="1.125" />
              <Path Classes="group-caret" Data="M 0 0 L 5 0 L 2.5 3.5 Z" />
            </Panel>
          </Button>
          <Button x:Name="PenToolButton" Classes="tool" IsVisible="False"
                  ToolTip.Tip="画笔（5）" Click="OnPenToolClick">
            <Path Data="{StaticResource ToolPen}" StrokeThickness="1.125" />
          </Button>
          <Button x:Name="HighlighterToolButton" Classes="tool" IsVisible="False"
                  ToolTip.Tip="高亮（6）" Click="OnHighlighterToolClick">
            <Path Data="{StaticResource ToolHighlighter}" StrokeThickness="1.161" />
          </Button>

          <Button x:Name="MosaicToolButton" Classes="tool"
                  ToolTip.Tip="马赛克（7）" Click="OnMosaicToolClick">
            <Path Data="{StaticResource ToolMosaic}" />
          </Button>
          <Button x:Name="EraserToolButton" Classes="tool"
                  ToolTip.Tip="橡皮擦（E）" Click="OnEraserToolClick">
            <Path Data="{StaticResource ToolEraser}" StrokeThickness="1.125" />
          </Button>
          <Button x:Name="SpotlightToolButton" Classes="tool"
                  ToolTip.Tip="聚光灯（K）" Click="OnSpotlightToolClick">
            <Path Data="{StaticResource ToolSpotlight}" StrokeThickness="1.65" />
          </Button>
          <Button x:Name="MagnifierToolButton" Classes="tool"
                  ToolTip.Tip="放大镜（Z）" Click="OnMagnifierToolClick">
            <Path Data="{StaticResource ToolMagnifier}" StrokeThickness="1.55" />
          </Button>

          <Button x:Name="TextGroupButton" Classes="tool group-trigger"
                  ToolTip.Tip="文字 / 序号 / 水印 / 气泡">
            <Panel>
              <Path x:Name="TextGroupIcon" Data="{StaticResource ToolText}" StrokeThickness="0.972" />
              <Path Classes="group-caret" Data="M 0 0 L 5 0 L 2.5 3.5 Z" />
            </Panel>
          </Button>
          <Button x:Name="TextToolButton" Classes="tool" IsVisible="False"
                  ToolTip.Tip="文字（8）" Click="OnTextToolClick">
            <Path Data="{StaticResource ToolText}" StrokeThickness="0.972" />
          </Button>
          <Button x:Name="NumberToolButton" Classes="tool" IsVisible="False"
                  ToolTip.Tip="序号（9）" Click="OnNumberToolClick">
            <Path Data="{StaticResource ToolNumber}" />
          </Button>
          <Button x:Name="WatermarkToolButton" Classes="tool" IsVisible="False"
                  ToolTip.Tip="水印（W）" Click="OnWatermarkToolClick">
            <Path Data="{StaticResource ToolWatermark}" />
          </Button>
          <Button x:Name="BubbleToolButton" Classes="tool" IsVisible="False"
                  ToolTip.Tip="对话气泡（Q）" Click="OnBubbleToolClick">
            <Path Data="{StaticResource ToolBubble}" />
          </Button>
          </StackPanel>

          <Border Classes="tool-separator" />

          <!-- 指针：退出标注，回到移动/拉伸选区 -->
          <Button x:Name="SelectToolButton" Classes="tool"
                  ToolTip.Tip="选择 / 移动选区（1）" Click="OnSelectToolClick">
            <Path Data="{StaticResource ToolCursor}" StrokeThickness="1.026" />
          </Button>
          <Button x:Name="UndoButton" Classes="tool"
                  ToolTip.Tip="撤销（Ctrl+Z）" Click="OnUndoClick">
            <Path Data="{StaticResource IconUndo}" StrokeThickness="1.161" />
          </Button>
          <Button x:Name="RedoButton" Classes="tool"
                  ToolTip.Tip="重做（Ctrl+Shift+Z）" Click="OnRedoClick">
            <Path Data="{StaticResource IconRedo}" StrokeThickness="1.161" />
          </Button>

          <Border Classes="tool-separator" />

          <Button x:Name="RecognizeButton"
                  Classes="tool"
                  Click="OnRecognizeClick"
                  ToolTip.Tip="识别选区文字（Enter / R）">
            <Path Data="{StaticResource IconScan}" />
          </Button>
          <!-- 翻译是一级动作：点一次就识别并出译文，不需要先点识别 -->
          <Button x:Name="TranslateActionButton"
                  Classes="tool"
                  IsVisible="False"
                  Click="OnTranslateClick"
                  ToolTip.Tip="识别并翻译（直接出译文）">
            <Path Data="{StaticResource IconTranslate}" StrokeThickness="1.143" />
          </Button>
          <!-- 更多识别：文本 / 表格 HTML / 表格 Markdown -->
          <Button x:Name="MoreRecognitionButton"
                  Classes="tool"
                  Click="OnMoreRecognitionClick"
                  ToolTip.Tip="更多识别：文本 / 表格">
            <Path Data="{StaticResource IconTable}" StrokeThickness="1.1" />
          </Button>
          <!-- 转换：直接放到主条，和 snow-shot 一样常用动作不藏进弹层 -->
          <Button x:Name="ConvertMarkdownButton"
                  Classes="tool"
                  Click="OnConvertMarkdownClick"
                  ToolTip.Tip="转换为 Markdown（表格）">
            <Path Data="{StaticResource IconMarkdown}" StrokeThickness="1.1" />
          </Button>
          <Button x:Name="ConvertHtmlButton"
                  Classes="tool"
                  Click="OnConvertHtmlClick"
                  ToolTip.Tip="转换为 HTML（表格）">
            <Path Data="{StaticResource IconHtml}" StrokeThickness="1.1" />
          </Button>
          <Button x:Name="SaveButton"
                  Classes="tool" Click="OnSaveClick" ToolTip.Tip="保存为 PNG（S）">
            <Path Data="{StaticResource IconSave}" StrokeThickness="1.161" />
          </Button>
          <Button x:Name="PinButton"
                  Classes="tool" Click="OnPinClick" ToolTip.Tip="固定到屏幕，滚轮缩放（P）">
            <Path Data="{StaticResource IconPin}" StrokeThickness="1.386" />
          </Button>
          <Button x:Name="ScrollButton"
                  Classes="tool" Click="OnScrollClick" ToolTip.Tip="滚动截图（G）">
            <Path Data="{StaticResource IconScrollCapture}" />
          </Button>
          <Button x:Name="CornerRadiusButton" Classes="tool"
                  Click="OnCornerRadiusClick" ToolTip.Tip="导出时四角切圆角">
            <Path Data="{StaticResource IconCornerRadius}" StrokeThickness="1.125" />
          </Button>
          <Button x:Name="MoreButton"
                  Classes="tool"
                  IsVisible="False"
                  ToolTip.Tip="更多动作">
            <Path Data="{StaticResource IconMore}" StrokeThickness="0.873" />
            <Button.Flyout>
              <MenuFlyout Placement="TopEdgeAlignedRight">
                <MenuItem Header="保存（S）" Click="OnSaveClick" />
                <MenuItem Header="固定（P）" Click="OnPinClick" />
                <MenuItem Header="滚动（G）" Click="OnScrollClick" />
                <MenuItem Header="圆角导出" Click="OnCornerRadiusClick" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>

          <Border Classes="tool-separator" />

          <Button x:Name="CancelButton"
                  Classes="tool"
                  Click="OnCancelClick"
                  ToolTip.Tip="取消截图（Esc）">
            <Path Data="{StaticResource IconClose}" StrokeThickness="0.828" />
          </Button>
          <!-- ✓：完成并复制（和 LumaShot / snow-shot 的确认键一致） -->
          <Button x:Name="CopyImageButton"
                  Classes="tool primary"
                  Click="OnCopyImageClick"
                  ToolTip.Tip="完成并复制图片（C）">
            <Path Data="{StaticResource IconCheck}" StrokeThickness="1.053" />
          </Button>
        </StackPanel>
      </Border>

      <!-- OCR / 翻译结果条：识别后出现；格式/标点/语言/引擎都收在这一排（参考 snow-shot） -->
      <Border x:Name="OcrTextBar" Classes="capture-bar" HorizontalAlignment="Center" IsVisible="False">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Focusable="False" x:Name="OcrBoxButton" Classes="prop"
                  Click="OnOcrBoxModeClick" ToolTip.Tip="识别框：全部 / 悬停 / 关闭（B）">
            <Path Data="{StaticResource IconOcrFrame}"
                  Width="14" Height="14" Stretch="Uniform"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.2" />
          </Button>
          <Button Focusable="False" x:Name="TranslateButton" Classes="prop"
                  IsVisible="False"
                  Click="OnTranslateToggle" ToolTip.Tip="翻译 / 显示原文">
            <Path Data="{StaticResource IconTranslate}"
                  Width="14" Height="14" Stretch="Uniform"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.2" />
          </Button>
          <Border Classes="prop-sep" />

          <Button Focusable="False" x:Name="FormatButton" Classes="prop" Content="格式"
                  ToolTip.Tip="复制格式">
            <Button.Flyout>
              <MenuFlyout Placement="TopEdgeAlignedLeft" />
            </Button.Flyout>
          </Button>
          <Button Focusable="False" x:Name="PunctuationButton" Classes="prop" Content="标点"
                  ToolTip.Tip="标点处理">
            <Button.Flyout>
              <MenuFlyout Placement="TopEdgeAlignedLeft" />
            </Button.Flyout>
          </Button>

          <!-- OCR 设置与翻译设置各自成组：纯 OCR 时翻译分组整组隐藏 -->
          <Border x:Name="TranslateOptionsSeparator" Classes="prop-sep" IsVisible="False" />

          <Button Focusable="False" x:Name="TranslateTargetButton" Classes="prop" Content="目标语言"
                  ToolTip.Tip="翻译目标语言">
            <Button.Flyout>
              <MenuFlyout Placement="TopEdgeAlignedLeft" />
            </Button.Flyout>
          </Button>
          <Button Focusable="False" x:Name="EngineButton" Classes="prop" Content="引擎"
                  IsVisible="False" ToolTip.Tip="翻译引擎">
            <Button.Flyout>
              <MenuFlyout Placement="TopEdgeAlignedLeft" />
            </Button.Flyout>
          </Button>

          <Border Classes="prop-sep" />

          <Button Focusable="False" x:Name="OcrRefreshButton" Classes="prop"
                  Click="OnRecognizeClick" ToolTip.Tip="重新识别（R）">
            <Path Data="{StaticResource IconScan}"
                  Width="14" Height="14" Stretch="Uniform"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.2" />
          </Button>
        </StackPanel>
      </Border>

      <!-- 识别 / 翻译状态：单独一行，不挤在主工具条里 -->
      <TextBlock x:Name="OcrStatus"
                 IsVisible="False"
                 HorizontalAlignment="Center"
                 MaxWidth="420"
                 FontSize="11"
                 TextTrimming="CharacterEllipsis"
                 Foreground="{StaticResource TextSecondaryBrush}" />

      <!-- 属性栏：只显示当前工具用得上的设置；宽度随内容，居中挂在主条下方 -->
      <Border x:Name="StyleRow" Classes="capture-bar" HorizontalAlignment="Center" IsVisible="False">
        <views:SpacingWrapPanel x:Name="StyleGroups" Spacing="8" LineSpacing="6">

          <!-- 形状类型：矩形 / 椭圆 / 括号。参考 snow-shot 属性栏第一组，
               把形状切换放到手边，画完一个形状不用再回主条折叠组 -->
          <StackPanel x:Name="ShapeTypeGroup" Orientation="Horizontal" Spacing="4">
            <TextBlock Classes="prop-label" Text="形状" />
            <Button x:Name="ShapeRectButton" Classes="prop seg"
                    Click="OnRectToolClick" ToolTip.Tip="矩形（2）">
              <Path Data="{StaticResource ToolRect}" />
            </Button>
            <Button x:Name="ShapeEllipseButton" Classes="prop seg"
                    Click="OnEllipseToolClick" ToolTip.Tip="椭圆（3）">
              <Path Data="{StaticResource ToolEllipse}" />
            </Button>
            <Button x:Name="ShapeDiamondButton" Classes="prop seg"
                    Click="OnDiamondToolClick" ToolTip.Tip="菱形">
              <Path Data="{StaticResource ToolDiamond}" />
            </Button>
            <Button x:Name="ShapeBracketButton" Classes="prop seg"
                    Click="OnBracketToolClick" ToolTip.Tip="括号（[）">
              <Path Data="{StaticResource ToolBracket}" />
            </Button>
            <!-- 分隔线放在组内：非形状工具整组隐藏时，颜色组不会多出前导分隔 -->
            <Border Classes="prop-sep" />
          </StackPanel>

          <StackPanel x:Name="ColorGroup" Orientation="Horizontal" Spacing="4">
            <TextBlock Classes="prop-label" Text="颜色" />
            <Button x:Name="ColorAmberButton" Classes="swatch" Tag="#E5A44C"
                    Background="#E5A44C" ToolTip.Tip="描边颜色 #E5A44C" Click="OnColorClick" />
            <Button x:Name="ColorWhiteButton" Classes="swatch" Tag="#FFFFFF"
                    Background="#FFFFFF" ToolTip.Tip="描边颜色 #FFFFFF" Click="OnColorClick" />
            <Button x:Name="ColorRedButton" Classes="swatch" Tag="#FF5F5F"
                    Background="#FF5F5F" ToolTip.Tip="描边颜色 #FF5F5F" Click="OnColorClick" />
            <Button x:Name="ColorGreenButton" Classes="swatch" Tag="#5FD08C"
                    Background="#5FD08C" ToolTip.Tip="描边颜色 #5FD08C" Click="OnColorClick" />
            <Button x:Name="ColorBlueButton" Classes="swatch" Tag="#5FA8FF"
                    Background="#5FA8FF" ToolTip.Tip="描边颜色 #5FA8FF" Click="OnColorClick" />
            <Button x:Name="CustomColorButton" Classes="swatch"
                    ToolTip.Tip="颜色与线型" Click="OnCustomColorClick">
              <Button.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                  <GradientStop Color="#FF5F5F" Offset="0" />
                  <GradientStop Color="#E5A44C" Offset="0.25" />
                  <GradientStop Color="#5FD08C" Offset="0.5" />
                  <GradientStop Color="#5FA8FF" Offset="0.75" />
                  <GradientStop Color="#B07CFF" Offset="1" />
                </LinearGradientBrush>
              </Button.Background>
            </Button>
          </StackPanel>

          <StackPanel x:Name="WidthGroup" Orientation="Horizontal" Spacing="4">
            <Border Classes="prop-sep" />
            <TextBlock Classes="prop-label" Text="线宽" />
            <!-- 可视化档位：横线粗细就是实际线宽，比下拉少一次点击（参考 snow-shot） -->
            <Button x:Name="Width2Button" Classes="prop seg" Click="OnWidth2Menu"
                    ToolTip.Tip="2 px">
              <Border Classes="seg-line" Width="16" Height="2" CornerRadius="1" />
            </Button>
            <Button x:Name="Width3Button" Classes="prop seg" Click="OnWidth3Menu"
                    ToolTip.Tip="3 px">
              <Border Classes="seg-line" Width="16" Height="3" CornerRadius="1.5" />
            </Button>
            <Button x:Name="Width4Button" Classes="prop seg" Click="OnWidth4Menu"
                    ToolTip.Tip="4 px">
              <Border Classes="seg-line" Width="16" Height="4" CornerRadius="2" />
            </Button>
            <Button x:Name="Width8Button" Classes="prop seg" Click="OnWidth8Menu"
                    ToolTip.Tip="8 px">
              <Border Classes="seg-line" Width="16" Height="6" CornerRadius="3" />
            </Button>
            <Button x:Name="Width12Button" Classes="prop seg" Click="OnWidth12Menu"
                    ToolTip.Tip="12 px">
              <Border Classes="seg-line" Width="16" Height="8" CornerRadius="4" />
            </Button>
          </StackPanel>

          <StackPanel x:Name="FillGroup" Orientation="Horizontal" Spacing="4">
            <Border Classes="prop-sep" />
            <TextBlock Classes="prop-label" Text="填充" />
            <Button x:Name="FillNoneButton" Classes="prop seg swatch-seg"
                    Click="OnFillNoneMenu" ToolTip.Tip="无填充">
              <!-- 透明用棋盘格表示（参考 snow-shot），比空心框更直观 -->
              <Border Classes="seg-swatch" Width="12" Height="12" CornerRadius="2">
                <Border.Background>
                  <DrawingBrush TileMode="Tile" Stretch="None"
                                SourceRect="0,0,8,8" DestinationRect="0,0,6,6">
                    <DrawingBrush.Drawing>
                      <DrawingGroup>
                        <GeometryDrawing Brush="#FF4A5260" Geometry="M0,0 H4 V4 H0 Z" />
                        <GeometryDrawing Brush="#FF2A313B" Geometry="M4,4 H8 V8 H4 Z" />
                      </DrawingGroup>
                    </DrawingBrush.Drawing>
                  </DrawingBrush>
                </Border.Background>
              </Border>
            </Button>
            <!-- 填充预设色：点一下 = 实心 + 该颜色（参考 snow-shot 的填充色块） -->
            <Button x:Name="FillPresetPinkButton" Classes="swatch"
                    Background="#FFCCC7" ToolTip.Tip="填充色 #FFCCC7"
                    Click="OnFillPresetClick" Tag="#FFCCC7" />
            <Button x:Name="FillPresetWhiteButton" Classes="swatch"
                    Background="#FFFFFF" ToolTip.Tip="填充色 #FFFFFF"
                    Click="OnFillPresetClick" Tag="#FFFFFF" />
            <Button x:Name="FillPresetBlueButton" Classes="swatch"
                    Background="#BAE0FF" ToolTip.Tip="填充色 #BAE0FF"
                    Click="OnFillPresetClick" Tag="#BAE0FF" />
            <Button x:Name="FillSoftButton" Classes="prop seg swatch-seg"
                    Click="OnFillSoftMenu" ToolTip.Tip="淡色填充">
              <Border Classes="seg-swatch soft" Width="12" Height="12" CornerRadius="2" />
            </Button>
            <Button x:Name="FillSolidButton" Classes="prop seg swatch-seg"
                    Click="OnFillSolidMenu" ToolTip.Tip="实心填充">
              <Border Classes="seg-swatch solid" Width="12" Height="12" CornerRadius="2" />
            </Button>
            <Button x:Name="FillLineButton" Classes="prop seg swatch-seg"
                    Click="OnFillLineMenu" ToolTip.Tip="斜线填充">
              <Border Classes="seg-swatch" Width="12" Height="12" CornerRadius="2">
                <Border.Background>
                  <DrawingBrush TileMode="Tile" Stretch="None"
                                SourceRect="0,0,6,6" DestinationRect="0,0,4,4">
                    <DrawingBrush.Drawing>
                      <DrawingGroup>
                        <GeometryDrawing Geometry="M-1,5 L5,-1 M1,7 L7,1">
                          <GeometryDrawing.Pen>
                            <Pen Brush="#FFE5A44C" Thickness="1" />
                          </GeometryDrawing.Pen>
                        </GeometryDrawing>
                      </DrawingGroup>
                    </DrawingBrush.Drawing>
                  </DrawingBrush>
                </Border.Background>
              </Border>
            </Button>
            <Button x:Name="FillCrossButton" Classes="prop seg swatch-seg"
                    Click="OnFillCrossMenu" ToolTip.Tip="交叉斜线填充">
              <Border Classes="seg-swatch" Width="12" Height="12" CornerRadius="2">
                <Border.Background>
                  <DrawingBrush TileMode="Tile" Stretch="None"
                                SourceRect="0,0,6,6" DestinationRect="0,0,4,4">
                    <DrawingBrush.Drawing>
                      <DrawingGroup>
                        <GeometryDrawing Geometry="M-1,5 L5,-1 M1,7 L7,1 M-1,1 L5,7 M1,-1 L7,5">
                          <GeometryDrawing.Pen>
                            <Pen Brush="#FFE5A44C" Thickness="1" />
                          </GeometryDrawing.Pen>
                        </GeometryDrawing>
                      </DrawingGroup>
                    </DrawingBrush.Drawing>
                  </DrawingBrush>
                </Border.Background>
              </Border>
            </Button>
            <!-- 填充色独立于描边色；直接点开调色板 -->
            <Button x:Name="FillColorButton" Classes="prop"
                    Click="OnFillColorClick" ToolTip.Tip="填充颜色">
              <Border x:Name="FillColorSwatch" Width="12" Height="12" CornerRadius="3"
                      BorderThickness="1" BorderBrush="#40FFFFFF" Background="Transparent" />
            </Button>
          </StackPanel>

          <StackPanel x:Name="OpacityGroup" Orientation="Horizontal" Spacing="6">
            <Border Classes="prop-sep" />
            <TextBlock Classes="prop-label" Text="透明度" />
            <Slider x:Name="OpacitySlider" Classes="prop"
                    Minimum="20" Maximum="100" Value="100"
                    ValueChanged="OnOpacityChanged" />
            <TextBlock x:Name="OpacityValue" Classes="prop-value" Text="100%" />
          </StackPanel>

          <StackPanel x:Name="RadiusGroup" Orientation="Horizontal" Spacing="6">
            <Border Classes="prop-sep" />
            <TextBlock Classes="prop-label" Text="圆角" />
            <Slider x:Name="RadiusSlider" Classes="prop"
                    Minimum="0" Maximum="40" Value="0"
                    ValueChanged="OnRadiusChanged" />
            <TextBlock x:Name="RadiusValue" Classes="prop-value" Text="0 px" />
          </StackPanel>

          <StackPanel x:Name="FontGroup" Orientation="Horizontal" Spacing="4">
            <Border Classes="prop-sep" />
            <TextBlock Classes="prop-label" Text="字体" />
            <ComboBox x:Name="FontFamilyBox" Width="136" Height="26" FontSize="11"
                      SelectionChanged="OnFontFamilyChanged" ToolTip.Tip="文字字体" />
            <TextBlock Classes="prop-label" Text="字号" />
            <!-- S/M/L/XL 档位 + 数值（参考做法），比下拉少两次点击 -->
            <Button x:Name="FontSButton" Classes="prop seg"
                    Content="S" Click="OnFont14Menu" ToolTip.Tip="14 px" />
            <Button x:Name="FontMButton" Classes="prop seg"
                    Content="M" Click="OnFont16Menu" ToolTip.Tip="16 px" />
            <Button x:Name="FontLButton" Classes="prop seg"
                    Content="L" Click="OnFont20Menu" ToolTip.Tip="20 px" />
            <Button x:Name="FontXlButton" Classes="prop seg"
                    Content="XL" Click="OnFont32Menu" ToolTip.Tip="32 px" />
            <Button x:Name="BoldButton" Classes="prop" Content="B"
                    FontWeight="Bold" Padding="8,0" Click="OnBoldClick"
                    ToolTip.Tip="加粗" />
            <Button x:Name="ItalicButton" Classes="prop" Content="I"
                    FontStyle="Italic" Padding="8,0" Click="OnItalicClick"
                    ToolTip.Tip="斜体" />
          </StackPanel>

          <!-- 文字排版：对齐 / 背景 / 描边，只在文字工具出现 -->
          <StackPanel x:Name="TextLayoutGroup" Orientation="Horizontal" Spacing="4">
            <Border Classes="prop-sep" />
            <TextBlock Classes="prop-label" Text="对齐" />
            <Button x:Name="AlignLeftButton" Classes="prop seg" Content="左"
                    Click="OnAlignLeftMenu" ToolTip.Tip="左对齐" />
            <Button x:Name="AlignCenterButton" Classes="prop seg" Content="中"
                    Click="OnAlignCenterMenu" ToolTip.Tip="居中对齐" />
            <Button x:Name="AlignRightButton" Classes="prop seg" Content="右"
                    Click="OnAlignRightMenu" ToolTip.Tip="右对齐" />

            <TextBlock Classes="prop-label" Text="背景" />
            <Button x:Name="BackgroundMenuButton" Classes="prop" Content="无背景">
              <Button.Flyout>
                <MenuFlyout Placement="Top">
                  <MenuItem Header="无背景" Click="OnBackgroundNoneMenu" />
                  <MenuItem Header="黑底" Click="OnBackgroundBlackMenu" />
                  <MenuItem Header="白底" Click="OnBackgroundWhiteMenu" />
                  <MenuItem Header="琥珀底" Click="OnBackgroundAmberMenu" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>

            <TextBlock Classes="prop-label" Text="描边" />
            <Button x:Name="StrokeWidthMenuButton" Classes="prop" Content="无描边">
              <Button.Flyout>
                <MenuFlyout Placement="Top">
                  <MenuItem Header="无描边" Click="OnStrokeWidth0Menu" />
                  <MenuItem Header="1 px" Click="OnStrokeWidth1Menu" />
                  <MenuItem Header="2 px" Click="OnStrokeWidth2Menu" />
                  <MenuItem Header="4 px" Click="OnStrokeWidth4Menu" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button x:Name="StrokeColorMenuButton" Classes="prop" Content="黑">
              <Button.Flyout>
                <MenuFlyout Placement="Top">
                  <MenuItem Header="黑" Click="OnStrokeColorBlackMenu" />
                  <MenuItem Header="白" Click="OnStrokeColorWhiteMenu" />
                  <MenuItem Header="琥珀" Click="OnStrokeColorAmberMenu" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>

          <!-- 水印文本：选中水印时直接改它，没选中时改下次创建的默认值 -->
          <StackPanel x:Name="WatermarkGroup" Orientation="Horizontal" Spacing="4">
            <Border Classes="prop-sep" />
            <TextBlock Classes="prop-label" Text="文本" />
            <TextBox x:Name="WatermarkBox" Width="150" Height="26" FontSize="11"
                     PlaceholderText="水印文字"
                     ToolTip.Tip="自定义平铺的水印文字"
                     TextChanged="OnWatermarkBoxChanged"
                     KeyDown="OnWatermarkBoxKeyDown"
                     LostFocus="OnWatermarkBoxLostFocus" />
          </StackPanel>

          <!-- 序号：类型与外形单独一组，避免整条过宽在窄窗口溢出 -->
          <StackPanel x:Name="NumberFormatGroup" Orientation="Horizontal" Spacing="4">
            <Border Classes="prop-sep" />
            <TextBlock Classes="prop-label" Text="类型" />
            <Button x:Name="NumberFormatButton" Classes="prop" Content="阿拉伯 1 2 3">
              <Button.Flyout>
                <MenuFlyout Placement="Top">
                  <MenuItem Header="阿拉伯数字 1 2 3" Click="OnNumberArabicMenu" />
                  <MenuItem Header="罗马数字 Ⅰ Ⅱ Ⅲ" Click="OnNumberRomanMenu" />
                  <MenuItem Header="小写字母 a b c" Click="OnNumberLowerMenu" />
                  <MenuItem Header="大写字母 A B C" Click="OnNumberUpperMenu" />
                  <MenuItem Header="中文数字 一 二 三" Click="OnNumberChineseMenu" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>

            <TextBlock Classes="prop-label" Text="外形" />
            <Button x:Name="NumberShapeButton" Classes="prop" Content="实心圆">
              <Button.Flyout>
                <MenuFlyout Placement="Top">
                  <MenuItem Header="实心圆" Tag="SolidCircle" Click="OnNumberShapeMenu" />
                  <MenuItem Header="描边圆" Tag="OutlineCircle" Click="OnNumberShapeMenu" />
                  <MenuItem Header="双层圆" Tag="DoubleCircle" Click="OnNumberShapeMenu" />
                  <MenuItem Header="实心方块" Tag="SolidSquare" Click="OnNumberShapeMenu" />
                  <MenuItem Header="圆角方块" Tag="RoundedSquare" Click="OnNumberShapeMenu" />
                  <MenuItem Header="胶囊标签" Tag="Capsule" Click="OnNumberShapeMenu" />
                  <MenuItem Header="旗标" Tag="Flag" Click="OnNumberShapeMenu" />
                  <MenuItem Header="定位针" Tag="Pin" Click="OnNumberShapeMenu" />
                  <MenuItem Header="六边形" Tag="Hexagon" Click="OnNumberShapeMenu" />
                  <MenuItem Header="角标标签" Tag="Corner" Click="OnNumberShapeMenu" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>

          </StackPanel>

          <StackPanel x:Name="NumberGroup" Orientation="Horizontal" Spacing="4">
            <TextBlock Classes="prop-label" Text="序号" />
            <TextBox x:Name="NumberBox" Width="54" Height="26" FontSize="11"
                     HorizontalContentAlignment="Center" PlaceholderText="自动"
                     ToolTip.Tip="留空自动递增，填数字手动指定"
                     KeyDown="OnNumberBoxKeyDown" LostFocus="OnNumberBoxLostFocus" />

            <TextBlock Classes="prop-label" Text="标签" />
            <TextBox x:Name="LabelBox" Width="84" Height="26" FontSize="11"
                     PlaceholderText="自动序号"
                     ToolTip.Tip="留空显示序号，填了就用这段文字"
                     KeyDown="OnLabelBoxKeyDown" LostFocus="OnLabelBoxLostFocus" />

            <TextBlock Classes="prop-label" Text="大小" />
            <Button x:Name="NumberSizeMenuButton" Classes="prop" Content="24 px">
              <Button.Flyout>
                <MenuFlyout Placement="Top">
                  <MenuItem Header="16 px" Click="OnNumber16Menu" />
                  <MenuItem Header="24 px" Click="OnNumber24Menu" />
                  <MenuItem Header="32 px" Click="OnNumber32Menu" />
                  <MenuItem Header="48 px" Click="OnNumber48Menu" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>

            <TextBlock Classes="prop-label" Text="组合" />
            <Button x:Name="NumberComboButton" Classes="prop" Content="仅序号">
              <Button.Flyout>
                <MenuFlyout Placement="Top">
                  <MenuItem Header="仅序号" Tag="Plain" Click="OnNumberComboMenu" />
                  <MenuItem Header="引导线" Tag="Leader" Click="OnNumberComboMenu" />
                  <MenuItem Header="箭头" Tag="Arrow" Click="OnNumberComboMenu" />
                  <MenuItem Header="文本标签" Tag="Text" Click="OnNumberComboMenu" />
                  <MenuItem Header="虚线框" Tag="DashedBox" Click="OnNumberComboMenu" />
                  <MenuItem Header="高亮区域" Tag="Highlight" Click="OnNumberComboMenu" />
                  <MenuItem Header="放大说明" Tag="Magnify" Click="OnNumberComboMenu" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>

            <!-- 文本标签组合的说明文字 -->
            <StackPanel x:Name="NumberTextGroup" Orientation="Horizontal" Spacing="4" IsVisible="False">
              <TextBlock Classes="prop-label" Text="说明" />
              <TextBox x:Name="NumberTextBox" Width="120" Height="26" FontSize="11"
                       PlaceholderText="说明文字"
                       TextChanged="OnNumberTextChanged"
                       KeyDown="OnNumberTextBoxKeyDown"
                       LostFocus="OnNumberTextBoxLostFocus" />
              <Button x:Name="NumberTextSizeButton" Classes="prop" Content="16 px">
                <Button.Flyout>
                  <MenuFlyout Placement="Top">
                    <MenuItem Header="12 px" Click="OnNumberTextSize12Menu" />
                    <MenuItem Header="14 px" Click="OnNumberTextSize14Menu" />
                    <MenuItem Header="16 px" Click="OnNumberTextSize16Menu" />
                    <MenuItem Header="20 px" Click="OnNumberTextSize20Menu" />
                    <MenuItem Header="24 px" Click="OnNumberTextSize24Menu" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </StackPanel>

            <!-- 放大说明组合的倍率 -->
            <StackPanel x:Name="NumberZoomGroup" Orientation="Horizontal" Spacing="4" IsVisible="False">
              <TextBlock Classes="prop-label" Text="倍率" />
              <Button x:Name="NumberZoomButton" Classes="prop" Content="2.5×">
                <Button.Flyout>
                  <MenuFlyout Placement="Top">
                    <MenuItem Header="2×" Click="OnNumberZoom2Menu" />
                    <MenuItem Header="3×" Click="OnNumberZoom3Menu" />
                    <MenuItem Header="4×" Click="OnNumberZoom4Menu" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
          </StackPanel>

          <StackPanel x:Name="MosaicGroup" Orientation="Horizontal" Spacing="4">
            <TextBlock Classes="prop-label" Text="方式" />
            <Button x:Name="MosaicPixelButton" Classes="prop seg"
                    Content="像素" Click="OnMosaicPixelMenu" />
            <Button x:Name="MosaicBlurButton" Classes="prop seg"
                    Content="模糊" Click="OnMosaicBlurMenu" />
            <TextBlock Classes="prop-label" Text="笔刷" />
            <Button x:Name="BrushMenuButton" Classes="prop" Content="12 px">
              <Button.Flyout>
                <MenuFlyout Placement="Top">
                  <MenuItem Header="8 px" Click="OnBrush8Menu" />
                  <MenuItem Header="12 px" Click="OnBrush12Menu" />
                  <MenuItem Header="20 px" Click="OnBrush20Menu" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>

          <Button x:Name="PresetButton" Classes="tool small"
                  ToolTip.Tip="标注样式模板">
            <Path Data="{StaticResource IconStar}" />
            <Button.Flyout>
              <MenuFlyout Placement="TopEdgeAlignedRight" />
            </Button.Flyout>
          </Button>
        </views:SpacingWrapPanel>
      </Border>

      <!-- 译文工具条：只在有译文时出现，和参考一样独立一行，不挤主工具条 -->
      <Border x:Name="TransRow" Classes="capture-bar" HorizontalAlignment="Center" IsVisible="False">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Focusable="False" x:Name="ShowOriginalButton" Classes="prop"
                  Click="OnShowOriginalClick" ToolTip.Tip="显示原图">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Data="{StaticResource IconEye}"
                    Stroke="{DynamicResource TextPrimaryBrush}"
                    StrokeThickness="1.2"
                    Width="14"
                    Height="14"
                    Stretch="Uniform" />
              <TextBlock x:Name="ShowOriginalText" Text="显示原图" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Border Classes="prop-sep" />
          <TextBlock x:Name="TransTargetText" Classes="prop-label" Text="译文" />
          <Button Focusable="False" x:Name="TransCompareButton" Classes="prop"
                  Content="对比" Click="OnTransCompareClick" ToolTip.Tip="左右对比" />
          <Button Focusable="False" Classes="prop" Content="复制译文"
                  Click="OnTransCopyClick" ToolTip.Tip="只复制译文部分" />
          <Button Focusable="False" Classes="prop" Content="关闭" Click="OnTransCloseClick"
                  ToolTip.Tip="退出译文视图，回到识别框" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- OCR 字符选择后的浮动菜单：复制 + 四种文字标记 -->
    <Border x:Name="OcrMarkMenu"
            Classes="tool-popover"
            IsVisible="False"
            IsHitTestVisible="True">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Focusable="False" Classes="prop" Click="OnOcrMarkCopyClick"
                ToolTip.Tip="复制选中的文字">
          <Path Data="{StaticResource IconCopy}"
                Stroke="{DynamicResource TextPrimaryBrush}"
                StrokeThickness="1.4" Width="15" Height="15" Stretch="Uniform" />
        </Button>
        <Button Focusable="False" Classes="prop" Click="OnOcrHighlightClick"
                ToolTip.Tip="荧光笔：给选中的字加底色">
          <Path Data="{StaticResource ToolHighlighter}"
                Stroke="{DynamicResource TextPrimaryBrush}"
                StrokeThickness="1.4" Width="15" Height="15" Stretch="Uniform" />
        </Button>
        <Button Focusable="False" Classes="prop" Click="OnOcrWaveClick"
                ToolTip.Tip="波浪线">
          <Path Data="{StaticResource IconTextWave}"
                Stroke="{DynamicResource TextPrimaryBrush}"
                StrokeThickness="1.4" Width="15" Height="15" Stretch="Uniform" />
        </Button>
        <Button Focusable="False" Classes="prop" Click="OnOcrUnderlineClick"
                ToolTip.Tip="下划线">
          <Path Data="{StaticResource IconTextUnderline}"
                Stroke="{DynamicResource TextPrimaryBrush}"
                StrokeThickness="1.4" Width="15" Height="15" Stretch="Uniform" />
        </Button>
        <Button Focusable="False" Classes="prop" Click="OnOcrStrikeClick"
                ToolTip.Tip="删除线">
          <Path Data="{StaticResource IconTextStrike}"
                Stroke="{DynamicResource TextPrimaryBrush}"
                StrokeThickness="1.4" Width="15" Height="15" Stretch="Uniform" />
        </Button>
      </StackPanel>
    </Border>

    <!-- 工具组悬停弹出：内容是代码构建的，位置在触发按钮上方 -->
    <Border x:Name="ToolGroupPopover"
            Classes="tool-popover"
            IsVisible="False"
            IsHitTestVisible="True">
      <StackPanel x:Name="ToolGroupOptions" Orientation="Horizontal" Spacing="2" />
    </Border>

    <!-- 更多识别：主条按钮上方的选项条（文本 / 表格 HTML / 表格 Markdown） -->
    <Border x:Name="RecognitionPopover"
            Classes="tool-popover"
            IsVisible="False"
            IsHitTestVisible="True">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button x:Name="RecognizeTextOption" Classes="tool"
                Click="OnRecognizeTextOption" ToolTip.Tip="文本识别">
          <Path Data="{StaticResource IconScan}" />
        </Button>
        <Button x:Name="RecognizeTableHtmlOption" Classes="tool"
                Click="OnRecognizeTableHtmlOption" ToolTip.Tip="表格识别 · HTML">
          <Path Data="{StaticResource IconTable}" StrokeThickness="1.1" />
        </Button>
        <Button x:Name="RecognizeTableMarkdownOption" Classes="tool"
                Click="OnRecognizeTableMarkdownOption" ToolTip.Tip="表格识别 · Markdown">
          <Path Data="{StaticResource IconFile}" StrokeThickness="1.1" />
        </Button>
      </StackPanel>
    </Border>

    <!-- 自定义颜色：贴在属性栏上方的浮层 -->
    <Border x:Name="CustomColorPanel"
            IsVisible="False"
            Width="256"
            Background="{StaticResource OverlayBrush}"
            BorderBrush="{StaticResource LineStrongBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12"
            BoxShadow="0 12 32 0 #99000000">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="ColorPanelTitle" Text="描边颜色" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
          <Button Grid.Column="1" Classes="ghost" Content="✕" FontSize="11" Padding="6,0"
                  Click="OnCloseColorPanel" ToolTip.Tip="关闭" />
        </Grid>

        <!-- 线型与笔触：和颜色共用同一个调色板（参考 snow-shot），形状/直线/画笔都从这里改 -->
        <!-- 描边：线型与笔触统一成一行，五个选项互斥 -->
        <StackPanel x:Name="DashGroup" Orientation="Horizontal" Spacing="4">
          <TextBlock Classes="prop-label" Text="描边" VerticalAlignment="Center" Width="28" />
          <Button x:Name="DashSolidButton" Classes="prop seg"
                  Click="OnDashSolidMenu" ToolTip.Tip="实线">
            <Border Classes="seg-line" Width="16" Height="2" />
          </Button>
          <Button x:Name="DashDashButton" Classes="prop seg"
                  Click="OnDashDashMenu" ToolTip.Tip="虚线">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Border Classes="seg-line" Width="4" Height="2" />
              <Border Classes="seg-line" Width="4" Height="2" />
              <Border Classes="seg-line" Width="4" Height="2" />
            </StackPanel>
          </Button>
          <Button x:Name="DashDotButton" Classes="prop seg"
                  Click="OnDashDotMenu" ToolTip.Tip="点线">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Border Classes="seg-line" Width="2" Height="2" CornerRadius="1" />
              <Border Classes="seg-line" Width="2" Height="2" CornerRadius="1" />
              <Border Classes="seg-line" Width="2" Height="2" CornerRadius="1" />
            </StackPanel>
          </Button>
          <Button x:Name="StyleSketchButton" Classes="prop seg"
                  Click="OnStyleSketchMenu" ToolTip.Tip="手绘：轻微抖动">
            <Path Data="M1 9 C4.5 3 7.5 3 11 9 C13 12.5 15 12.5 17 9" />
          </Button>
          <Button x:Name="StyleRoughButton" Classes="prop seg"
                  Click="OnStyleRoughMenu" ToolTip.Tip="涂鸦：双线粗手绘">
            <Path Data="M1 9 C3 4 5 11 7.5 7 C10 3 12 10 14 7 C15.5 5 16.5 7 17 9" />
          </Button>
        </StackPanel>

        <Border x:Name="SvArea" Height="110" CornerRadius="6" ClipToBounds="True"
                Cursor="Cross"
                PointerPressed="OnSvPressed"
                PointerMoved="OnSvMoved">
          <Panel>
            <Border x:Name="HueBase" Background="#FF0000" />
            <Border>
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                  <GradientStop Color="#FFFFFFFF" Offset="0" />
                  <GradientStop Color="#00FFFFFF" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Border>
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Color="#00000000" Offset="0" />
                  <GradientStop Color="#FF000000" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Ellipse x:Name="SvCursor" Width="12" Height="12"
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     Stroke="#FFFFFFFF" StrokeThickness="2" IsHitTestVisible="False" />
          </Panel>
        </Border>

        <Border x:Name="HueBar" Height="12" CornerRadius="6" ClipToBounds="True"
                Cursor="Hand"
                PointerPressed="OnHuePressed"
                PointerMoved="OnHueMoved">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
              <GradientStop Color="#FF5F5F" Offset="0" />
              <GradientStop Color="#E5C14C" Offset="0.17" />
              <GradientStop Color="#5FD08C" Offset="0.34" />
              <GradientStop Color="#4FD7C8" Offset="0.5" />
              <GradientStop Color="#5FA8FF" Offset="0.67" />
              <GradientStop Color="#B07CFF" Offset="0.84" />
              <GradientStop Color="#FF5F5F" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>

        <!-- 透明度条：棋盘格底 + 当前色到透明的渐变（参考 snow-shot 的 alpha 条） -->
        <Border x:Name="AlphaBar" Height="12" CornerRadius="6" ClipToBounds="True"
                Cursor="Hand"
                PointerPressed="OnAlphaPressed"
                PointerMoved="OnAlphaMoved">
          <Panel>
            <Border>
              <Border.Background>
                <DrawingBrush TileMode="Tile" Stretch="None"
                              SourceRect="0,0,8,8" DestinationRect="0,0,6,6">
                  <DrawingBrush.Drawing>
                    <DrawingGroup>
                      <GeometryDrawing Brush="#FF4A5260" Geometry="M0,0 H4 V4 H0 Z" />
                      <GeometryDrawing Brush="#FF2A313B" Geometry="M4,4 H8 V8 H4 Z" />
                    </DrawingGroup>
                  </DrawingBrush.Drawing>
                </DrawingBrush>
              </Border.Background>
            </Border>
            <Border x:Name="AlphaGradient">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                  <GradientStop Color="#00E5A44C" Offset="0" />
                  <GradientStop Color="#FFE5A44C" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Ellipse x:Name="AlphaCursor" Width="12" Height="12"
                     HorizontalAlignment="Left" VerticalAlignment="Center"
                     Stroke="#FFFFFFFF" StrokeThickness="2" IsHitTestVisible="False" />
          </Panel>
        </Border>

        <!-- HEX 输入 + 透明度读数 -->
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Classes="prop-label" Text="HEX" VerticalAlignment="Center" />
          <TextBox x:Name="HexBox" Grid.Column="1" Height="26" FontSize="11" Margin="6,0"
                   KeyDown="OnHexBoxKeyDown" LostFocus="OnHexBoxLostFocus" />
          <TextBlock x:Name="AlphaText" Grid.Column="2" Classes="prop-value"
                     Text="100%" VerticalAlignment="Center" />
        </Grid>

        <!-- 预设色板 -->
        <WrapPanel x:Name="PresetColors" ItemWidth="22" ItemHeight="22" Orientation="Horizontal" />

        <!-- 最近使用 -->
        <WrapPanel x:Name="RecentColors" ItemWidth="22" ItemHeight="22" Orientation="Horizontal" />

        <Button Classes="prop" Content="应用" Click="OnApplyCustomColor" HorizontalAlignment="Right" />
      </StackPanel>
    </Border>
  </Canvas>
</Window>
