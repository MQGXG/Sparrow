<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sparrow.App.Views.CaptureWindow"
        Title="SparrowCapture"
        WindowDecorations="None"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        Background="#80000000">

  <Canvas x:Name="Root" Background="Transparent">

    <Rectangle x:Name="Selection"
               IsVisible="False"
               Fill="#20D97706"
               Stroke="#D97706"
               StrokeThickness="2" />

    <Border Canvas.Left="0"
            Canvas.Top="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="#CC161B22"
            CornerRadius="6"
            Padding="12,6"
            Margin="0,24,0,0">
      <TextBlock Text="拖拽选择区域，Esc 取消"
                 FontSize="13"
                 Foreground="#E6EDF3" />
    </Border>

    <Border x:Name="ActionBar"
            IsVisible="False"
            Background="#EE161B22"
            CornerRadius="8"
            Padding="8,6"
            BorderBrush="#2A333F"
            BorderThickness="1">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="识别文字" Click="OnRecognizeClick" Padding="12,4" ToolTip.Tip="Enter" />
        <Button Content="复制图片" Click="OnCopyImageClick" Padding="12,4" ToolTip.Tip="C" />
        <Button Content="保存" Click="OnSaveClick" Padding="12,4" ToolTip.Tip="S" />
        <Button Content="固定" Click="OnPinClick" Padding="12,4" ToolTip.Tip="P" />
        <Button Content="取消" Click="OnCancelClick" Padding="12,4" ToolTip.Tip="Esc" />
      </StackPanel>
    </Border>

  </Canvas>
</Window>
