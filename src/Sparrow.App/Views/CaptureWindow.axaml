<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sparrow.App.Views.CaptureWindow"
        Title="SparrowCapture"
        WindowDecorations="None"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        Background="#80000000">

  <Canvas x:Name="Root" Background="Transparent">

    <Rectangle x:Name="Selection"
               IsVisible="False"
               Fill="{StaticResource AccentSelectionBrush}"
               Stroke="{StaticResource AccentBrush}"
               StrokeThickness="2" />

    <!-- 选区尺寸：显示物理像素，和最终截图尺寸一致 -->
    <Border x:Name="SizeBadge"
            IsVisible="False"
            IsHitTestVisible="False"
            Background="{StaticResource OverlayBrush}"
            BorderBrush="{StaticResource LineStrongBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="8,4">
      <TextBlock x:Name="SizeText"
                 FontFamily="{StaticResource MonoFont}"
                 FontSize="11"
                 Foreground="{StaticResource TextPrimaryBrush}" />
    </Border>

    <Border Canvas.Left="0"
            Canvas.Top="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{StaticResource OverlayBrush}"
            BorderBrush="{StaticResource LineStrongBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,8"
            Margin="0,24,0,0">
      <TextBlock Text="拖拽选择区域    Enter 识别    Esc 取消"
                 FontSize="12"
                 Foreground="{StaticResource TextSecondaryBrush}" />
    </Border>

    <Border x:Name="ActionBar"
            IsVisible="False"
            Background="{StaticResource OverlayBrush}"
            BorderBrush="{StaticResource LineStrongBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="8"
            BoxShadow="0 12 32 0 #99000000">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Classes="accent"
                Content="识别文字"
                Click="OnRecognizeClick"
                ToolTip.Tip="Enter" />
        <Button Content="复制图片" Click="OnCopyImageClick" ToolTip.Tip="C" />
        <Button Content="保存" Click="OnSaveClick" ToolTip.Tip="S" />
        <Button Content="固定" Click="OnPinClick" ToolTip.Tip="P" />
        <Button Content="滚动" Click="OnScrollClick" ToolTip.Tip="G" />
        <Button Classes="ghost" Content="取消" Click="OnCancelClick" ToolTip.Tip="Esc" />
      </StackPanel>
    </Border>

  </Canvas>
</Window>
