<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sparrow.App.Views.CaptureWindow"
        Title="SparrowCapture"
        WindowDecorations="None"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        Background="#80000000">

  <Canvas x:Name="Root" Background="Transparent">

    <Rectangle x:Name="Selection"
               IsVisible="False"
               Fill="{StaticResource AccentSelectionBrush}"
               Stroke="{StaticResource AccentBrush}"
               StrokeThickness="2" />

    <!-- 8 个控制点：只负责显示，命中判定在窗口里做 -->
    <Canvas x:Name="HandleLayer"
            IsVisible="False"
            IsHitTestVisible="False" />

    <!-- 选区尺寸：显示物理像素，和最终截图尺寸一致 -->
    <Border x:Name="SizeBadge"
            IsVisible="False"
            IsHitTestVisible="False"
            Background="{StaticResource OverlayBrush}"
            BorderBrush="{StaticResource LineStrongBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="8,4">
      <TextBlock x:Name="SizeText"
                 FontFamily="{StaticResource MonoFont}"
                 FontSize="11"
                 Foreground="{StaticResource TextPrimaryBrush}" />
    </Border>

    <!-- 就地 OCR：行框叠在选区上，点一行复制一行 -->
    <Canvas x:Name="OcrLayer"
            IsVisible="False"
            ClipToBounds="True" />

    <Border Canvas.Left="0"
            Canvas.Top="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{StaticResource OverlayBrush}"
            BorderBrush="{StaticResource LineStrongBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,8"
            Margin="0,24,0,0">
      <TextBlock Text="拖拽选择区域 · 松手后可移动 / 拉伸 · Enter 识别"
                 FontSize="12"
                 Foreground="{StaticResource TextSecondaryBrush}" />
    </Border>

    <Border x:Name="ActionBar"
            IsVisible="False"
            Background="{StaticResource OverlayBrush}"
            BorderBrush="{StaticResource LineStrongBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="8"
            BoxShadow="0 12 32 0 #99000000">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock x:Name="OcrStatus"
                   IsVisible="False"
                   MaxWidth="220"
                   Margin="4,0"
                   VerticalAlignment="Center"
                   FontSize="11"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource TextSecondaryBrush}" />
        <Button Focusable="False" x:Name="RecognizeButton"
                Classes="accent"
                Content="识别文字"
                Click="OnRecognizeClick"
                ToolTip.Tip="识别选区文字（Enter / R）" />
        <Button Focusable="False" Content="复制图片" Click="OnCopyImageClick" ToolTip.Tip="复制选区图片（C）" />
        <Button Focusable="False" Content="保存" Click="OnSaveClick" ToolTip.Tip="保存为 PNG（S）" />
        <Button Focusable="False" Content="固定" Click="OnPinClick" ToolTip.Tip="固定到屏幕，滚轮缩放（P）" />
        <Button Focusable="False" Content="滚动" Click="OnScrollClick" ToolTip.Tip="进入滚动截图（G）" />
        <Button Focusable="False" x:Name="CopyAllButton"
                IsVisible="False"
                Content="复制全文"
                Click="OnCopyAllClick"
                ToolTip.Tip="复制全部识别文字（Ctrl+C）" />
        <Button Focusable="False" Classes="ghost" Content="取消" Click="OnCancelClick" ToolTip.Tip="取消截图（Esc）" />
      </StackPanel>
    </Border>

  </Canvas>
</Window>
