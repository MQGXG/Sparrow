<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sparrow.App.Views.CaptureWindow"
        Title="SparrowCapture"
        WindowDecorations="None"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        Background="Transparent">

  <Window.Styles>
    <!-- 标注工具按钮：选中时琥珀描边 + 淡琥珀底 -->
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.tool.selected">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
  </Window.Styles>

  <Canvas x:Name="Root" Background="Transparent">

    <!-- 冻结帧：按热键时抓的整屏图；没有时退回实时桌面 -->
    <Image x:Name="FrozenFrame"
           IsVisible="False"
           IsHitTestVisible="False"
           Stretch="Fill" />
    <Rectangle x:Name="DimLayer"
               Fill="#80000000"
               IsHitTestVisible="False" />

    <!-- 悬停候选：鼠标停在哪个窗口就虚线框住哪个 -->
    <Rectangle x:Name="CandidateBox"
               IsVisible="False"
               IsHitTestVisible="False"
               Fill="Transparent"
               Stroke="#E5A44C"
               StrokeThickness="1.5"
               StrokeDashArray="4,3" />
    <Border x:Name="CandidateBadge"
            IsVisible="False"
            IsHitTestVisible="False"
            Background="{StaticResource OverlayBrush}"
            BorderBrush="{StaticResource LineStrongBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="6,3">
      <TextBlock x:Name="CandidateText"
                 FontSize="11"
                 Foreground="{StaticResource TextPrimaryBrush}" />
    </Border>

    <!-- 选区只画边框：填充透明，中间保持原图，不盖一层颜色 -->
    <Rectangle x:Name="Selection"
               IsVisible="False"
               Fill="Transparent"
               Stroke="{StaticResource AccentBrush}"
               StrokeThickness="2" />

    <!-- 文字工具的就地输入框：提交后转成图元 -->
    <TextBox x:Name="TextNoteBox"
             IsVisible="False"
             MinWidth="120"
             MaxWidth="420"
             FontSize="16"
             Foreground="#E5A44C"
             Background="#CC101316"
             BorderBrush="#E5A44C"
             BorderThickness="1"
             Padding="4,2"
             KeyDown="OnTextNoteKeyDown"
             LostFocus="OnTextNoteLostFocus" />

    <!-- 标注预览：只画在选区内，坐标相对选区左上角 -->
    <Canvas x:Name="NoteLayer"
            IsVisible="False"
            IsHitTestVisible="False"
            ClipToBounds="True" />

    <!-- 8 个控制点：只负责显示，命中判定在窗口里做 -->
    <Canvas x:Name="HandleLayer"
            IsVisible="False"
            IsHitTestVisible="False" />

    <!-- 选区尺寸：显示物理像素，和最终截图尺寸一致 -->
    <Border x:Name="SizeBadge"
            IsVisible="False"
            IsHitTestVisible="False"
            Background="{StaticResource OverlayBrush}"
            BorderBrush="{StaticResource LineStrongBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="8,4">
      <TextBlock x:Name="SizeText"
                 FontFamily="{StaticResource MonoFont}"
                 FontSize="11"
                 Foreground="{StaticResource TextPrimaryBrush}" />
    </Border>

    <!-- 就地 OCR：行框叠在选区上，点一行复制一行 -->
    <Canvas x:Name="OcrLayer"
            IsVisible="False"
            Background="Transparent"
            ClipToBounds="True" />

    <!-- 识别 / 翻译结果：跟随选区浮在空白处，可选中、可复制 -->
    <Border x:Name="ResultCard"
            IsVisible="False"
            Cursor="Arrow"
            Background="{StaticResource OverlayBrush}"
            BorderBrush="{StaticResource LineStrongBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12,10"
            MaxWidth="520"
            BoxShadow="0 12 32 0 #99000000">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8" MinWidth="300">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="识别结果"
                     FontSize="11"
                     Foreground="{StaticResource TextMutedBrush}" />
          <Button Grid.Column="1"
                  Classes="ghost"
                  Content="关闭"
                  FontSize="11"
                  Padding="6,2"
                  Click="OnResultCloseClick" />
        </Grid>

        <ScrollViewer Grid.Row="1" MaxHeight="240">
          <SelectableTextBlock x:Name="ResultText"
                               FontSize="12"
                               LineHeight="19"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimaryBrush}" />
        </ScrollViewer>

        <Button Grid.Row="2"
                Classes="accent"
                Content="复制"
                HorizontalAlignment="Right"
                Click="OnResultCopyClick" />
      </Grid>
    </Border>

    <Border Canvas.Left="0"
            Canvas.Top="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{StaticResource OverlayBrush}"
            BorderBrush="{StaticResource LineStrongBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,8"
            Margin="0,24,0,0">
      <TextBlock Text="拖拽选择区域 · 松手后可移动 / 拉伸 · Enter 识别"
                 FontSize="12"
                 Foreground="{StaticResource TextSecondaryBrush}" />
    </Border>

    <Border x:Name="ActionBar"
            IsVisible="False"
            Cursor="Arrow"
            Background="{StaticResource OverlayBrush}"
            BorderBrush="{StaticResource LineStrongBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="8"
            BoxShadow="0 12 32 0 #99000000">
      <StackPanel Spacing="6">
        <!-- 工具行：选一个工具后，鼠标在选区内拖动就是画，不再移动选区 -->
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Focusable="False" x:Name="RectToolButton"
                  Classes="tool" Content="矩形"
                  ToolTip.Tip="拖出矩形框（2）" Click="OnRectToolClick" />
          <Button Focusable="False" x:Name="EllipseToolButton"
                  Classes="tool" Content="椭圆"
                  ToolTip.Tip="拖出椭圆（3）" Click="OnEllipseToolClick" />
          <Button Focusable="False" x:Name="ArrowToolButton"
                  Classes="tool" Content="箭头"
                  ToolTip.Tip="画箭头（4）" Click="OnArrowToolClick" />
          <Button Focusable="False" x:Name="PenToolButton"
                  Classes="tool" Content="画笔"
                  ToolTip.Tip="自由画线（5）" Click="OnPenToolClick" />
          <Button Focusable="False" x:Name="HighlighterToolButton"
                  Classes="tool" Content="高亮"
                  ToolTip.Tip="半透明粗线（6）" Click="OnHighlighterToolClick" />
          <Button Focusable="False" x:Name="MosaicToolButton"
                  Classes="tool" Content="马赛克"
                  ToolTip.Tip="拖出要遮挡的区域（7）" Click="OnMosaicToolClick" />
          <Button Focusable="False" x:Name="TextToolButton"
                  Classes="tool" Content="文字"
                  ToolTip.Tip="点一下输入文字（8）" Click="OnTextToolClick" />
          <Button Focusable="False" x:Name="NumberToolButton"
                  Classes="tool" Content="序号"
                  ToolTip.Tip="点一下放置递增编号（9）" Click="OnNumberToolClick" />
          <Button Focusable="False" x:Name="UndoButton"
                  Classes="ghost" Content="撤销"
                  ToolTip.Tip="撤销上一条标注（Ctrl+Z）" Click="OnUndoClick" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock x:Name="OcrStatus"
                   IsVisible="False"
                   MaxWidth="220"
                   Margin="4,0"
                   VerticalAlignment="Center"
                   FontSize="11"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource TextSecondaryBrush}" />
        <Button Focusable="False" x:Name="RecognizeButton"
                Classes="accent"
                Content="识别文字"
                Click="OnRecognizeClick"
                ToolTip.Tip="识别选区文字（Enter / R）" />
        <Button Focusable="False" x:Name="TranslateButton"
                IsVisible="False"
                Content="翻译 ▾"
                ToolTip.Tip="识别并翻译；点一下选目标语言">
          <Button.Flyout>
            <MenuFlyout Placement="TopEdgeAlignedRight" />
          </Button.Flyout>
        </Button>
        <Button Focusable="False" Content="复制图片" Click="OnCopyImageClick" ToolTip.Tip="复制选区图片（C）" />
        <Button Focusable="False" Content="保存" Click="OnSaveClick" ToolTip.Tip="保存为 PNG（S）" />
        <Button Focusable="False" Content="固定" Click="OnPinClick" ToolTip.Tip="固定到屏幕，滚轮缩放（P）" />
        <Button Focusable="False" Content="滚动" Click="OnScrollClick" ToolTip.Tip="进入滚动截图（G）" />
        <Button Focusable="False" x:Name="CopyAllButton"
                IsVisible="False"
                Content="复制全文"
                Click="OnCopyAllClick"
                ToolTip.Tip="复制全部识别文字（Ctrl+C）" />
        <Button Focusable="False" x:Name="OcrBoxButton"
                IsVisible="False"
                Content="框 · 悬停"
                Click="OnOcrBoxModeClick"
                ToolTip.Tip="识别框显示方式：全部 / 悬停 / 关闭（B）" />
        <Button Focusable="False" Classes="ghost" Content="取消" Click="OnCancelClick" ToolTip.Tip="取消截图（Esc）" />
        </StackPanel>
      </StackPanel>
    </Border>

  </Canvas>
</Window>
