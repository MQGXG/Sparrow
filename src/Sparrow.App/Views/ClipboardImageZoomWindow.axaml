<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sparrow.App.Views.ClipboardImageZoomWindow"
        Title="麻雀 · 查看图片"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#F20B0E13"
        WindowStartupLocation="Manual">

  <!-- 整屏灯箱：点任意处或 Esc 关闭，不抢焦点、不留标题栏 -->
  <Panel Cursor="Hand" Tapped="OnCloseTapped">
    <Image x:Name="Preview"
           Stretch="Uniform"
           Margin="32,32,32,52" />

    <Border Background="{StaticResource OverlayBrush}"
            BorderBrush="{StaticResource LineStrongBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="14,6"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,20"
            IsHitTestVisible="False">
      <TextBlock Text="点击任意处 / Esc 关闭"
                 Classes="num" />
    </Border>
  </Panel>
</Window>
