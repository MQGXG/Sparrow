<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sparrow.App.Views.PinnedImageWindow"
        Title="SparrowPin"
        WindowDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterScreen">

  <Grid>
    <Border BorderBrush="{StaticResource AccentBorderBrush}"
            BorderThickness="1"
            Background="{StaticResource BgBrush}"
            Cursor="SizeAll"
            BoxShadow="0 8 24 0 #99000000">
      <Image x:Name="Preview" Stretch="Uniform" />
    </Border>

    <!-- 悬停时才出现；首次打开短暂显示，避免用户不知道怎么关 -->
    <Button x:Name="CloseButton"
            IsVisible="False"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,6,6,0"
            Width="26"
            Height="26"
            Padding="0"
            CornerRadius="13"
            Background="{StaticResource DangerBrush}"
            Foreground="White"
            FontSize="12"
            Content="✕"
            ToolTip.Tip="关闭（Esc）"
            Click="OnCloseClick" />
  </Grid>
</Window>
