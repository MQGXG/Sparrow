<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sparrow.App.Views.PinnedImageWindow"
        Title="SparrowPin"
        WindowDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterScreen"
        RequestedThemeVariant="Dark">

  <Grid>
    <Border BorderBrush="{DynamicResource AccentBorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource BgBrush}"
            Cursor="SizeAll"
            BoxShadow="0 8 24 0 #99000000">
      <Image x:Name="Preview" Stretch="Uniform" />
    </Border>

    <!-- 悬停时才出现；首次打开短暂显示，避免用户不知道怎么关 -->
    <Button x:Name="AnnotateButton"
            Opacity="0.35"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,6,38,0"
            Width="26"
            Height="26"
            Padding="0"
            CornerRadius="13"
            Background="{DynamicResource OverlayBrush}"
            ToolTip.Tip="启用标注模式"
            Click="OnAnnotateClick">
      <Path Data="{StaticResource IconPen}"
            Width="14"
            Height="14"
            Stretch="Uniform"
            Stroke="#FFE5A44C"
            StrokeThickness="1.6"
            StrokeLineCap="Round"
            StrokeJoin="Round" />
    </Button>

    <Button x:Name="CloseButton"
            Opacity="0.35"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,6,6,0"
            Width="26"
            Height="26"
            Padding="0"
            CornerRadius="13"
            Background="{DynamicResource DangerBrush}"
            Foreground="White"
            FontSize="12"
            Content="✕"
            ToolTip.Tip="关闭（Esc）"
            Click="OnCloseClick" />
  </Grid>
</Window>
