<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sparrow.App.ViewModels"
             xmlns:converters="using:Sparrow.App.Converters"
             x:Class="Sparrow.App.Views.ClipboardDetailView"
             x:DataType="vm:ClipboardHistoryViewModel">

  <!--
    详情内容本身：主窗的独立详情窗口和快取面板的覆盖层共用同一份视图，
    容器只负责「开 / 关」，避免两套布局和两套事件。
  -->
  <Panel Background="{StaticResource WindowBgGradientBrush}">

    <!-- 和主窗一致的 HUD 底纹 -->
    <Border Background="{StaticResource DotGridBrush}" IsHitTestVisible="False" />

    <Grid RowDefinitions="Auto,Auto,*,Auto">

      <!-- 头部：返回 + 类型 chip + 完整时间，动作右对齐 -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="18,16,18,12">
        <StackPanel Spacing="5">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Button x:Name="BackButton"
                    Classes="ghost small"
                    Padding="6,3"
                    ToolTip.Tip="返回列表"
                    AutomationProperties.Name="返回列表"
                    Click="OnCloseClick">
              <StackPanel Orientation="Horizontal" Spacing="3">
                <Path Classes="icon icon-xs"
                      Data="{StaticResource IconChevronLeft}" />
                <TextBlock Text="返回" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <TextBlock Classes="section"
                       Text="详情"
                       VerticalAlignment="Center" />
            <Border Classes="chip"
                    Padding="6,1"
                    IsVisible="{Binding HasDetail}">
              <TextBlock Text="{Binding SelectedItem.KindLabel}"
                         FontSize="10"
                         Foreground="{StaticResource AccentBrush}" />
            </Border>
          </StackPanel>
          <TextBlock Text="{Binding SelectedItem.DetailTimeLabel}"
                     Classes="num" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Top"
                    IsVisible="{Binding HasDetail}">
          <Button Classes="ghost small"
                  Padding="8,3"
                  Tag="{Binding SelectedItem}"
                  ToolTip.Tip="收藏 / 取消收藏"
                  AutomationProperties.Name="收藏"
                  Click="OnFavoriteClick">
            <Path Classes="icon icon-xs star"
                  Classes.favorite="{Binding SelectedItem.IsFavorite}"
                  Data="{StaticResource IconStar}" />
          </Button>
          <Button Classes="ghost small danger"
                  Padding="8,3"
                  Content="删除"
                  ToolTip.Tip="删除后返回列表，可在剪贴板页撤销"
                  Click="OnDeleteClick" />
          <Button Classes="accent small"
                  Content="复制"
                  Margin="2,0,0,0"
                  Click="OnCopyClick" />
        </StackPanel>
      </Grid>

      <!-- 元信息：来源 / 大小 -->
      <Border Grid.Row="1"
              Margin="18,0,18,12"
              Padding="10,6"
              CornerRadius="8"
              Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource LineBrush}"
              BorderThickness="1"
              IsVisible="{Binding HasDetail}">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <TextBlock Classes="micro" Text="来源" />
          <TextBlock Grid.Column="1"
                     Classes="num"
                     Margin="8,0,12,0"
                     Text="{Binding SelectedItem.SourceDisplay}"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Classes="micro" Text="大小" />
          <TextBlock Grid.Column="3"
                     Classes="num"
                     Margin="8,0,0,0"
                     Text="{Binding SelectedItem.SizeLabel}" />
        </Grid>
      </Border>

      <!-- 正文：文本 / 大图 / 文件路径统一进同一种内容框 -->
      <ScrollViewer Grid.Row="2"
                    IsVisible="{Binding HasDetail}"
                    Margin="18,0,12,14"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8" Margin="0,0,6,0">
          <Border Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource LineBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="12,10"
                  IsVisible="{Binding HasDetailText}">
            <SelectableTextBlock Text="{Binding DetailText}"
                                 FontFamily="{StaticResource MonoFont}"
                                 FontSize="12"
                                 LineHeight="18"
                                 TextWrapping="Wrap"
                                 Foreground="{StaticResource TextPrimaryBrush}" />
          </Border>

          <Border Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource LineBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="8"
                  IsVisible="{Binding HasDetailImage}">
            <Image Source="{Binding DetailImagePath, Converter={x:Static converters:ByteArrayToBitmapConverter.Instance}, ConverterParameter=detail}"
                   Stretch="Uniform"
                   MaxHeight="520"
                   Cursor="Hand"
                   ToolTip.Tip="点击放大"
                   Tapped="OnDetailImageTapped" />
          </Border>

          <TextBlock Text="点击图片可全屏查看"
                     Classes="micro"
                     HorizontalAlignment="Center"
                     IsVisible="{Binding HasDetailImage}" />

          <Border Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource LineBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="12,10"
                  IsVisible="{Binding HasDetailPaths}">
            <SelectableTextBlock Text="{Binding DetailPaths}"
                                 FontFamily="{StaticResource MonoFont}"
                                 FontSize="12"
                                 LineHeight="18"
                                 TextWrapping="Wrap"
                                 Foreground="{StaticResource TextPrimaryBrush}" />
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- 未选中：说明这块是干什么的 -->
      <StackPanel Grid.Row="2"
                  IsVisible="{Binding !HasDetail}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="10">
        <Border Width="56"
                Height="56"
                CornerRadius="12"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1"
                HorizontalAlignment="Center">
          <Path Classes="icon icon-xl"
                Stroke="{StaticResource LineStrongBrush}"
                Data="{StaticResource IconClipboard}" />
        </Border>
        <TextBlock Text="没有可显示的记录"
                   HorizontalAlignment="Center"
                   FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}" />
        <TextBlock Text="回到列表再选一条查看"
                   HorizontalAlignment="Center"
                   FontSize="10"
                   Foreground="{StaticResource TextMutedBrush}" />
      </StackPanel>

      <!-- 标签：常驻底栏 -->
      <Border Grid.Row="3"
              IsVisible="{Binding HasDetail}"
              BorderBrush="{StaticResource LineBrush}"
              BorderThickness="0,1,0,0"
              Padding="18,12,18,16">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="section"
                       Text="标签"
                       VerticalAlignment="Center" />
            <TextBlock Text="还没有标签"
                       FontSize="10"
                       Foreground="{StaticResource TextMutedBrush}"
                       VerticalAlignment="Center"
                       IsVisible="{Binding !SelectedItem.HasManualTags}" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding SelectedItem.Tags}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="hud-chip"
                        Margin="0,0,6,6"
                        Content="{Binding}"
                        Tag="{Binding}"
                        ToolTip.Tip="点击移除标签"
                        Click="OnTagRemoveClick" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Grid ColumnDefinitions="*,Auto">
            <TextBox Text="{Binding NewTag, Mode=TwoWay}"
                     PlaceholderText="添加标签，回车确认"
                     FontSize="12"
                     Padding="8,5"
                     KeyDown="OnTagBoxKeyDown" />
            <Button Grid.Column="1"
                    Classes="ghost small"
                    Content="添加"
                    Margin="6,0,0,0"
                    Click="OnTagAddClick" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Panel>
</UserControl>
