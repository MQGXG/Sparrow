<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sparrow.App.ViewModels"
             xmlns:svc="using:Sparrow.App.Services"
             x:Class="Sparrow.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <Grid RowDefinitions="Auto,*">

    <!-- 分段导航：插件 / 模型 / 热键 / 通用 / 关于（HUD tab：文字 + 琥珀刻度线） -->
    <ScrollViewer Grid.Row="0"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled">
      <StackPanel Orientation="Horizontal" Spacing="24" Margin="24,10,24,12">
        <Button Classes="hud-tab"
                Classes.selected="{Binding IsPluginsSelected}"
                Tag="Plugins"
                ToolTip.Tip="插件开关、目录与重新扫描"
                Click="OnSectionClick">
          <StackPanel>
            <TextBlock Text="插件" />
            <Border Classes="tick" />
          </StackPanel>
        </Button>
        <Button Classes="hud-tab"
                Classes.selected="{Binding IsModelSelected}"
                Tag="Model"
                ToolTip.Tip="AI 提供方、密钥与连接测试"
                Click="OnSectionClick">
          <StackPanel>
            <TextBlock Text="模型" />
            <Border Classes="tick" />
          </StackPanel>
        </Button>
        <Button Classes="hud-tab"
                Classes.selected="{Binding IsHotkeysSelected}"
                Tag="Hotkeys"
                ToolTip.Tip="全局快捷键"
                Click="OnSectionClick">
          <StackPanel>
            <TextBlock Text="热键" />
            <Border Classes="tick" />
          </StackPanel>
        </Button>
        <Button Classes="hud-tab"
                Classes.selected="{Binding IsGeneralSelected}"
                Tag="General"
                ToolTip.Tip="开机自启与历史保留"
                Click="OnSectionClick">
          <StackPanel>
            <TextBlock Text="通用" />
            <Border Classes="tick" />
          </StackPanel>
        </Button>
        <Button Classes="hud-tab"
                Classes.selected="{Binding IsAboutSelected}"
                Tag="About"
                ToolTip.Tip="版本、日志与数据目录"
                Click="OnSectionClick">
          <StackPanel>
            <TextBlock Text="关于" />
            <Border Classes="tick" />
          </StackPanel>
        </Button>
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="24,4,24,24" Spacing="14">

        <!-- ============ 插件 ============ -->
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,10" IsVisible="{Binding IsPluginsSelected}">
          <Border Classes="hud-tick" />
          <TextBlock Grid.Column="1"
                     Text="插件"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Margin="10,0,0,0"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="2"
                     Classes="num"
                     Text="{Binding Plugins.Count, StringFormat='{}{0} 个'}" />
        </Grid>

        <Border Classes="panel" Padding="8" IsVisible="{Binding IsPluginsSelected}">
          <StackPanel Spacing="6">
            <ItemsControl ItemsSource="{Binding Plugins}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PluginItemViewModel">
                  <Border Background="{StaticResource SurfaceRaisedBrush}"
                          CornerRadius="2"
                          Padding="14,12">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                      <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Id}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" />
                      </StackPanel>

                      <TextBlock Grid.Column="1"
                                 Classes="num"
                                 Text="{Binding Version}"
                                 Margin="16,0"
                                 VerticalAlignment="Center" />

                      <StackPanel Grid.Column="2"
                                  Orientation="Horizontal"
                                  Spacing="5"
                                  Margin="16,0"
                                  VerticalAlignment="Center">
                        <TextBlock Text="{Binding ToolCount}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="个工具"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" />
                      </StackPanel>

                      <ToggleSwitch Grid.Column="3"
                                    IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                    OnContent="开"
                                    OffContent="关"
                                    VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,8,6,2">
              <Button Classes="ghost" Content="打开插件目录" Click="OnOpenPluginsClick" />
              <Button Content="重新扫描" Click="OnRescanClick" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ============ 离线模型 ============ -->
        <Border x:Name="LocalModelsPanel"
                Classes="panel"
                Padding="0"
                IsVisible="{Binding IsModelSelected}">
          <StackPanel>
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,14">
              <Border Classes="hud-icon">
                <Path Data="{StaticResource IconStorage}" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="离线模型"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="下载后无需 API Key、不需要联网；只在工具使用时加载"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock Grid.Column="2"
                         Classes="num"
                         Text="// LOCAL"
                         VerticalAlignment="Center" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto"
                  Margin="20,12,20,0"
                  ColumnSpacing="8"
                  IsVisible="{Binding HasLocalModels}">
              <TextBox Text="{Binding LocalModelMirror, Mode=TwoWay}"
                       PlaceholderText="自托管镜像根地址（可选），如 https://models.example.com/sparrow" />
              <Button Grid.Column="1"
                      Classes="ghost small"
                      Content="保存"
                      ToolTip.Tip="只换下载前缀，文件名保持不变"
                      Click="OnSaveModelMirrorClick" />
            </Grid>

            <ItemsControl x:Name="LocalModelsList"
                          ItemsSource="{Binding LocalModels}"
                          Margin="20,12,20,0"
                          IsVisible="{Binding HasLocalModels}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LocalModelItemViewModel">
                  <Border Background="{StaticResource SurfaceRaisedBrush}"
                          CornerRadius="2"
                          Padding="14,12"
                          Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}"
                                     FontSize="13"
                                     FontWeight="SemiBold"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     VerticalAlignment="Center" />
                          <Border Background="{StaticResource AccentSoftBrush}"
                                  BorderBrush="{StaticResource AccentBorderBrush}"
                                  BorderThickness="1"
                                  CornerRadius="2"
                                  Padding="6,1"
                                  IsVisible="{Binding IsInstalled}"
                                  VerticalAlignment="Center">
                            <TextBlock Text="已下载"
                                       FontSize="10"
                                       Foreground="{StaticResource AccentBrush}" />
                          </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding Description}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding SizeText}"
                                     FontSize="11"
                                     Foreground="{StaticResource TextMutedBrush}" />
                          <TextBlock Text="·"
                                     FontSize="11"
                                     Foreground="{StaticResource TextMutedBrush}" />
                          <TextBlock Text="{Binding MemoryText}"
                                     FontSize="11"
                                     Foreground="{StaticResource TextMutedBrush}" />
                          <TextBlock Text="·"
                                     FontSize="11"
                                     Foreground="{StaticResource TextMutedBrush}" />
                          <TextBlock Text="{Binding StateText}"
                                     FontSize="11"
                                     Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>

                        <TextBlock Text="{Binding License}"
                                   FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap" />
                      </StackPanel>

                      <StackPanel Grid.Column="1"
                                  Spacing="4"
                                  Margin="12,0,0,0"
                                  VerticalAlignment="Center">
                        <Button Classes="accent small"
                                Content="下载"
                                IsVisible="{Binding ShowDownload}"
                                IsEnabled="{Binding IsIdle}"
                                Click="OnDownloadLocalModelClick" />
                        <Button Classes="ghost small"
                                Content="删除"
                                IsVisible="{Binding ShowDelete}"
                                IsEnabled="{Binding IsIdle}"
                                Click="OnDeleteLocalModelClick" />
                        <ProgressBar Value="{Binding ProgressPercent}"
                                     Maximum="100"
                                     Height="3"
                                     Width="72"
                                     IsVisible="{Binding IsBusy}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Margin="20,0,20,14"
                       FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasLocalModels}"
                       Text="模型存放在 %LocalAppData%\Sparrow\models，删除会释放磁盘空间。" />
          </StackPanel>
        </Border>

        <!-- ============ 热键 ============ -->
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,10" IsVisible="{Binding IsHotkeysSelected}">
          <Border Classes="hud-tick" />
          <TextBlock Grid.Column="1"
                     Text="热键"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Margin="10,0,0,0"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="2"
                     Classes="num"
                     Text="// HOTKEYS" />
        </Grid>

        <Border Classes="panel" Padding="0" IsVisible="{Binding IsHotkeysSelected}">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto" Margin="20,14">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="搜索面板"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="唤出命令面板"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" />
              </StackPanel>
              <TextBox x:Name="SearchHotkeyBox"
                       Grid.Column="1"
                       Width="260"
                       IsReadOnly="True"
                       Tag="hotkey"
                       ToolTip.Tip="点击后直接按组合键；Backspace 清空"
                       PlaceholderText="点击后按组合键"
                       Text="{Binding SearchHotkey, Mode=TwoWay}" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,14">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="截图识别"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="选区截图与文字识别"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" />
              </StackPanel>
              <TextBox Grid.Column="1"
                       Width="260"
                       IsReadOnly="True"
                       Tag="hotkey"
                       ToolTip.Tip="点击后直接按组合键；Backspace 清空"
                       PlaceholderText="点击后按组合键"
                       Text="{Binding CaptureHotkey, Mode=TwoWay}" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Border Classes="hud-line" Margin="20,0" />

            <!-- 截图窗口内快捷键：单键或 Ctrl+组合；留空禁用 -->
            <StackPanel Margin="20,14,20,2" Spacing="3">
              <TextBlock Text="截图窗口内快捷键"
                         FontSize="13"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource TextPrimaryBrush}" />
              <TextBlock Text="单键或 Ctrl+组合；留空表示禁用该快捷键"
                         FontSize="11"
                         Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto" Margin="20,10">
              <TextBlock Text="识别文字" VerticalAlignment="Center"
                         Foreground="{StaticResource TextPrimaryBrush}" />
              <TextBox Grid.Column="1" Width="260" IsReadOnly="True" Tag="hotkey"
                       ToolTip.Tip="点击后直接按组合键；Backspace 清空"
                       PlaceholderText="留空禁用"
                       Text="{Binding CaptureRecognizeKey, Mode=TwoWay}" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,10">
              <TextBlock Text="翻译（识别并出译文）" VerticalAlignment="Center"
                         Foreground="{StaticResource TextPrimaryBrush}" />
              <TextBox Grid.Column="1" Width="260" IsReadOnly="True" Tag="hotkey"
                       ToolTip.Tip="点击后直接按组合键；Backspace 清空"
                       PlaceholderText="留空禁用"
                       Text="{Binding CaptureTranslateKey, Mode=TwoWay}" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,10">
              <TextBlock Text="复制图片" VerticalAlignment="Center"
                         Foreground="{StaticResource TextPrimaryBrush}" />
              <TextBox Grid.Column="1" Width="260" IsReadOnly="True" Tag="hotkey"
                       ToolTip.Tip="点击后直接按组合键；Backspace 清空"
                       PlaceholderText="留空禁用"
                       Text="{Binding CaptureCopyKey, Mode=TwoWay}" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,10">
              <TextBlock Text="保存" VerticalAlignment="Center"
                         Foreground="{StaticResource TextPrimaryBrush}" />
              <TextBox Grid.Column="1" Width="260" IsReadOnly="True" Tag="hotkey"
                       ToolTip.Tip="点击后直接按组合键；Backspace 清空"
                       PlaceholderText="留空禁用"
                       Text="{Binding CaptureSaveKey, Mode=TwoWay}" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,10">
              <TextBlock Text="固定到屏幕" VerticalAlignment="Center"
                         Foreground="{StaticResource TextPrimaryBrush}" />
              <TextBox Grid.Column="1" Width="260" IsReadOnly="True" Tag="hotkey"
                       ToolTip.Tip="点击后直接按组合键；Backspace 清空"
                       PlaceholderText="留空禁用"
                       Text="{Binding CapturePinKey, Mode=TwoWay}" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,10">
              <TextBlock Text="滚动截图" VerticalAlignment="Center"
                         Foreground="{StaticResource TextPrimaryBrush}" />
              <TextBox Grid.Column="1" Width="260" IsReadOnly="True" Tag="hotkey"
                       ToolTip.Tip="点击后直接按组合键；Backspace 清空"
                       PlaceholderText="留空禁用"
                       Text="{Binding CaptureScrollKey, Mode=TwoWay}" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,10">
              <TextBlock Text="取色" VerticalAlignment="Center"
                         Foreground="{StaticResource TextPrimaryBrush}" />
              <TextBox Grid.Column="1" Width="260" IsReadOnly="True" Tag="hotkey"
                       ToolTip.Tip="点击后直接按组合键；Backspace 清空"
                       PlaceholderText="留空禁用"
                       Text="{Binding CaptureColorKey, Mode=TwoWay}" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,10">
              <TextBlock Text="识别框显示方式" VerticalAlignment="Center"
                         Foreground="{StaticResource TextPrimaryBrush}" />
              <TextBox Grid.Column="1" Width="260" IsReadOnly="True" Tag="hotkey"
                       ToolTip.Tip="点击后直接按组合键；Backspace 清空"
                       PlaceholderText="留空禁用"
                       Text="{Binding CaptureOcrBoxKey, Mode=TwoWay}" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,14">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="窗口元素 API"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="识别光标下的控件（图标 / 按钮 / 列表项）；自动 = UIA 优先，MSAA 兜底"
                           FontSize="11"
                           MaxWidth="520"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}" />
              </StackPanel>
              <ComboBox Grid.Column="1"
                        Width="260"
                        ItemsSource="{Binding CaptureElementApiOptions}"
                        SelectedItem="{Binding SelectedCaptureElementApi, Mode=TwoWay}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SettingsChoiceOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,14">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="截图捕获 API"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="取帧方式；自动 = 平时 GDI、HDR 显示器用 WGC。WGC 跨屏时逐屏抓取再拼接"
                           FontSize="11"
                           MaxWidth="520"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}" />
              </StackPanel>
              <ComboBox Grid.Column="1"
                        Width="260"
                        ItemsSource="{Binding CaptureApiOptions}"
                        SelectedItem="{Binding SelectedCaptureApi, Mode=TwoWay}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SettingsChoiceOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,14">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="显示光标"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="在新的普通截图中画上鼠标光标；滚动截图始终不画，避免每帧重复"
                           FontSize="11"
                           MaxWidth="520"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1"
                            OnContent="开"
                            OffContent="关"
                            IsChecked="{Binding CaptureShowCursor, Mode=TwoWay}"
                            VerticalAlignment="Center" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,14">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="滚动截图时捕获界面"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="在拼接结果中包含滚动截图窗口及其工具栏；关闭后这些窗口会从取帧中排除"
                           FontSize="11"
                           MaxWidth="520"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1"
                            OnContent="开"
                            OffContent="关"
                            IsChecked="{Binding CaptureUiInScroll, Mode=TwoWay}"
                            VerticalAlignment="Center" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,14">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="还原屏幕原始颜色"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="还原 Windows 放大镜的全屏颜色滤镜（反色 / 灰度等）；WGC 取帧本来就是原始颜色"
                           FontSize="11"
                           MaxWidth="520"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1"
                            OnContent="开"
                            OffContent="关"
                            IsChecked="{Binding CaptureRestoreColors, Mode=TwoWay}"
                            VerticalAlignment="Center" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,14">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="剪贴板面板"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="只呼出搜索与列表，双击 / 回车直接复制"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" />
              </StackPanel>
              <TextBox x:Name="ClipboardPanelHotkeyBox"
                       Grid.Column="1"
                       Width="260"
                       IsReadOnly="True"
                       Tag="hotkey"
                       ToolTip.Tip="点击后直接按组合键；Backspace 清空"
                       PlaceholderText="点击后按组合键"
                       Text="{Binding ClipboardPanelHotkey, Mode=TwoWay}" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <!-- 工具热键：任意工具挂全局热键；留空 = 不绑定 -->
            <StackPanel IsVisible="{Binding HasToolHotkeys}">
              <Grid ColumnDefinitions="Auto,*" Margin="20,14,20,4">
                <Border Classes="hud-tick" />
                <StackPanel Grid.Column="1" Spacing="2" Margin="10,0,0,0">
                  <TextBlock Text="工具热键"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimaryBrush}" />
                  <TextBlock Text="留空 = 不绑定；按下直接执行，不打开面板"
                             FontSize="11"
                             Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
              </Grid>

              <ItemsControl ItemsSource="{Binding ToolHotkeys}" Margin="20,0,20,8">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ToolHotkeyRowViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,5">
                      <TextBlock Text="{Binding Name}"
                                 FontSize="12"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 VerticalAlignment="Center" />
                      <TextBox Grid.Column="1"
                               Width="260"
                               IsReadOnly="True"
                               Tag="hotkey"
                               ToolTip.Tip="点击后直接按组合键；Backspace 清空"
                               Text="{Binding HotkeyText, Mode=TwoWay}"
                               PlaceholderText="点击后按组合键" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid Margin="20,14">
              <TextBlock Text="点输入框后直接按组合键；Backspace 清空；保存后重启应用生效。"
                         FontSize="11"
                         Foreground="{StaticResource TextMutedBrush}"
                         VerticalAlignment="Center" />
              <Button Classes="accent small"
                      Content="保存热键"
                      Click="OnSaveHotkeysClick"
                      HorizontalAlignment="Right" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- ============ 通用 ============ -->
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,10" IsVisible="{Binding IsGeneralSelected}">
          <Border Classes="hud-tick" />
          <TextBlock Grid.Column="1"
                     Text="通用"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Margin="10,0,0,0"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="2"
                     Classes="num"
                     Text="// GENERAL" />
        </Grid>

        <Border Classes="panel" Padding="0" IsVisible="{Binding IsGeneralSelected}">
          <StackPanel>
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,14">
              <Border Classes="hud-icon">
                <Path Data="{StaticResource IconPower}" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="开机自启"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="只在启动时进托盘，不弹窗口"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="2"
                            OnContent="开"
                            OffContent="关"
                            IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                            VerticalAlignment="Center" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,14">
              <Border Classes="hud-icon">
                <Path Data="{StaticResource IconClipboard}" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="剪贴板历史"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="本机本地存储；关闭后已记录的内容保留"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="2"
                            OnContent="开"
                            OffContent="关"
                            IsChecked="{Binding ClipboardHistoryEnabled, Mode=TwoWay}"
                            VerticalAlignment="Center" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,14">
              <Border Classes="hud-icon">
                <Path Data="{StaticResource IconCalendar}" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="剪贴板保留（天）"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="0 表示永久保留；收藏条目不参与清理"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" />
              </StackPanel>
              <NumericUpDown Grid.Column="2"
                             Value="{Binding ClipboardRetentionDays, Mode=TwoWay}"
                             Minimum="0"
                             Maximum="3650"
                             Increment="30"
                             FormatString="0"
                             Width="140"
                             VerticalAlignment="Center" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,14">
              <Border Classes="hud-icon">
                <Path Data="{StaticResource IconStorage}" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="剪贴板总容量（MB）"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="超出后从最旧的开始删，收藏不参与；0 表示不限制"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" />
              </StackPanel>
              <NumericUpDown Grid.Column="2"
                             Value="{Binding ClipboardMaxMb, Mode=TwoWay}"
                             Minimum="0"
                             Maximum="10240"
                             Increment="64"
                             FormatString="0"
                             Width="140"
                             VerticalAlignment="Center" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,14">
              <Border Classes="hud-icon">
                <Path Data="{StaticResource IconClock}" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="历史最多保留（条）"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="超过后只保留最近的部分，改完立即清理一次"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" />
              </StackPanel>
              <NumericUpDown Grid.Column="2"
                             Value="{Binding HistoryMaxEntries, Mode=TwoWay}"
                             Minimum="50"
                             Maximum="5000"
                             Increment="50"
                             FormatString="0"
                             Width="140"
                             VerticalAlignment="Center" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,14">
              <Border Classes="hud-icon">
                <Path Data="{StaticResource IconCalendar}" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="历史保留（天）"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="0 表示不按天数清理"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" />
              </StackPanel>
              <NumericUpDown Grid.Column="2"
                             Value="{Binding HistoryRetentionDays, Mode=TwoWay}"
                             Minimum="0"
                             Maximum="3650"
                             Increment="30"
                             FormatString="0"
                             Width="140"
                             VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- ============ 模型 ============ -->
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,10" IsVisible="{Binding IsModelSelected}">
          <Border Classes="hud-tick" />
          <TextBlock Grid.Column="1"
                     Text="模型"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Margin="10,0,0,0"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="2"
                     Classes="num"
                     Text="// MODEL" />
        </Grid>

        <Border Classes="panel" Padding="0" IsVisible="{Binding IsModelSelected}">
          <StackPanel>
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,14">
              <Border Classes="hud-icon">
                <Path Data="{StaticResource IconSparkle}" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="启用模型"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="AI 类工具可用；插件只拿到统一接口"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="2"
                            OnContent="开"
                            OffContent="关"
                            IsChecked="{Binding AiEnabled, Mode=TwoWay}"
                            VerticalAlignment="Center" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <StackPanel Margin="20,14" Spacing="12">
              <Grid ColumnDefinitions="92,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                <TextBlock Text="提供方"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AiProviderOptions}"
                          SelectedItem="{Binding SelectedAiProvider, Mode=TwoWay}"
                          HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="svc:AiProviderPreset">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="1"
                           Text="Base URL"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Text="{Binding AiBaseUrl, Mode=TwoWay}"
                         PlaceholderText="https://api.openai.com/v1" />

                <TextBlock Grid.Row="2"
                           Text="模型名"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         Text="{Binding AiModel, Mode=TwoWay}"
                         PlaceholderText="gpt-4o-mini" />

                <TextBlock Grid.Row="3"
                           Text="API Key"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBox Grid.Row="3"
                         Grid.Column="1"
                         Text="{Binding AiKey, Mode=TwoWay}"
                         PasswordChar="●"
                         PlaceholderText="留空表示不修改已保存的密钥" />
              </Grid>
              <TextBlock Text="API Key 由宿主用 Windows DPAPI 加密保存，不会进入插件或日志。"
                         FontSize="11"
                         Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid Margin="20,14" ColumnDefinitions="*,Auto,Auto">
              <TextBlock Text="{Binding AiStatus}"
                         FontSize="11"
                         Foreground="{StaticResource AccentBrush}"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      Classes="ghost small"
                      Content="清除密钥"
                      Margin="0,0,8,0"
                      Click="OnClearAiKeyClick" />
              <Button Grid.Column="2"
                      Classes="accent small"
                      Content="保存并测试"
                      Click="OnSaveAiClick" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- ============ 关于：身份卡 ============ -->
        <Border Classes="panel" Padding="0" IsVisible="{Binding IsAboutSelected}">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="20,18,20,16">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <Border Width="46"
                        Height="46"
                        CornerRadius="2"
                        Background="{StaticResource AccentSoftBrush}"
                        VerticalAlignment="Center">
                  <Image Source="avares://Sparrow.App/Assets/sparrow-32.png"
                         Width="30"
                         Height="30" />
                </Border>
                <StackPanel Spacing="3" VerticalAlignment="Center">
                  <TextBlock Classes="num" Text="SPARROW // 本地工具集合" />
                  <TextBlock Classes="title" Text="麻雀 · 工具台" />
                  <TextBlock Classes="num"
                             Text="{Binding VersionText, StringFormat='{}本地优先 // v{0}'}" />
                </StackPanel>
              </StackPanel>

              <StackPanel Grid.Column="1" Margin="32,0,0,0" Spacing="5">
                <TextBlock Classes="section" Text="版本" />
                <TextBlock Classes="stat" Text="{Binding VersionText}" />
              </StackPanel>

              <StackPanel Grid.Column="2" Margin="32,0,0,0" Spacing="5">
                <TextBlock Classes="section" Text="平台" />
                <TextBlock FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="Windows x64"
                           VerticalAlignment="Center" />
              </StackPanel>

              <StackPanel Grid.Column="3" Margin="32,0,0,0" Spacing="5">
                <TextBlock Classes="section" Text="状态" />
                <TextBlock FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"
                           Text="本地就绪"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Grid>

            <Border Classes="hud-line" />

            <!-- 更新：Velopack 安装版才可用 -->
            <Grid ColumnDefinitions="*,Auto" Margin="20,14" RowDefinitions="Auto,Auto" RowSpacing="8">
              <StackPanel Spacing="3">
                <TextBlock Text="更新"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding UpdateStatus, FallbackValue='未检查'}"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           MaxWidth="420" />
              </StackPanel>

              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="8"
                          VerticalAlignment="Center">
                <TextBox Text="{Binding UpdateFeedUrl, Mode=TwoWay}"
                         Width="260"
                         PlaceholderText="更新源地址，如 https://example.com/updates" />
                <Button Classes="accent"
                        Content="检查更新"
                        IsEnabled="{Binding IsNotCheckingUpdate}"
                        Click="OnCheckUpdateClick" />
              </StackPanel>
            </Grid>

            <Border Classes="hud-line" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,14">
              <TextBlock Text="所有工具在本地执行，数据不出机器。Bug、建议和使用问题见应用目录下的日志。"
                         FontSize="11"
                         Foreground="{StaticResource TextMutedBrush}"
                         TextWrapping="Wrap"
                         MaxWidth="420"
                         VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Classes="ghost" Content="打开日志目录" Click="OnOpenLogsClick" />
                <Button Content="打开数据目录" Click="OnOpenDataClick" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
