<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sparrow.App.ViewModels"
             xmlns:svc="using:Sparrow.App.Services"
             x:Class="Sparrow.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <UserControl.Styles>
    <Style Selector="Button.settings-tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="Button.settings-tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
    </Style>

    <Style Selector="Button.settings-tab.selected">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.settings-tab.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <!-- 分段导航：插件 / 模型 / 热键 / 通用 / 关于 -->
    <ScrollViewer Grid.Row="0"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled">
      <StackPanel Orientation="Horizontal" Spacing="4" Margin="24,8,24,12">
        <Button Classes="settings-tab"
                Classes.selected="{Binding IsPluginsSelected}"
                Tag="Plugins"
                Content="插件"
                Click="OnSectionClick" />
        <Button Classes="settings-tab"
                Classes.selected="{Binding IsModelSelected}"
                Tag="Model"
                Content="模型"
                Click="OnSectionClick" />
        <Button Classes="settings-tab"
                Classes.selected="{Binding IsHotkeysSelected}"
                Tag="Hotkeys"
                Content="热键"
                Click="OnSectionClick" />
        <Button Classes="settings-tab"
                Classes.selected="{Binding IsGeneralSelected}"
                Tag="General"
                Content="通用"
                Click="OnSectionClick" />
        <Button Classes="settings-tab"
                Classes.selected="{Binding IsAboutSelected}"
                Tag="About"
                Content="关于"
                Click="OnSectionClick" />
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="24,0,24,24" Spacing="12">

        <!-- 插件 -->
        <Border Classes="panel" Padding="16" IsVisible="{Binding IsPluginsSelected}">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4">
            <TextBlock Classes="subtitle"
                       Text="插件" />
            <TextBlock Text="工具都是插件。切换后需要重启应用生效。"
                       FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Plugins}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PluginItemViewModel">
                <Border Padding="12,10"
                        Margin="0,0,0,6"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        CornerRadius="10"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Name}"
                                 FontSize="13"
                                 Foreground="{StaticResource TextPrimaryBrush}" />
                      <TextBlock Text="{Binding Id}"
                                 FontFamily="{StaticResource MonoFont}"
                                 FontSize="10"
                                 Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding Version}"
                               Margin="16,0"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" />

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="3"
                                Margin="16,0"
                                VerticalAlignment="Center">
                      <TextBlock Text="{Binding ToolCount}"
                                 FontSize="11"
                                 Foreground="{StaticResource TextSecondaryBrush}" />
                      <TextBlock Text="个工具"
                                 FontSize="11"
                                 Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>

                    <ToggleSwitch Grid.Column="3"
                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                  OnContent="开"
                                  OffContent="关"
                                  VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="ghost" Content="打开插件目录" Click="OnOpenPluginsClick" />
            <Button Content="重新扫描" Click="OnRescanClick" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 热键 -->
      <Border Classes="panel" Padding="16" IsVisible="{Binding IsHotkeysSelected}">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4">
            <TextBlock Classes="subtitle"
                       Text="热键" />
            <TextBlock Text="格式示例：Ctrl+Alt+S、Ctrl+Shift+D、F9。保存后重启应用生效。"
                       FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}" />
          </StackPanel>

          <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto" RowSpacing="10">
            <TextBlock Text="搜索面板"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBox Grid.Column="1" Text="{Binding SearchHotkey, Mode=TwoWay}" />

            <TextBlock Grid.Row="1"
                       Text="截图识别"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CaptureHotkey, Mode=TwoWay}" />
          </Grid>

          <Button Content="保存热键"
                  Classes="accent small"
                  Click="OnSaveHotkeysClick"
                  HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <!-- 通用 -->
      <Border Classes="panel" Padding="16" IsVisible="{Binding IsGeneralSelected}">
        <StackPanel Spacing="12">
          <TextBlock Classes="subtitle"
                     Text="通用" />

          <ToggleSwitch Content="开机自启（只启动到托盘）"
                        OnContent="开"
                        OffContent="关"
                        IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />

          <Grid ColumnDefinitions="*,140"
                RowDefinitions="Auto,Auto"
                RowSpacing="10"
                ColumnSpacing="12">
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="历史最多保留（条）"
                         FontSize="12"
                         Foreground="{StaticResource TextSecondaryBrush}" />
              <TextBlock Text="超过后只保留最近的部分"
                         FontSize="11"
                         Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
            <NumericUpDown Grid.Column="1"
                           Value="{Binding HistoryMaxEntries, Mode=TwoWay}"
                           Minimum="50"
                           Maximum="5000"
                           Increment="50"
                           FormatString="0"
                           VerticalAlignment="Center" />

            <StackPanel Grid.Row="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="历史保留（天）"
                         FontSize="12"
                         Foreground="{StaticResource TextSecondaryBrush}" />
              <TextBlock Text="0 表示不按天数清理"
                         FontSize="11"
                         Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
            <NumericUpDown Grid.Row="1"
                           Grid.Column="1"
                           Value="{Binding HistoryRetentionDays, Mode=TwoWay}"
                           Minimum="0"
                           Maximum="3650"
                           Increment="30"
                           FormatString="0"
                           VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- 模型 -->
      <Border Classes="panel" Padding="16" IsVisible="{Binding IsModelSelected}">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4">
            <TextBlock Classes="subtitle"
                       Text="模型" />
            <TextBlock Text="插件只拿到统一接口；API Key 由宿主用 Windows DPAPI 加密保存，不会进入插件或日志。"
                       FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>

          <ToggleSwitch Content="启用模型（AI 工具可用）"
                        OnContent="开"
                        OffContent="关"
                        IsChecked="{Binding AiEnabled, Mode=TwoWay}" />

          <Grid ColumnDefinitions="92,*"
                RowDefinitions="Auto,Auto,Auto,Auto"
                RowSpacing="10"
                ColumnSpacing="12">
            <TextBlock Text="提供方"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding AiProviderOptions}"
                      SelectedItem="{Binding SelectedAiProvider, Mode=TwoWay}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="svc:AiProviderPreset">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Row="1"
                       Text="Base URL"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Text="{Binding AiBaseUrl, Mode=TwoWay}"
                     PlaceholderText="https://api.openai.com/v1" />

            <TextBlock Grid.Row="2"
                       Text="模型名"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBox Grid.Row="2"
                     Grid.Column="1"
                     Text="{Binding AiModel, Mode=TwoWay}"
                     PlaceholderText="gpt-4o-mini" />

            <TextBlock Grid.Row="3"
                       Text="API Key"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBox Grid.Row="3"
                     Grid.Column="1"
                     Text="{Binding AiKey, Mode=TwoWay}"
                     PasswordChar="●"
                     PlaceholderText="留空表示不修改已保存的密钥" />
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="accent small"
                    Content="保存并测试"
                    Click="OnSaveAiClick" />
            <Button Classes="ghost small"
                    Content="清除密钥"
                    Click="OnClearAiKeyClick" />
          </StackPanel>

          <TextBlock Text="{Binding AiStatus}"
                     FontSize="11"
                     Foreground="{StaticResource AccentBrush}"
                     TextWrapping="Wrap" />

          <TextBlock Text="本地示例：Ollama http://localhost:11434/v1；LM Studio http://localhost:1234/v1。云端需填写 API Key。"
                     FontSize="11"
                     Foreground="{StaticResource TextMutedBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- 关于 -->
      <Border Classes="panel" Padding="16" IsVisible="{Binding IsAboutSelected}">
        <StackPanel Spacing="12">
          <TextBlock Classes="subtitle"
                     Text="关于" />

          <TextBlock Text="{Binding VersionText}"
                     FontSize="11"
                     Foreground="{StaticResource TextSecondaryBrush}" />

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="打开日志目录" Click="OnOpenLogsClick" />
            <Button Content="打开数据目录" Click="OnOpenDataClick" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding StatusMessage}"
                 Foreground="{StaticResource AccentBrush}"
                 FontSize="12"
                 TextWrapping="Wrap"
                 Margin="2,0" />

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
