<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sparrow.App.ViewModels"
             x:Class="Sparrow.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer>
    <StackPanel Margin="24" Spacing="24">

      <!-- 插件 -->
      <StackPanel Spacing="8">
        <TextBlock Text="插件" FontSize="20" Foreground="#E6EDF3" />
        <TextBlock Text="工具都是插件。切换后需要重启应用生效。"
                   FontSize="12"
                   Foreground="#8B98A8" />

        <ItemsControl ItemsSource="{Binding Plugins}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PluginItemViewModel">
              <Border Padding="14"
                      Margin="0,0,0,8"
                      Background="#161B22"
                      CornerRadius="8"
                      BorderBrush="#232B36"
                      BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}" FontSize="14" Foreground="#E6EDF3" />
                    <TextBlock Text="{Binding Id}" FontSize="11" Foreground="#6E7B8B" />
                  </StackPanel>

                  <TextBlock Grid.Column="1"
                             Text="{Binding Version}"
                             Margin="16,0"
                             VerticalAlignment="Center"
                             Foreground="#8B98A8" />

                  <TextBlock Grid.Column="2"
                             Text="{Binding ToolCount}"
                             Margin="16,0"
                             VerticalAlignment="Center"
                             Foreground="#8B98A8" />

                  <ToggleSwitch Grid.Column="3"
                                IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="打开插件目录" Click="OnOpenPluginsClick" />
          <Button Content="重新扫描" Click="OnRescanClick" />
        </StackPanel>
      </StackPanel>

      <!-- 热键 -->
      <StackPanel Spacing="8">
        <TextBlock Text="热键" FontSize="20" Foreground="#E6EDF3" />
        <TextBlock Text="格式示例：Ctrl+Alt+S、Ctrl+Shift+D、F9。保存后重启应用生效。"
                   FontSize="12"
                   Foreground="#8B98A8" />

        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" RowSpacing="8">
          <TextBlock Text="搜索面板" VerticalAlignment="Center" Foreground="#E6EDF3" />
          <TextBox Grid.Column="1" Text="{Binding SearchHotkey, Mode=TwoWay}" />

          <TextBlock Grid.Row="1" Text="截图识别" VerticalAlignment="Center" Foreground="#E6EDF3" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CaptureHotkey, Mode=TwoWay}" />
        </Grid>

        <Button Content="保存热键" Click="OnSaveHotkeysClick" HorizontalAlignment="Left" />
      </StackPanel>

      <!-- 通用 -->
      <StackPanel Spacing="8">
        <TextBlock Text="通用" FontSize="20" Foreground="#E6EDF3" />
        <ToggleSwitch Content="开机自启（只启动到托盘）"
                      IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
      </StackPanel>

      <!-- 关于 -->
      <StackPanel Spacing="8">
        <TextBlock Text="关于" FontSize="20" Foreground="#E6EDF3" />
        <TextBlock Text="{Binding VersionText}"
                   FontSize="12"
                   Foreground="#8B98A8" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="打开日志目录" Click="OnOpenLogsClick" />
          <Button Content="打开数据目录" Click="OnOpenDataClick" />
        </StackPanel>
      </StackPanel>

      <TextBlock Text="{Binding StatusMessage}"
                 Foreground="#D97706"
                 FontSize="12"
                 TextWrapping="Wrap" />

    </StackPanel>
  </ScrollViewer>
</UserControl>
