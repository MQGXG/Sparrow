<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sparrow.App.ViewModels"
             x:Class="Sparrow.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer>
    <StackPanel Margin="24,8,24,24" Spacing="12">

      <!-- 插件 -->
      <Border Classes="panel" Padding="16">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4">
            <TextBlock Classes="subtitle"
                       Text="插件" />
            <TextBlock Text="工具都是插件。切换后需要重启应用生效。"
                       FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Plugins}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PluginItemViewModel">
                <Border Padding="12,10"
                        Margin="0,0,0,6"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        CornerRadius="10"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Name}"
                                 FontSize="13"
                                 Foreground="{StaticResource TextPrimaryBrush}" />
                      <TextBlock Text="{Binding Id}"
                                 FontFamily="{StaticResource MonoFont}"
                                 FontSize="10"
                                 Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding Version}"
                               Margin="16,0"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" />

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="3"
                                Margin="16,0"
                                VerticalAlignment="Center">
                      <TextBlock Text="{Binding ToolCount}"
                                 FontSize="11"
                                 Foreground="{StaticResource TextSecondaryBrush}" />
                      <TextBlock Text="个工具"
                                 FontSize="11"
                                 Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>

                    <ToggleSwitch Grid.Column="3"
                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                  OnContent="开"
                                  OffContent="关"
                                  VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="ghost" Content="打开插件目录" Click="OnOpenPluginsClick" />
            <Button Content="重新扫描" Click="OnRescanClick" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 热键 -->
      <Border Classes="panel" Padding="16">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4">
            <TextBlock Classes="subtitle"
                       Text="热键" />
            <TextBlock Text="格式示例：Ctrl+Alt+S、Ctrl+Shift+D、F9。保存后重启应用生效。"
                       FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}" />
          </StackPanel>

          <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto" RowSpacing="10">
            <TextBlock Text="搜索面板"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBox Grid.Column="1" Text="{Binding SearchHotkey, Mode=TwoWay}" />

            <TextBlock Grid.Row="1"
                       Text="截图识别"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CaptureHotkey, Mode=TwoWay}" />
          </Grid>

          <Button Content="保存热键"
                  Classes="accent small"
                  Click="OnSaveHotkeysClick"
                  HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <!-- 通用 -->
      <Border Classes="panel" Padding="16">
        <StackPanel Spacing="12">
          <TextBlock Classes="subtitle"
                     Text="通用" />

          <ToggleSwitch Content="开机自启（只启动到托盘）"
                        OnContent="开"
                        OffContent="关"
                        IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
        </StackPanel>
      </Border>

      <!-- 关于 -->
      <Border Classes="panel" Padding="16">
        <StackPanel Spacing="12">
          <TextBlock Classes="subtitle"
                     Text="关于" />

          <TextBlock Text="{Binding VersionText}"
                     FontSize="11"
                     Foreground="{StaticResource TextSecondaryBrush}" />

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="打开日志目录" Click="OnOpenLogsClick" />
            <Button Content="打开数据目录" Click="OnOpenDataClick" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding StatusMessage}"
                 Foreground="{StaticResource AccentBrush}"
                 FontSize="12"
                 TextWrapping="Wrap"
                 Margin="2,0" />

    </StackPanel>
  </ScrollViewer>
</UserControl>
