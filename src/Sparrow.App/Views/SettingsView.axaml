<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sparrow.App.ViewModels"
             x:Class="Sparrow.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <Grid RowDefinitions="Auto,*" Margin="24">

    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
      <TextBlock Text="插件" FontSize="20" Foreground="#E6EDF3" />
      <TextBlock Text="工具都是插件。切换后需要重启应用生效。"
                 FontSize="12"
                 Foreground="#8B98A8" />
    </StackPanel>

    <ScrollViewer Grid.Row="1">
      <ItemsControl ItemsSource="{Binding Plugins}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PluginItemViewModel">
            <Border Padding="14"
                    Margin="0,0,0,8"
                    Background="#161B22"
                    CornerRadius="8"
                    BorderBrush="#232B36"
                    BorderThickness="1">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Name}" FontSize="14" Foreground="#E6EDF3" />
                  <TextBlock Text="{Binding Id}" FontSize="11" Foreground="#6E7B8B" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding Version}"
                           Margin="16,0"
                           VerticalAlignment="Center"
                           Foreground="#8B98A8" />

                <TextBlock Grid.Column="2"
                           Text="{Binding ToolCount}"
                           Margin="16,0"
                           VerticalAlignment="Center"
                           Foreground="#8B98A8" />

                <ToggleSwitch Grid.Column="3"
                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                              VerticalAlignment="Center" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </Grid>
</UserControl>
