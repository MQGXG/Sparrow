<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sparrow.App.ViewModels"
             xmlns:svc="using:Sparrow.App.Services"
             x:Class="Sparrow.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <UserControl.Styles>
    <!-- 关于页的链接卡片：整块可点，悬停时描边变琥珀 -->
    <Style Selector="Button.link-card">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14,12" />
    </Style>
    <Style Selector="Button.link-card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- 外观三态预览卡：卡片里的迷你窗口用固定色，避免跟着主题变了反而分不清 -->
    <Style Selector="Button.appearance-card">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.appearance-card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    </Style>
    <Style Selector="Button.appearance-card.appearance-selected">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <!-- 分段导航：插件 / 模型 / 热键 / 通用 / 关于（HUD tab：文字 + 琥珀刻度线） -->
    <ScrollViewer Grid.Row="0"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled">
      <StackPanel Orientation="Horizontal" Spacing="24" Margin="24,10,24,12">
        <Button Classes="hud-tab"
                Classes.selected="{Binding IsPluginsSelected}"
                Tag="Plugins"
                ToolTip.Tip="插件开关、目录与重新扫描"
                Click="OnSectionClick">
          <StackPanel>
            <TextBlock Text="插件" />
            <Border Classes="tick" />
          </StackPanel>
        </Button>
        <Button Classes="hud-tab"
                Classes.selected="{Binding IsModelSelected}"
                Tag="Model"
                ToolTip.Tip="AI 提供方、密钥与连接测试"
                Click="OnSectionClick">
          <StackPanel>
            <TextBlock Text="模型" />
            <Border Classes="tick" />
          </StackPanel>
        </Button>
        <Button Classes="hud-tab"
                Classes.selected="{Binding IsHotkeysSelected}"
                Tag="Hotkeys"
                ToolTip.Tip="全局快捷键"
                Click="OnSectionClick">
          <StackPanel>
            <TextBlock Text="热键" />
            <Border Classes="tick" />
          </StackPanel>
        </Button>
        <Button Classes="hud-tab"
                Classes.selected="{Binding IsLanShareSelected}"
                Tag="LanShare"
                ToolTip.Tip="局域网文件互传"
                Click="OnSectionClick">
          <StackPanel>
            <TextBlock Text="互传" />
            <Border Classes="tick" />
          </StackPanel>
        </Button>
        <Button Classes="hud-tab"
                Classes.selected="{Binding IsGeneralSelected}"
                Tag="General"
                ToolTip.Tip="开机自启与历史保留"
                Click="OnSectionClick">
          <StackPanel>
            <TextBlock Text="通用" />
            <Border Classes="tick" />
          </StackPanel>
        </Button>
        <Button Classes="hud-tab"
                Classes.selected="{Binding IsDataSelected}"
                Tag="Data"
                ToolTip.Tip="模型、录制、剪贴板历史的存放位置"
                Click="OnSectionClick">
          <StackPanel>
            <TextBlock Text="数据" />
            <Border Classes="tick" />
          </StackPanel>
        </Button>
        <Button Classes="hud-tab"
                Classes.selected="{Binding IsAboutSelected}"
                Tag="About"
                ToolTip.Tip="版本、日志与数据目录"
                Click="OnSectionClick">
          <StackPanel>
            <TextBlock Text="关于" />
            <Border Classes="tick" />
          </StackPanel>
        </Button>
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="24,4,24,24" Spacing="14">

        <!-- ============ 插件 ============ -->
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
              ColumnSpacing="8"
              Margin="0,4,0,10"
              IsVisible="{Binding IsPluginsSelected}">
          <Border Classes="hud-icon">
            <Path Data="{StaticResource IconSparkle}" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,12,0" VerticalAlignment="Center">
            <TextBlock Text="插件"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="插件目录里的工具；复制新插件后点「重新扫描」即可生效"
                       FontSize="11"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Grid.Column="2"
                     Classes="num"
                     Text="{Binding Plugins.Count, StringFormat='{}{0} 个'}"
                     VerticalAlignment="Center" />
          <Button Grid.Column="3"
                  Classes="ghost"
                  Click="OnOpenPluginsClick"
                  ToolTip.Tip="打开插件目录">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Data="{StaticResource IconFolder}" Classes="icon icon-xs" />
              <TextBlock Text="打开目录" />
            </StackPanel>
          </Button>
          <Button Grid.Column="4"
                  Click="OnRescanClick"
                  ToolTip.Tip="重新扫描插件目录">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Data="{StaticResource IconRefresh}" Classes="icon icon-xs" />
              <TextBlock Text="重新扫描" />
            </StackPanel>
          </Button>
        </Grid>

        <Border Classes="panel" Padding="8" IsVisible="{Binding IsPluginsSelected}">
          <StackPanel Spacing="6">
            <ItemsControl ItemsSource="{Binding Plugins}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PluginItemViewModel">
                  <Border Background="{DynamicResource SurfaceRaisedBrush}"
                          CornerRadius="2"
                          Padding="14,12">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                      <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Id}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                      </StackPanel>

                      <TextBlock Grid.Column="1"
                                 Classes="num"
                                 Text="{Binding Version}"
                                 Margin="16,0"
                                 VerticalAlignment="Center" />

                      <StackPanel Grid.Column="2"
                                  Orientation="Horizontal"
                                  Spacing="5"
                                  Margin="16,0"
                                  VerticalAlignment="Center">
                        <TextBlock Text="{Binding ToolCount}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="个工具"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                      </StackPanel>

                      <ToggleSwitch Grid.Column="3"
                                    IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                    OnContent="开"
                                    OffContent="关"
                                    VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- ============ 离线模型 ============ -->
        <Border x:Name="LocalModelsPanel"
                Classes="panel"
                Padding="0"
                IsVisible="{Binding IsModelSelected}">
          <StackPanel>
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,14">
              <Border Classes="hud-icon">
                <Path Data="{StaticResource IconStorage}" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="离线模型"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="下载后无需 API Key、不需要联网；只在工具使用时加载"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock Grid.Column="2"
                         Classes="num"
                         Text="// LOCAL"
                         VerticalAlignment="Center" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto"
                  Margin="20,12,20,0"
                  ColumnSpacing="8"
                  IsVisible="{Binding HasLocalModels}">
              <TextBox Text="{Binding LocalModelMirror, Mode=TwoWay}"
                       PlaceholderText="自托管镜像根地址（可选），如 https://models.example.com/sparrow" />
              <Button Grid.Column="1"
                      Classes="ghost small"
                      Content="保存"
                      ToolTip.Tip="只换下载前缀，文件名保持不变"
                      Click="OnSaveModelMirrorClick" />
            </Grid>

            <ItemsControl x:Name="LocalModelsList"
                          ItemsSource="{Binding LocalModels}"
                          Margin="20,12,20,0"
                          IsVisible="{Binding HasLocalModels}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LocalModelItemViewModel">
                  <Border Background="{DynamicResource SurfaceRaisedBrush}"
                          CornerRadius="2"
                          Padding="14,12"
                          Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="5">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}"
                                     FontSize="13"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     VerticalAlignment="Center" />
                          <Border Background="{DynamicResource AccentSoftBrush}"
                                  BorderBrush="{DynamicResource AccentBorderBrush}"
                                  BorderThickness="1"
                                  CornerRadius="2"
                                  Padding="6,1"
                                  IsVisible="{Binding IsInstalled}"
                                  VerticalAlignment="Center">
                            <TextBlock Text="已下载"
                                       FontSize="10"
                                       Foreground="{DynamicResource AccentBrush}" />
                          </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding Description}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding SizeText}"
                                     FontSize="11"
                                     Foreground="{DynamicResource TextMutedBrush}" />
                          <TextBlock Text="·"
                                     FontSize="11"
                                     Foreground="{DynamicResource TextMutedBrush}" />
                          <TextBlock Text="{Binding MemoryText}"
                                     FontSize="11"
                                     Foreground="{DynamicResource TextMutedBrush}" />
                          <TextBlock Text="·"
                                     FontSize="11"
                                     Foreground="{DynamicResource TextMutedBrush}" />
                          <TextBlock Text="{Binding StateText}"
                                     FontSize="11"
                                     Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>

                        <TextBlock Text="{Binding License}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap" />
                      </StackPanel>

                      <StackPanel Grid.Column="1"
                                  Spacing="4"
                                  Margin="12,0,0,0"
                                  VerticalAlignment="Center">
                        <Button Classes="accent small"
                                Content="下载"
                                IsVisible="{Binding ShowDownload}"
                                IsEnabled="{Binding IsIdle}"
                                Click="OnDownloadLocalModelClick" />
                        <Button Classes="ghost small"
                                Content="删除"
                                IsVisible="{Binding ShowDelete}"
                                IsEnabled="{Binding IsIdle}"
                                Click="OnDeleteLocalModelClick" />
                        <ProgressBar Value="{Binding ProgressPercent}"
                                     Maximum="100"
                                     Height="3"
                                     Width="72"
                                     IsVisible="{Binding IsBusy}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Margin="20,0,20,14"
                       FontSize="11"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasLocalModels}"
                       Text="模型存放在 %LocalAppData%\Sparrow\models，删除会释放磁盘空间。" />
          </StackPanel>
        </Border>

        <!-- ============ 热键 ============ -->
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,10" IsVisible="{Binding IsHotkeysSelected}">
          <Border Classes="hud-tick" />
          <TextBlock Grid.Column="1"
                     Text="热键"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Margin="10,0,0,0"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="2"
                     Classes="num"
                     Text="// HOTKEYS" />
        </Grid>

        <Border Classes="panel" Padding="0" IsVisible="{Binding IsHotkeysSelected}">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto" Margin="20,14">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="搜索面板"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="唤出命令面板"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <TextBox x:Name="SearchHotkeyBox"
                       Grid.Column="1"
                       Width="260"
                       IsReadOnly="True"
                       Tag="hotkey"
                       ToolTip.Tip="点击后直接按组合键；Backspace 清空"
                       PlaceholderText="点击后按组合键"
                       Text="{Binding SearchHotkey, Mode=TwoWay}" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <!-- 文件搜索：触发方式 -->
            <Grid ColumnDefinitions="*,Auto" Margin="20,14">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="文件搜索"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="唤出本机文件搜索；首次需要管理员权限建立索引"
                           FontSize="11"
                           HorizontalAlignment="Left"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>

              <StackPanel Grid.Column="1"
                          Spacing="8"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <TextBlock Text="双击 Ctrl"
                             FontSize="11"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             VerticalAlignment="Center" />
                  <ToggleSwitch OnContent="开"
                                OffContent="关"
                                IsChecked="{Binding DoubleCtrlSearchEnabled, Mode=TwoWay}"
                                VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <TextBlock Text="快捷键"
                             FontSize="11"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             VerticalAlignment="Center" />
                  <TextBox Width="180"
                           IsReadOnly="True"
                           Tag="hotkey"
                           PlaceholderText="点击后按组合键"
                           ToolTip.Tip="留空表示只使用双击 Ctrl"
                           Text="{Binding FileSearchHotkey, Mode=TwoWay}" />
                </StackPanel>
              </StackPanel>
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <!-- 索引磁盘 -->
            <Grid ColumnDefinitions="*,Auto" Margin="20,14">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="索引磁盘"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="选择要建立文件索引的固定盘；修改后重启 Sparrow 生效"
                           FontSize="11"
                           HorizontalAlignment="Left"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <Button Grid.Column="1"
                      Classes="ghost"
                      Content="重建索引"
                      Click="OnRebuildIndexClick"
                      ToolTip.Tip="删除现有索引并重新扫描，会弹出管理员确认" />
            </Grid>

            <ItemsControl ItemsSource="{Binding IndexDriveOptions}" Margin="20,0,20,12">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:IndexDriveOptionViewModel">
                  <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            Content="{Binding Label}"
                            Margin="0,2,20,2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 索引服务 -->
            <Grid ColumnDefinitions="*,Auto" Margin="20,0,20,14">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="索引服务"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="安装后才能实时监听文件变化；需要管理员权限"
                           FontSize="11"
                           HorizontalAlignment="Left"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>

              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="8"
                          VerticalAlignment="Center">
                <Button Classes="ghost"
                        Content="安装索引服务"
                        Click="OnInstallIndexServiceClick"
                        ToolTip.Tip="安装并启动 Windows 索引服务（需要管理员权限）" />
                <Button Classes="ghost"
                        Content="卸载索引服务"
                        Click="OnUninstallIndexServiceClick"
                        ToolTip.Tip="停止并删除 Windows 索引服务（需要管理员权限）" />
              </StackPanel>
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,14">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="截图识别"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="选区截图与文字识别"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <TextBox Grid.Column="1"
                       Width="260"
                       IsReadOnly="True"
                       Tag="hotkey"
                       ToolTip.Tip="点击后直接按组合键；Backspace 清空"
                       PlaceholderText="点击后按组合键"
                       Text="{Binding CaptureHotkey, Mode=TwoWay}" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,14">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="屏幕录制"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="开始/停止录制"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <TextBox Grid.Column="1"
                       Width="260"
                       IsReadOnly="True"
                       Tag="hotkey"
                       ToolTip.Tip="点击后直接按组合键；Backspace 清空"
                       PlaceholderText="点击后按组合键"
                       Text="{Binding RecordHotkey, Mode=TwoWay}" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <!-- 截图窗口内快捷键：单键或 Ctrl+组合；留空禁用 -->
            <StackPanel Margin="20,14,20,2" Spacing="3">
              <TextBlock Text="截图窗口内快捷键"
                         FontSize="13"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="单键或 Ctrl+组合；留空表示禁用该快捷键"
                         FontSize="11"
                         Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto" Margin="20,10">
              <TextBlock Text="识别文字" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBox Grid.Column="1" Width="260" IsReadOnly="True" Tag="hotkey"
                       ToolTip.Tip="点击后直接按组合键；Backspace 清空"
                       PlaceholderText="留空禁用"
                       Text="{Binding CaptureRecognizeKey, Mode=TwoWay}" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,10">
              <TextBlock Text="翻译（识别并出译文）" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBox Grid.Column="1" Width="260" IsReadOnly="True" Tag="hotkey"
                       ToolTip.Tip="点击后直接按组合键；Backspace 清空"
                       PlaceholderText="留空禁用"
                       Text="{Binding CaptureTranslateKey, Mode=TwoWay}" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,10">
              <TextBlock Text="复制图片" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBox Grid.Column="1" Width="260" IsReadOnly="True" Tag="hotkey"
                       ToolTip.Tip="点击后直接按组合键；Backspace 清空"
                       PlaceholderText="留空禁用"
                       Text="{Binding CaptureCopyKey, Mode=TwoWay}" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,10">
              <TextBlock Text="保存" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBox Grid.Column="1" Width="260" IsReadOnly="True" Tag="hotkey"
                       ToolTip.Tip="点击后直接按组合键；Backspace 清空"
                       PlaceholderText="留空禁用"
                       Text="{Binding CaptureSaveKey, Mode=TwoWay}" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,10">
              <TextBlock Text="固定到屏幕" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBox Grid.Column="1" Width="260" IsReadOnly="True" Tag="hotkey"
                       ToolTip.Tip="点击后直接按组合键；Backspace 清空"
                       PlaceholderText="留空禁用"
                       Text="{Binding CapturePinKey, Mode=TwoWay}" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,10">
              <TextBlock Text="滚动截图" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBox Grid.Column="1" Width="260" IsReadOnly="True" Tag="hotkey"
                       ToolTip.Tip="点击后直接按组合键；Backspace 清空"
                       PlaceholderText="留空禁用"
                       Text="{Binding CaptureScrollKey, Mode=TwoWay}" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,10">
              <TextBlock Text="取色" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBox Grid.Column="1" Width="260" IsReadOnly="True" Tag="hotkey"
                       ToolTip.Tip="点击后直接按组合键；Backspace 清空"
                       PlaceholderText="留空禁用"
                       Text="{Binding CaptureColorKey, Mode=TwoWay}" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,10">
              <TextBlock Text="识别框显示方式" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBox Grid.Column="1" Width="260" IsReadOnly="True" Tag="hotkey"
                       ToolTip.Tip="点击后直接按组合键；Backspace 清空"
                       PlaceholderText="留空禁用"
                       Text="{Binding CaptureOcrBoxKey, Mode=TwoWay}" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,14">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="窗口元素 API"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="识别光标下的控件（图标 / 按钮 / 列表项）；自动 = UIA 优先，MSAA 兜底"
                           FontSize="11"
                           MaxWidth="520"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <ComboBox Grid.Column="1"
                        Width="260"
                        ItemsSource="{Binding CaptureElementApiOptions}"
                        SelectedItem="{Binding SelectedCaptureElementApi, Mode=TwoWay}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SettingsChoiceOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,14">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="截图捕获 API"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="取帧方式；自动 = 平时 GDI、HDR 显示器用 WGC。WGC 跨屏时逐屏抓取再拼接"
                           FontSize="11"
                           MaxWidth="520"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <ComboBox Grid.Column="1"
                        Width="260"
                        ItemsSource="{Binding CaptureApiOptions}"
                        SelectedItem="{Binding SelectedCaptureApi, Mode=TwoWay}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SettingsChoiceOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,14">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="选区边框颜色"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="选区、十字辅助线和悬停候选框共用的强调色"
                           FontSize="11"
                           MaxWidth="520"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <ComboBox Grid.Column="1"
                        Width="260"
                        ItemsSource="{Binding SelectionBorderColorOptions}"
                        SelectedItem="{Binding SelectionBorderColor, Mode=TwoWay}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SettingsChoiceOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,14">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="显示光标"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="在新的普通截图中画上鼠标光标；滚动截图始终不画，避免每帧重复"
                           FontSize="11"
                           MaxWidth="520"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1"
                            OnContent="开"
                            OffContent="关"
                            IsChecked="{Binding CaptureShowCursor, Mode=TwoWay}"
                            VerticalAlignment="Center" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,14">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="滚动截图时捕获界面"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="在拼接结果中包含滚动截图窗口及其工具栏；关闭后这些窗口会从取帧中排除"
                           FontSize="11"
                           MaxWidth="520"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1"
                            OnContent="开"
                            OffContent="关"
                            IsChecked="{Binding CaptureUiInScroll, Mode=TwoWay}"
                            VerticalAlignment="Center" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,14">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="还原屏幕原始颜色"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="还原 Windows 放大镜的全屏颜色滤镜（反色 / 灰度等）；WGC 取帧本来就是原始颜色"
                           FontSize="11"
                           MaxWidth="520"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1"
                            OnContent="开"
                            OffContent="关"
                            IsChecked="{Binding CaptureRestoreColors, Mode=TwoWay}"
                            VerticalAlignment="Center" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,14">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="剪贴板面板"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="只呼出搜索与列表，双击 / 回车直接复制"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <TextBox x:Name="ClipboardPanelHotkeyBox"
                       Grid.Column="1"
                       Width="260"
                       IsReadOnly="True"
                       Tag="hotkey"
                       ToolTip.Tip="点击后直接按组合键；Backspace 清空"
                       PlaceholderText="点击后按组合键"
                       Text="{Binding ClipboardPanelHotkey, Mode=TwoWay}" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <!-- 工具热键：任意工具挂全局热键；留空 = 不绑定 -->
            <StackPanel IsVisible="{Binding HasToolHotkeys}">
              <Grid ColumnDefinitions="Auto,*" Margin="20,14,20,4">
                <Border Classes="hud-tick" />
                <StackPanel Grid.Column="1" Spacing="2" Margin="10,0,0,0">
                  <TextBlock Text="工具热键"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="留空 = 不绑定；按下直接执行，不打开面板"
                             FontSize="11"
                             Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
              </Grid>

              <ItemsControl ItemsSource="{Binding ToolHotkeys}" Margin="20,0,20,8">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ToolHotkeyRowViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,5">
                      <TextBlock Text="{Binding Name}"
                                 FontSize="12"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 VerticalAlignment="Center" />
                      <TextBox Grid.Column="1"
                               Width="260"
                               IsReadOnly="True"
                               Tag="hotkey"
                               ToolTip.Tip="点击后直接按组合键；Backspace 清空"
                               Text="{Binding HotkeyText, Mode=TwoWay}"
                               PlaceholderText="点击后按组合键" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid Margin="20,14">
              <TextBlock Text="点输入框后直接按组合键；Backspace 清空；保存后重启应用生效。"
                         FontSize="11"
                         Foreground="{DynamicResource TextMutedBrush}"
                         VerticalAlignment="Center" />
              <Button Classes="accent small"
                      Content="保存热键"
                      Click="OnSaveHotkeysClick"
                      HorizontalAlignment="Right" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- ============ 局域网互传 ============ -->
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,10" IsVisible="{Binding IsLanShareSelected}">
          <Border Classes="hud-tick" />
          <TextBlock Grid.Column="1"
                     Text="局域网互传"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Margin="10,0,0,0"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="2"
                     Classes="num"
                     Text="// LAN SHARE" />
        </Grid>

        <Border Classes="panel" Padding="0" IsVisible="{Binding IsLanShareSelected}">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto" Margin="20,14">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="开启互传"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="App 常驻托盘时保持监听，同一局域网的 LocalSend/Sparrow 可以互发文件"
                           FontSize="11"
                           MaxWidth="520"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1"
                            OnContent="开"
                            OffContent="关"
                            IsChecked="{Binding LanShareEnabled, Mode=TwoWay}"
                            VerticalAlignment="Center" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,14">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="设备名"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="局域网内显示的名字，默认用机器名"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <TextBox Grid.Column="1"
                       Width="260"
                       Text="{Binding LanShareAlias, Mode=TwoWay}" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,14">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="端口"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="默认 53317；被占用时会自动顺延"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <TextBox Grid.Column="1"
                       Width="120"
                       Text="{Binding LanSharePortText, Mode=TwoWay}" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="20,14">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="接收目录"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="收到的文件保存到这里；默认跟随系统 Downloads"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <TextBox Grid.Column="1"
                       Width="300"
                       Text="{Binding LanShareReceiveDirectory, Mode=TwoWay}" />
              <Button Grid.Column="2"
                      Classes="ghost"
                      Content="选择…"
                      Click="OnPickLanShareFolderClick" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,14">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="接收 PIN"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="为空表示不校验；设置后发送方必须输入相同 PIN"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <TextBox Grid.Column="1"
                       Width="160"
                       PasswordChar="●"
                       Text="{Binding LanSharePin, Mode=TwoWay}" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,14">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="免确认接收"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="关闭后每次上传都会弹窗确认发送方和文件列表"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1"
                            OnContent="开"
                            OffContent="关"
                            IsChecked="{Binding LanShareQuickSave, Mode=TwoWay}"
                            VerticalAlignment="Center" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,14">
              <TextBlock Text="{Binding LanShareStatusText}"
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      Classes="accent small"
                      Content="应用并重启"
                      Click="OnApplyLanShareClick" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- ============ 通用 ============ -->
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,10" IsVisible="{Binding IsGeneralSelected}">
          <Border Classes="hud-tick" />
          <TextBlock Grid.Column="1"
                     Text="通用"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Margin="10,0,0,0"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="2"
                     Classes="num"
                     Text="// GENERAL" />
        </Grid>

        <Border Classes="panel" Padding="0" IsVisible="{Binding IsGeneralSelected}">
          <StackPanel>
            <!-- 外观：通用分组第一行，三态预览卡 -->
            <StackPanel Margin="20,14" Spacing="12">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Classes="hud-icon">
                  <Path Data="{StaticResource IconSettings}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,12,0" VerticalAlignment="Center">
                  <TextBlock Text="外观"
                             FontSize="13"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="深色 / 浅色 / 跟随系统，切换即时生效"
                             FontSize="11"
                             Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Classes="num" Text="// APPEARANCE" VerticalAlignment="Center" />
              </Grid>

              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <!-- 跟随系统：左深右浅 -->
                <Button Classes="appearance-card"
                        Classes.appearance-selected="{Binding IsSystemAppearance}"
                        Tag="system"
                        Click="OnAppearanceClick"
                        AutomationProperties.Name="跟随系统">
                  <StackPanel Spacing="8">
                    <Border Height="52" CornerRadius="5" ClipToBounds="True"
                            BorderBrush="#33000000" BorderThickness="1">
                      <Grid ColumnDefinitions="*,*">
                        <Border Grid.Column="0" Background="#0B0E13" />
                        <Border Grid.Column="1" Background="#F7F8FA" />
                        <Border Grid.Column="0" Height="9" VerticalAlignment="Top" Background="#1A212C" />
                        <Border Grid.Column="1" Height="9" VerticalAlignment="Top" Background="#FFFFFF" />
                        <Border Grid.ColumnSpan="2" Width="22" Height="3" CornerRadius="1.5"
                                Background="#E5A44C" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="8,17,0,0" />
                        <Border Grid.ColumnSpan="2" Height="7" CornerRadius="2" Background="#2B3543"
                                HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="8,0,8,9" />
                      </Grid>
                    </Border>
                    <TextBlock Text="跟随系统" FontSize="11" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                </Button>

                <!-- 浅色 -->
                <Button Classes="appearance-card"
                        Classes.appearance-selected="{Binding IsLightAppearance}"
                        Tag="light"
                        Click="OnAppearanceClick"
                        AutomationProperties.Name="浅色">
                  <StackPanel Spacing="8">
                    <Border Height="52" CornerRadius="5" ClipToBounds="True"
                            Background="#F7F8FA" BorderBrush="#33000000" BorderThickness="1">
                      <Grid>
                        <Border Height="9" VerticalAlignment="Top" Background="#FFFFFF" />
                        <Border Width="22" Height="3" CornerRadius="1.5" Background="#E5A44C"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,17,0,0" />
                        <Border Height="7" CornerRadius="2" Background="#E2E5EA"
                                HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="8,0,8,9" />
                        <Border Width="26" Height="18" CornerRadius="3" Background="#FFFFFF"
                                BorderBrush="#E2E5EA" BorderThickness="1"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                      </Grid>
                    </Border>
                    <TextBlock Text="浅色" FontSize="11" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                </Button>

                <!-- 深色 -->
                <Button Classes="appearance-card"
                        Classes.appearance-selected="{Binding IsDarkAppearance}"
                        Tag="dark"
                        Click="OnAppearanceClick"
                        AutomationProperties.Name="深色">
                  <StackPanel Spacing="8">
                    <Border Height="52" CornerRadius="5" ClipToBounds="True"
                            Background="#0B0E13" BorderBrush="#33000000" BorderThickness="1">
                      <Grid>
                        <Border Height="9" VerticalAlignment="Top" Background="#1A212C" />
                        <Border Width="22" Height="3" CornerRadius="1.5" Background="#E5A44C"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,17,0,0" />
                        <Border Height="7" CornerRadius="2" Background="#2B3543"
                                HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="8,0,8,9" />
                        <Border Width="26" Height="18" CornerRadius="3" Background="#1A212C"
                                BorderBrush="#2B3543" BorderThickness="1"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                      </Grid>
                    </Border>
                    <TextBlock Text="深色" FontSize="11" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                </Button>
              </Grid>
            </StackPanel>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,14">
              <Border Classes="hud-icon">
                <Path Data="{StaticResource IconPower}" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="开机自启"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="只在启动时进托盘，不弹窗口"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="2"
                            OnContent="开"
                            OffContent="关"
                            IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                            VerticalAlignment="Center" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,14">
              <Border Classes="hud-icon">
                <Path Data="{StaticResource IconClipboard}" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="剪贴板历史"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="本机本地存储；关闭后已记录的内容保留"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="2"
                            OnContent="开"
                            OffContent="关"
                            IsChecked="{Binding ClipboardHistoryEnabled, Mode=TwoWay}"
                            VerticalAlignment="Center" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,14">
              <Border Classes="hud-icon">
                <Path Data="{StaticResource IconCalendar}" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="剪贴板保留（天）"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="0 表示永久保留；收藏条目不参与清理"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <NumericUpDown Grid.Column="2"
                             Value="{Binding ClipboardRetentionDays, Mode=TwoWay}"
                             Minimum="0"
                             Maximum="3650"
                             Increment="30"
                             FormatString="0"
                             Width="140"
                             VerticalAlignment="Center" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,14">
              <Border Classes="hud-icon">
                <Path Data="{StaticResource IconStorage}" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="剪贴板总容量（MB）"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="超出后从最旧的开始删，收藏不参与；0 表示不限制"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <NumericUpDown Grid.Column="2"
                             Value="{Binding ClipboardMaxMb, Mode=TwoWay}"
                             Minimum="0"
                             Maximum="10240"
                             Increment="64"
                             FormatString="0"
                             Width="140"
                             VerticalAlignment="Center" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,14">
              <Border Classes="hud-icon">
                <Path Data="{StaticResource IconClock}" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="历史最多保留（条）"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="超过后只保留最近的部分，改完立即清理一次"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <NumericUpDown Grid.Column="2"
                             Value="{Binding HistoryMaxEntries, Mode=TwoWay}"
                             Minimum="50"
                             Maximum="5000"
                             Increment="50"
                             FormatString="0"
                             Width="140"
                             VerticalAlignment="Center" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,14">
              <Border Classes="hud-icon">
                <Path Data="{StaticResource IconCalendar}" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="历史保留（天）"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="0 表示不按天数清理"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <NumericUpDown Grid.Column="2"
                             Value="{Binding HistoryRetentionDays, Mode=TwoWay}"
                             Minimum="0"
                             Maximum="3650"
                             Increment="30"
                             FormatString="0"
                             Width="140"
                             VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- ============ 模型 ============ -->
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,10" IsVisible="{Binding IsModelSelected}">
          <Border Classes="hud-tick" />
          <TextBlock Grid.Column="1"
                     Text="模型"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Margin="10,0,0,0"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="2"
                     Classes="num"
                     Text="// MODEL" />
        </Grid>

        <Border Classes="panel" Padding="0" IsVisible="{Binding IsModelSelected}">
          <StackPanel>
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,14">
              <Border Classes="hud-icon">
                <Path Data="{StaticResource IconSparkle}" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="启用模型"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="AI 类工具可用；插件只拿到统一接口"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="2"
                            OnContent="开"
                            OffContent="关"
                            IsChecked="{Binding AiEnabled, Mode=TwoWay}"
                            VerticalAlignment="Center" />
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <StackPanel Margin="20,14" Spacing="12">
              <Grid ColumnDefinitions="92,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                <TextBlock Text="提供方"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AiProviderOptions}"
                          SelectedItem="{Binding SelectedAiProvider, Mode=TwoWay}"
                          HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="svc:AiProviderPreset">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="1"
                           Text="Base URL"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Text="{Binding AiBaseUrl, Mode=TwoWay}"
                         PlaceholderText="https://api.openai.com/v1" />

                <TextBlock Grid.Row="2"
                           Text="模型名"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         Text="{Binding AiModel, Mode=TwoWay}"
                         PlaceholderText="gpt-4o-mini" />

                <TextBlock Grid.Row="3"
                           Text="API Key"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBox Grid.Row="3"
                         Grid.Column="1"
                         Text="{Binding AiKey, Mode=TwoWay}"
                         PasswordChar="●"
                         PlaceholderText="留空表示不修改已保存的密钥" />
              </Grid>
              <TextBlock Text="API Key 由宿主用 Windows DPAPI 加密保存，不会进入插件或日志。"
                         FontSize="11"
                         Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>

            <Border Classes="hud-line" Margin="20,0" />

            <Grid Margin="20,14" ColumnDefinitions="*,Auto,Auto">
              <TextBlock Text="{Binding AiStatus}"
                         FontSize="11"
                         Foreground="{DynamicResource AccentBrush}"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      Classes="ghost small"
                      Content="清除密钥"
                      Margin="0,0,8,0"
                      Click="OnClearAiKeyClick" />
              <Button Grid.Column="2"
                      Classes="accent small"
                      Content="保存并测试"
                      Click="OnSaveAiClick" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- ============ 数据与缓存 ============ -->
        <Border Classes="panel" Padding="0" IsVisible="{Binding IsDataSelected}">
          <StackPanel>
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,14">
              <Border Classes="hud-icon">
                <Path Data="{StaticResource IconStorage}" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="3" Margin="12,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="数据与缓存"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="模型、录制、剪贴板历史可以分别放到不同的盘；更改后重启生效，不会自动搬运旧文件"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <!-- 默认数据根目录 -->
            <Grid ColumnDefinitions="*,Auto" Margin="20,14" ColumnSpacing="16">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="数据根目录"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding DataDirectoryDisplay}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="剪贴板历史、历史记录"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="8"
                          VerticalAlignment="Center">
                <Button Classes="ghost" Tag="Data" Click="OnChangeDirectoryClick" ToolTip.Tip="选择新的数据根目录">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Data="{StaticResource IconFolder}" Classes="icon icon-xs" />
                    <TextBlock Text="选择" />
                  </StackPanel>
                </Button>
                <Button Tag="Data" Click="OnOpenDirectoryClick" ToolTip.Tip="在资源管理器中打开">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Data="{StaticResource IconOpen}" Classes="icon icon-xs" />
                    <TextBlock Text="打开" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <!-- 离线模型 -->
            <Grid ColumnDefinitions="*,Auto" Margin="20,14" ColumnSpacing="16">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="模型目录"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding ModelDirectoryDisplay}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="离线模型文件（OCR / 翻译等）"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="8"
                          VerticalAlignment="Center">
                <Button Classes="ghost" Tag="Model" Click="OnChangeDirectoryClick" ToolTip.Tip="选择新的模型目录">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Data="{StaticResource IconFolder}" Classes="icon icon-xs" />
                    <TextBlock Text="选择" />
                  </StackPanel>
                </Button>
                <Button Tag="Model" Click="OnOpenDirectoryClick" ToolTip.Tip="在资源管理器中打开">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Data="{StaticResource IconOpen}" Classes="icon icon-xs" />
                    <TextBlock Text="打开" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <!-- 录制输出 -->
            <Grid ColumnDefinitions="*,Auto" Margin="20,14" ColumnSpacing="16">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="录制目录"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding RecordDirectoryDisplay}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="屏幕录制的输出文件"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="8"
                          VerticalAlignment="Center">
                <Button Classes="ghost" Tag="Record" Click="OnChangeDirectoryClick" ToolTip.Tip="选择新的录制目录">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Data="{StaticResource IconFolder}" Classes="icon icon-xs" />
                    <TextBlock Text="选择" />
                  </StackPanel>
                </Button>
                <Button Tag="Record" Click="OnOpenDirectoryClick" ToolTip.Tip="在资源管理器中打开">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Data="{StaticResource IconOpen}" Classes="icon icon-xs" />
                    <TextBlock Text="打开" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>

            <Border Classes="hud-line" Margin="20,0" />

            <!-- 日志（固定） -->
            <Grid ColumnDefinitions="*,Auto" Margin="20,14" ColumnSpacing="16">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="日志目录"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding LogDirectoryDisplay}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="固定在程序数据目录：启动早期就要写日志，不跟随上面的设置"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="8"
                          VerticalAlignment="Center">
                <Button Tag="Logs" Click="OnOpenDirectoryClick" ToolTip.Tip="在资源管理器中打开">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Data="{StaticResource IconOpen}" Classes="icon icon-xs" />
                    <TextBlock Text="打开" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- ============ 关于：品牌横幅 + 指标 + 更新 + 签名 ============ -->
        <Border Classes="panel" Padding="0" IsVisible="{Binding IsAboutSelected}">
          <StackPanel>

            <!-- Hero：点阵底 + 大 Logo + 名称 + 徽章 -->
            <Grid Height="156">
              <Border Background="{DynamicResource DotGridBrush}" IsHitTestVisible="False" />
              <TextBlock Classes="num"
                         Text="01 / IDENTITY"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,16,22,0"
                         Foreground="{DynamicResource AccentBrush}"
                         Opacity="0.75" />

              <Grid ColumnDefinitions="Auto,*" Margin="24,22,24,18">
                <Border Width="86"
                        Height="86"
                        CornerRadius="6"
                        Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                  <Image Source="avares://Sparrow.App/Assets/sparrow-32.png"
                         Width="58"
                         Height="58"
                         RenderOptions.BitmapInterpolationMode="HighQuality" />
                </Border>

                <StackPanel Grid.Column="1" Margin="22,0,0,0" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Classes="num"
                             Text="// SPARROW · LOCAL-FIRST TOOLKIT"
                             Foreground="{DynamicResource AccentBrush}"
                             LetterSpacing="1.4" />
                  <TextBlock FontFamily="{StaticResource DisplayFont}"
                             FontSize="27"
                             FontWeight="Bold"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             Text="麻雀 · 工具台" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Classes="chip">
                      <TextBlock Classes="num"
                                 Text="{Binding VersionText, StringFormat='{}v{0}'}" />
                    </Border>
                    <Border Classes="chip">
                      <TextBlock Classes="num" Text="Windows x64 · .NET 10" />
                    </Border>
                    <Border Classes="chip"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBrush}">
                      <TextBlock Classes="num"
                                 Text="本地就绪"
                                 Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Grid>

            <Border Classes="hud-line" />

            <!-- 指标条：工具 / 插件 / 运行模式 -->
            <Grid ColumnDefinitions="*,*,*" Margin="24,18,24,18">
              <StackPanel Spacing="5">
                <TextBlock Classes="section" Text="工具总数" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="stat" Text="{Binding ToolCount}" />
                  <TextBlock Classes="num" Text="个" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Classes="section" Text="插件" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="stat" Text="{Binding Plugins.Count}" />
                  <TextBlock Classes="num" Text="个" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="5">
                <TextBlock Classes="section" Text="运行模式" />
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                  <TextBlock FontFamily="{StaticResource MonoFont}"
                             FontSize="18"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource AccentBrush}"
                             Text="LOCAL" />
                </StackPanel>
              </StackPanel>
            </Grid>

            <Border Classes="hud-line" />

            <!-- 当前版本 + 复制版本号 -->
            <Grid ColumnDefinitions="*,Auto" Margin="24,16">
              <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock Classes="section" Text="当前版本" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="stat"
                             FontSize="22"
                             Text="{Binding VersionText}" />
                  <TextBlock Classes="num"
                             Text="本地优先 · 数据不出机器"
                             VerticalAlignment="Bottom"
                             Margin="0,0,0,4" />
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="ghost" Click="OnCopyVersionClick" ToolTip.Tip="复制版本号，反馈问题时用">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Data="{StaticResource IconCopy}" Classes="icon icon-xs" />
                    <TextBlock Text="复制版本号" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>

            <Border Classes="hud-line" />

            <!-- 更新：Velopack 安装版才可用 -->
            <Grid ColumnDefinitions="*,Auto" Margin="24,16" RowDefinitions="Auto,Auto" RowSpacing="8">
              <StackPanel Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="{StaticResource IconRefresh}" Classes="icon icon-xs" />
                  <TextBlock Text="更新"
                             FontSize="13"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
                <TextBlock Text="{Binding UpdateStatus, FallbackValue='未检查'}"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           MaxWidth="420" />
              </StackPanel>

              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="8"
                          VerticalAlignment="Center">
                <TextBox Text="{Binding UpdateFeedUrl, Mode=TwoWay}"
                         Width="280"
                         PlaceholderText="更新源地址（https://…）" />
                <Button Classes="accent"
                        IsEnabled="{Binding IsNotCheckingUpdate}"
                        Click="OnCheckUpdateClick"
                        ToolTip.Tip="检查更新">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Data="{StaticResource IconRefresh}" Classes="icon icon-xs" />
                    <TextBlock Text="检查更新" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>

            <Border Classes="hud-line" />

            <!-- 项目来源：源码 / 反馈 / 本地优先说明 -->
            <Grid ColumnDefinitions="*,*,*" Margin="24,16" ColumnSpacing="10">
              <Button Classes="link-card" Tag="https://github.com/MQXGXG/Sparrow" Click="OnOpenLinkClick">
                <StackPanel Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Data="{StaticResource IconLink}" Classes="icon icon-xs" />
                    <TextBlock Text="GitHub" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                  <TextBlock Text="查看源码，一起改进"
                             FontSize="11"
                             Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
              </Button>

              <Button Grid.Column="1"
                      Classes="link-card"
                      Tag="https://github.com/MQXGXG/Sparrow/issues"
                      Click="OnOpenLinkClick">
                <StackPanel Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Data="{StaticResource IconText}" Classes="icon icon-xs" />
                    <TextBlock Text="问题反馈" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                  <TextBlock Text="Bug 与建议，附上版本号和日志"
                             FontSize="11"
                             Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
              </Button>

              <Button Grid.Column="2"
                      Classes="link-card"
                      Tag="logs"
                      Click="OnOpenLinkClick">
                <StackPanel Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Data="{StaticResource IconFile}" Classes="icon icon-xs" />
                    <TextBlock Text="本地日志" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                  <TextBlock Text="完整的启动与执行记录"
                             FontSize="11"
                             Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
              </Button>
            </Grid>

            <Border Classes="hud-line" />
            <Border Margin="24,18"
                    Padding="16,12"
                    Background="{DynamicResource AccentSoftBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="2,0,0,0"
                    CornerRadius="4">
              <StackPanel Spacing="5">
                <TextBlock Classes="num"
                           Text="// 所有工具都在本地执行"
                           Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="屏幕上的每个像素都留在本机：识别、翻译、录制、处理，不经过任何服务器。"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="hud-line" />

            <!-- 排查入口 -->
            <Grid ColumnDefinitions="*,Auto" Margin="24,16">
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Classes="num" Text="SUPPORT / 排查" />
                <TextBlock Text="遇到问题时，日志里有完整的启动与执行记录。"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Classes="ghost" Click="OnOpenLogsClick" ToolTip.Tip="打开日志目录">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Data="{StaticResource IconFile}" Classes="icon icon-xs" />
                    <TextBlock Text="打开日志" />
                  </StackPanel>
                </Button>
                <Button Click="OnOpenDataClick" ToolTip.Tip="打开数据目录">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Data="{StaticResource IconFolder}" Classes="icon icon-xs" />
                    <TextBlock Text="打开数据目录" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>

            <Border Classes="hud-line" />

            <!-- 作者 / 打赏：二维码图片存在时才显示 -->
            <Grid ColumnDefinitions="*,Auto" Margin="24,16" ColumnSpacing="20">
              <StackPanel Spacing="6" VerticalAlignment="Center">
                <TextBlock Classes="num" Text="AUTHOR / 作者" />
                <TextBlock Text="MQXGXG"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Sparrow 是一个本地优先的桌面工具台：处理都在本机完成，源码开源在 GitHub。"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           MaxWidth="480" />
              </StackPanel>

              <Border x:Name="DonatePanel"
                      Grid.Column="1"
                      IsVisible="False"
                      Background="#FFFFFFFF"
                      BorderBrush="{DynamicResource AccentBrush}"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="6"
                      VerticalAlignment="Center"
                      ToolTip.Tip="微信扫码打赏作者">
                <StackPanel Spacing="4">
                  <Image x:Name="DonateImage"
                         Width="112"
                         Height="112"
                         Stretch="Uniform" />
                  <TextBlock Text="微信打赏"
                             FontSize="10"
                             HorizontalAlignment="Center"
                             Foreground="#FF333333" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Classes="hud-line" />

            <!-- 版权 -->
            <Grid ColumnDefinitions="*,Auto" Margin="24,12,24,16">
              <TextBlock Classes="num" Text="© 2026 MQXGXG · 本地优先，数据不出机器" />
              <TextBlock Grid.Column="1" Classes="num" Text="SPARROW / END" />
            </Grid>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
