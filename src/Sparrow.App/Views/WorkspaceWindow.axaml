<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sparrow.App.ViewModels"
        xmlns:views="using:Sparrow.App.Views"
        x:Class="Sparrow.App.Views.WorkspaceWindow"
        x:DataType="vm:WorkspaceViewModel"
        Title="Sparrow · 工作区"
        Width="1120"
        Height="730"
        MinWidth="920"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">

  <Grid>

    <!-- 工作区主视图 -->
    <Grid IsVisible="{Binding !IsSettingsVisible}" RowDefinitions="Auto,*,Auto">

      <!-- 顶栏 -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="22,18,22,14">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="麻雀"
                     FontFamily="{StaticResource DisplayFont}"
                     FontSize="20"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Text="Sparrow"
                     FontSize="11"
                     Foreground="{StaticResource TextMutedBrush}"
                     VerticalAlignment="Center"
                     Margin="0,2,0,0" />
        </StackPanel>

        <Button Grid.Column="1"
                Classes="small"
                Content="设置"
                Click="OnSettingsClick" />
      </Grid>

      <Grid Grid.Row="1"
            ColumnDefinitions="240,*,320"
            ColumnSpacing="16"
            Margin="22,0,22,18">

        <!-- 左：工具列表 -->
        <Border Grid.Column="0" Classes="panel" Padding="10,12">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0"
                       Classes="section"
                       Text="工具"
                       Margin="8,2,8,8" />

            <ScrollViewer Grid.Row="1">
              <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ToolGroupViewModel">
                    <StackPanel Margin="0,2,0,10">
                      <!-- 分类用文字标签，不再用 Expander：
                           Fluent 的 Expander 头自带深色底，和面板打架 -->
                      <TextBlock Text="{Binding Category}"
                                 FontSize="10"
                                 Foreground="{StaticResource TextMutedBrush}"
                                 Margin="8,0,8,4" />

                      <ItemsControl ItemsSource="{Binding Tools}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ToolItemViewModel">
                            <Button Tag="{Binding}"
                                    Click="OnToolClick"
                                    Classes="ghost"
                                    Classes.selected="{Binding IsSelected}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Padding="8,6"
                                    Margin="0,1">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <!-- 选中指示条：比整块高亮更克制 -->
                                <Border Width="2"
                                        Height="14"
                                        CornerRadius="1"
                                        Background="{StaticResource AccentBrush}"
                                        IsVisible="{Binding IsSelected}" />
                                <TextBlock Text="{Binding Name}"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                              </StackPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="1"
                       Text="正在加载插件…"
                       IsVisible="{Binding IsLoading}"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="12"
                       Margin="8,6" />
          </Grid>
        </Border>

        <!-- 中：输入 + 结果 -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto">
          <TextBlock Grid.Row="0"
                     Classes="section"
                     Text="输入"
                     Margin="2,0,0,8" />

          <TextBox Grid.Row="1"
                   Text="{Binding InputText, Mode=TwoWay}"
                   AcceptsReturn="True"
                   MinHeight="96"
                   MaxHeight="190"
                   PlaceholderText="{Binding InputHint}"
                   IsEnabled="{Binding IsTextInput}" />

          <Border Grid.Row="2"
                  Classes="panel"
                  Margin="0,14,0,0"
                  Padding="14">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Grid.Row="0"
                         Classes="section"
                         Text="结果"
                         Margin="0,0,0,10" />

              <ScrollViewer Grid.Row="1">
                <SelectableTextBlock Text="{Binding ResultText}"
                                     FontFamily="{StaticResource MonoFont}"
                                     FontSize="12.5"
                                     LineHeight="20"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     TextWrapping="Wrap" />
              </ScrollViewer>

              <!-- 空状态：不给一块纯黑 -->
              <TextBlock Grid.Row="1"
                         IsVisible="{Binding !HasResult}"
                         Text="执行后结果显示在这里"
                         FontSize="12"
                         Foreground="{StaticResource TextMutedBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Grid>
          </Border>

          <TextBlock Grid.Row="3"
                     Text="{Binding ErrorText}"
                     IsVisible="{Binding HasError}"
                     Foreground="{StaticResource DangerBrush}"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Margin="2,10,0,0" />
        </Grid>

        <!-- 右：参数 + 历史 -->
        <Border Grid.Column="2" Classes="panel" Padding="14">
          <ScrollViewer>
            <StackPanel Spacing="12">
              <TextBlock Classes="section" Text="参数" />

              <ItemsControl ItemsSource="{Binding Parameters}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ParameterViewModel">
                    <StackPanel Spacing="5" Margin="0,0,0,10">
                      <TextBlock Text="{Binding Label}"
                                 FontSize="12"
                                 Foreground="{StaticResource TextSecondaryBrush}" />

                      <ComboBox ItemsSource="{Binding Choices}"
                                SelectedItem="{Binding Value, Mode=TwoWay}"
                                IsVisible="{Binding IsChoice}"
                                HorizontalAlignment="Stretch" />

                      <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                IsVisible="{Binding IsToggle}" />

                      <TextBox Text="{Binding Value, Mode=TwoWay}"
                               IsVisible="{Binding IsText}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Height="1"
                      Background="{StaticResource LineBrush}"
                      Margin="0,4" />

              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="section"
                           Text="最近结果"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Classes="ghost small"
                        Content="清空"
                        Click="OnClearHistoryClick" />
              </Grid>

              <TextBox Text="{Binding HistoryQuery, Mode=TwoWay}"
                       PlaceholderText="搜索历史…"
                       FontSize="12" />

              <TextBlock Text="还没有执行记录"
                         IsVisible="{Binding !HasHistory}"
                         FontSize="11"
                         Foreground="{StaticResource TextMutedBrush}"
                         Margin="8,2" />

              <ItemsControl ItemsSource="{Binding Recent}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HistoryEntryViewModel">
                    <Button Tag="{Binding}"
                            Click="OnHistoryClick"
                            Classes="ghost"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="8,6"
                            Margin="0,1">
                      <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding ToolName}"
                                     FontSize="12"
                                     Foreground="{StaticResource TextPrimaryBrush}" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding TimeLabel}"
                                     FontSize="10"
                                     Foreground="{StaticResource TextMutedBrush}"
                                     Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Text="{Binding Preview}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Border>

      </Grid>

      <!-- 底部动作条：整屏只允许一个主按钮 -->
      <StackPanel Grid.Row="2"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8"
                  Margin="22,0,22,16">
        <Button Content="复制"
                IsEnabled="{Binding !IsExecuting}"
                Click="OnCopyClick" />
        <Button Classes="accent"
                Content="{Binding ExecuteLabel}"
                IsEnabled="{Binding !IsExecuting}"
                Click="OnExecuteClick" />
      </StackPanel>
    </Grid>

    <!-- 设置视图 -->
    <Grid IsVisible="{Binding IsSettingsVisible}" RowDefinitions="Auto,*">
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="22,18,22,10">
        <Button Grid.Column="0"
                Classes="ghost"
                Content="← 返回"
                Click="OnBackClick" />
        <TextBlock Grid.Column="1"
                   Text="设置"
                   FontFamily="{StaticResource DisplayFont}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Margin="14,0,0,0" />
      </Grid>

      <views:SettingsView Grid.Row="1" DataContext="{Binding Settings}" />
    </Grid>

  </Grid>
</Window>
