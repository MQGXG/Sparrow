<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sparrow.App.ViewModels"
        xmlns:views="using:Sparrow.App.Views"
        xmlns:converters="using:Sparrow.App.Converters"
        x:Class="Sparrow.App.Views.WorkspaceWindow"
        x:DataType="vm:WorkspaceViewModel"
        Title="Sparrow · 工具台"
        Width="1120"
        Height="730"
        RequestedThemeVariant="Dark"
        DragDrop.AllowDrop="True"
        Icon="avares://Sparrow.App/Assets/sparrow-32.png"
        MinWidth="920"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <Grid>

    <!-- 工作区主视图：顶栏 / 主体（分类导航 + 工具墙·工具台）/ 状态栏 -->
    <Grid IsVisible="{Binding !IsSettingsVisible}" RowDefinitions="Auto,Auto,*,Auto">

      <!-- 顶栏：品牌 + 搜索 + 设置 -->
      <Grid Grid.Column="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="24,16,24,12">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Image Source="avares://Sparrow.App/Assets/sparrow-32.png"
                 Width="22"
                 Height="22"
                 VerticalAlignment="Center" />
          <TextBlock Text="麻雀"
                     FontFamily="{StaticResource DisplayFont}"
                     FontSize="20"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Classes="num"
                     Text="工作台"
                     VerticalAlignment="Center"
                     Margin="6,2,0,0" />
        </StackPanel>

        <!-- 全局工具搜索：直接过滤工具墙 -->
        <TextBox Grid.Column="2"
                 Width="320"
                 IsVisible="{Binding !IsRecentOpen}"
                 Text="{Binding ToolQuery, Mode=TwoWay}"
                 PlaceholderText="搜索工具、描述或分类…"
                 FontSize="12"
                 Padding="10,6"
                 VerticalAlignment="Center" />

        <Button Grid.Column="3"
                Classes="small"
                Margin="12,0,0,0"
                Content="设置"
                Click="OnSettingsClick" />
      </Grid>

      <!-- 顶栏分隔线 -->
      <Border Grid.Row="1" Height="1" Margin="24,0,24,0" Background="{StaticResource LineBrush}" />

      <!-- 主体：墙态带分类侧栏；台态整宽 -->
      <Grid Grid.Row="2" Margin="24,16,24,16">
        <Grid IsVisible="{Binding !IsDetailOpen}" ColumnDefinitions="220,16,*">

        <!-- 左：分类导航 + 最近执行 -->
        <Border Grid.Column="0" Classes="panel" Padding="8">
          <Grid RowDefinitions="Auto,Auto,*">

            <!-- 一级导航：工具 / 最近使用 -->
            <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,12">
              <Button Click="OnShowToolsClick"
                      Classes="ghost"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Padding="8,7">
                <Grid ColumnDefinitions="Auto,*">
                  <Border Width="2"
                          Height="14"
                          CornerRadius="1"
                          Background="{StaticResource AccentBrush}"
                          IsVisible="{Binding IsToolsSelected}" />
                  <TextBlock Grid.Column="1"
                             Text="工具"
                             FontSize="13"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             IsVisible="{Binding IsToolsSelected}"
                             Margin="9,0,0,0"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1"
                             Text="工具"
                             FontSize="13"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             IsVisible="{Binding !IsToolsSelected}"
                             Margin="11,0,0,0"
                             VerticalAlignment="Center" />
                </Grid>
              </Button>

              <Button Click="OnShowRecentClick"
                      Classes="ghost"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Padding="8,7">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Width="2"
                          Height="14"
                          CornerRadius="1"
                          Background="{StaticResource AccentBrush}"
                          IsVisible="{Binding IsRecentOpen}" />
                  <TextBlock Grid.Column="1"
                             Text="最近使用"
                             FontSize="13"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             IsVisible="{Binding IsRecentOpen}"
                             Margin="9,0,0,0"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1"
                             Text="最近使用"
                             FontSize="13"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             IsVisible="{Binding !IsRecentOpen}"
                             Margin="11,0,0,0"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2"
                             Classes="num"
                             Text="{Binding Recent.Count}"
                             Margin="12,0,2,0"
                             VerticalAlignment="Center" />
                </Grid>
              </Button>
            </StackPanel>

            <TextBlock Grid.Row="1"
                       Classes="section"
                       Text="分类"
                       Margin="8,4,0,8" />

            <!-- 分类导航：一列分类，选中带琥珀书签条 -->
            <ScrollViewer Grid.Row="2">
              <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CategoryViewModel">
                    <Button Tag="{Binding}"
                            Click="OnCategoryClick"
                            Classes="ghost"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="8,6"
                            Margin="0,1">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- 琥珀书签条：分类导航的选中指示 -->
                        <Border Grid.Column="0"
                                Width="2"
                                Height="14"
                                CornerRadius="1"
                                Background="{StaticResource AccentBrush}"
                                IsVisible="{Binding IsSelected}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DisplayName}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   IsVisible="{Binding IsSelected}"
                                   Margin="9,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DisplayName}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   IsVisible="{Binding !IsSelected}"
                                   Margin="11,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Classes="num"
                                   Text="{Binding Count}"
                                   Margin="12,0,2,0"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

          <!-- 墙态：工具网格 -->
          <ScrollViewer Grid.Column="2" IsVisible="{Binding IsWallVisible}">
            <StackPanel>

              <!-- 工具网格：分类作为卡片标签，分类筛选交给侧栏 -->
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                <TextBlock Classes="section" Text="工具" />
                <TextBlock Grid.Column="1"
                           Classes="num"
                           Text="{Binding VisibleTools.Count, StringFormat='{}{0} 个'}" />
              </Grid>

              <ItemsControl ItemsSource="{Binding VisibleTools}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ToolItemViewModel">
                    <Button Tag="{Binding}"
                            Click="OnToolClick"
                            Classes="tool-card"
                            Width="236"
                            Height="152"
                            Margin="0,0,14,14"
                            Padding="16"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch">
                      <Grid RowDefinitions="Auto,*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                          <Border Width="40"
                                  Height="40"
                                  CornerRadius="10"
                                  Background="{StaticResource AccentSoftBrush}"
                                  VerticalAlignment="Center">
                            <Path Classes="icon"
                                  Width="20"
                                  Height="20"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="{Binding CategoryLabel, Converter={x:Static converters:IconGeometryConverter.Instance}}" />
                          </Border>
                          <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding CategoryDisplay}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}" />
                          </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   Text="{Binding Description}"
                                   Margin="0,10,0,0"
                                   FontSize="11"
                                   LineHeight="17"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   MaxLines="2" />

                        <TextBlock Grid.Row="2"
                                   Text="打开 →"
                                   HorizontalAlignment="Right"
                                   FontSize="10"
                                   Foreground="{StaticResource AccentBrush}" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- 墙空态 -->
              <TextBlock Text="没有匹配的工具"
                         IsVisible="{Binding IsToolListEmpty}"
                         FontSize="12"
                         Foreground="{StaticResource TextMutedBrush}"
                         HorizontalAlignment="Center"
                         Margin="0,40,0,0" />
            </StackPanel>
          </ScrollViewer>

          <!-- 最近使用页 -->
          <ScrollViewer Grid.Column="2" IsVisible="{Binding IsRecentVisible}">
            <StackPanel Spacing="18">

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="6">
                  <TextBlock Classes="title" Text="最近使用" />
                  <TextBlock Text="最近打开的工具，以及执行过的结果。点记录可复制结果。"
                             FontSize="12"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="ghost small"
                        Content="清空历史"
                        VerticalAlignment="Top"
                        IsEnabled="{Binding HasHistory}"
                        Click="OnClearHistoryClick" />
              </Grid>

              <!-- 最近工具 -->
              <StackPanel IsVisible="{Binding HasRecentTools}" Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="section" Text="最近工具" />
                  <TextBlock Grid.Column="1"
                             Classes="num"
                             Text="{Binding RecentTools.Count, StringFormat='{}{0} 个'}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding RecentTools}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RecentToolViewModel">
                      <Button Tag="{Binding}"
                              Click="OnRecentToolClick"
                              Classes="tool-card"
                              Width="236"
                              Height="104"
                              Margin="0,0,14,14"
                              Padding="14"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <Border Width="36"
                                  Height="36"
                                  CornerRadius="9"
                                  Background="{StaticResource AccentSoftBrush}"
                                  VerticalAlignment="Center">
                            <Path Classes="icon"
                                  Width="18"
                                  Height="18"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="{Binding Tool.CategoryLabel, Converter={x:Static converters:IconGeometryConverter.Instance}}" />
                          </Border>
                          <StackPanel Grid.Column="1"
                                      Spacing="3"
                                      Margin="12,0,0,0"
                                      VerticalAlignment="Center">
                            <TextBlock Text="{Binding Tool.Name}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="num"
                                       Text="{Binding TimeLabel}"
                                       FontSize="10" />
                          </StackPanel>
                          <TextBlock Grid.Column="2"
                                     Text="打开 →"
                                     FontSize="10"
                                     Foreground="{StaticResource AccentBrush}"
                                     VerticalAlignment="Center" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- 执行记录 -->
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="section" Text="执行记录" />
                  <TextBlock Grid.Column="1"
                             Classes="num"
                             Text="{Binding Recent.Count, StringFormat='{}{0} 条'}" />
                </Grid>

                <TextBlock Text="还没有执行记录。去工具墙跑一个工具试试。"
                           IsVisible="{Binding !HasHistory}"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,4,0,0" />

                <ItemsControl ItemsSource="{Binding Recent}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryEntryViewModel">
                      <Button Tag="{Binding}"
                              Click="OnHistoryClick"
                              Classes="ghost"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Padding="12,10"
                              Margin="0,1"
                              ToolTip.Tip="复制结果">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                          <StackPanel Spacing="3">
                            <TextBlock Text="{Binding ToolName}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Preview}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       MaxLines="1"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="1"
                                     Classes="num"
                                     Text="{Binding TimeLabel}"
                                     Margin="12,0,12,0"
                                     VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2"
                                     Text="复制"
                                     FontSize="10"
                                     Foreground="{StaticResource AccentBrush}"
                                     VerticalAlignment="Center" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- 台态：单个工具的工作区，占满整宽 -->
        <Grid IsVisible="{Binding IsDetailOpen}" RowDefinitions="Auto,Auto,Auto,Auto,*">

            <!-- 面包屑 + 工具头 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
              <Button Classes="ghost small"
                      Content="‹ 返回"
                      Click="OnBackToWallClick"
                      VerticalAlignment="Center" />

              <Path Classes="icon"
                    Width="18"
                    Height="18"
                    VerticalAlignment="Center"
                    Stroke="{StaticResource AccentBrush}"
                    Data="{Binding SelectedTool.CategoryLabel, Converter={x:Static converters:IconGeometryConverter.Instance}}" />

              <TextBlock Classes="title"
                         Text="{Binding SelectedTool.Name}"
                         VerticalAlignment="Center" />

              <Border Classes="chip" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedTool.CategoryDisplay}"
                           Classes="num" />
              </Border>
            </StackPanel>

            <TextBlock Grid.Row="1"
                       Classes="caption"
                       Text="{Binding SelectedTool.Description}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />

            <!-- 参数：行内控件，不占整栏 -->
            <StackPanel Grid.Row="2" IsVisible="{Binding HasParameters}" Margin="0,14,0,0">
              <TextBlock Classes="section" Text="参数" Margin="0,0,0,8" />

              <ItemsControl ItemsSource="{Binding Parameters}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ParameterViewModel">
                    <StackPanel Spacing="5" Margin="0,0,22,8">

                      <!-- 开关型：label 跟在开关后面 -->
                      <StackPanel Orientation="Horizontal"
                                  Spacing="8"
                                  IsVisible="{Binding IsToggle}">
                        <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Label}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                      </StackPanel>

                      <!-- 下拉 / 文本：label 在上 -->
                      <StackPanel Spacing="5" IsVisible="{Binding !IsToggle}">
                        <TextBlock Text="{Binding Label}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <ComboBox ItemsSource="{Binding Choices}"
                                  SelectedItem="{Binding Value, Mode=TwoWay}"
                                  IsVisible="{Binding IsChoice}"
                                  MinWidth="160"
                                  HorizontalAlignment="Left" />
                        <TextBox Text="{Binding Value, Mode=TwoWay}"
                                 IsVisible="{Binding IsText}"
                                 MinWidth="220"
                                 HorizontalAlignment="Left" />
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- 输入：文本工具给编辑框，图片/无输入工具给一条提示 -->
            <TextBox Grid.Row="3"
                     Text="{Binding InputText, Mode=TwoWay}"
                     AcceptsReturn="True"
                     MinHeight="64"
                     MaxHeight="170"
                     IsVisible="{Binding IsTextInput}"
                     PlaceholderText="{Binding InputHint}"
                     Margin="0,12,0,0"
                     VerticalContentAlignment="Top" />

            <Border Grid.Row="3"
                    IsVisible="{Binding !IsTextInput}"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,9"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Stretch">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding InputHint}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" />
                <Button Grid.Column="1"
                        Classes="ghost small"
                        Content="清除"
                        Margin="12,0,0,0"
                        IsVisible="{Binding CanClearDroppedImage}"
                        Click="OnClearDroppedImageClick" />
              </Grid>
            </Border>

            <!-- 结果：占满剩余高度 -->
            <Border Grid.Row="4"
                    Classes="panel"
                    Margin="0,14,0,0"
                    Padding="14">
              <Grid RowDefinitions="Auto,Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                  <TextBlock Classes="section" Text="结果" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding ResultSummary}"
                             IsVisible="{Binding HasResult}"
                             FontSize="11"
                             Foreground="{StaticResource TextMutedBrush}"
                             VerticalAlignment="Center" />
                </Grid>

                <!-- 错误：红色左边条 + 一行人话 -->
                <Border Grid.Row="1"
                        IsVisible="{Binding HasError}"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,8"
                        Margin="0,0,0,8">
                  <Grid ColumnDefinitions="Auto,*">
                    <Border Width="3"
                            Margin="0,2"
                            CornerRadius="1.5"
                            Background="{StaticResource DangerBrush}" />
                    <TextBlock Grid.Column="1"
                               Margin="10,0,0,0"
                               Text="{Binding ErrorText}"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                  </Grid>
                </Border>

                <!-- 结果内容 -->
                <ScrollViewer Grid.Row="2">
                  <SelectableTextBlock Text="{Binding ResultText}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="13"
                                       LineHeight="20"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" />
                </ScrollViewer>

                <!-- 空态：既没结果也没错误时才显示 -->
                <TextBlock Grid.Row="2"
                           IsVisible="{Binding IsResultEmpty}"
                           Text="执行后结果显示在这里"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Grid>
            </Border>
          </Grid>

      </Grid>

      <!-- 状态栏：左状态右动作 -->
      <StackPanel Grid.Row="3">
        <Border Height="1" Margin="24,0,24,0" Background="{StaticResource LineBrush}" />

        <Grid ColumnDefinitions="*,Auto" Margin="24,10,24,12">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Ellipse Width="6"
                     Height="6"
                     Fill="{StaticResource AccentBrush}"
                     VerticalAlignment="Center" />
            <TextBlock Text="就绪 · 本地引擎"
                       FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}"
                       IsVisible="{Binding !IsExecuting}"
                       VerticalAlignment="Center" />
            <TextBlock Text="执行中…"
                       FontSize="11"
                       Foreground="{StaticResource AccentBrush}"
                       IsVisible="{Binding IsExecuting}"
                       VerticalAlignment="Center" />
          </StackPanel>

          <!-- 墙态没有「当前工具输入/结果」，动作按钮会静默执行一个看不见的工具，直接藏起来 -->
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="8"
                      VerticalAlignment="Center"
                      IsVisible="{Binding IsDetailOpen}">
            <Button Content="复制"
                    IsEnabled="{Binding !IsExecuting}"
                    Click="OnCopyClick" />
            <Button Classes="accent"
                    Content="{Binding ExecuteLabel}"
                    IsEnabled="{Binding !IsExecuting}"
                    Click="OnExecuteClick" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Grid>

    <!-- 设置视图 -->
    <Grid IsVisible="{Binding IsSettingsVisible}" RowDefinitions="Auto,*">
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="24,16,24,8">
        <Button Grid.Column="0"
                Classes="ghost"
                Content="← 返回"
                Click="OnBackClick" />
        <TextBlock Grid.Column="1"
                   Classes="title"
                   Text="设置"
                   VerticalAlignment="Center"
                   Margin="12,0,0,0" />
      </Grid>

      <views:SettingsView Grid.Row="1" DataContext="{Binding Settings}" />
    </Grid>

  </Grid>
</Window>
