<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sparrow.App.ViewModels"
        xmlns:views="using:Sparrow.App.Views"
        xmlns:converters="using:Sparrow.App.Converters"
        x:Class="Sparrow.App.Views.WorkspaceWindow"
        x:DataType="vm:WorkspaceViewModel"
        Title="Sparrow · 工具台"
        Width="1120"
        Height="730"
        RequestedThemeVariant="Dark"
        DragDrop.AllowDrop="True"
        Icon="avares://Sparrow.App/Assets/sparrow-64.png"
        MinWidth="920"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <Panel>

    <!-- HUD 底纹：点阵图纸 + 窗角 45° 斜线，纯装饰层，不参与命中 -->
    <Border Background="{StaticResource DotGridBrush}" IsHitTestVisible="False" />
    <Path IsHitTestVisible="False"
          HorizontalAlignment="Right" VerticalAlignment="Top"
          Margin="0,72,200,0"
          Opacity="0.08"
          Stroke="{StaticResource AccentBrush}"
          StrokeThickness="1.5"
          Data="M0,44 L44,0 M14,44 L58,0 M28,44 L72,0" />
    <Path IsHitTestVisible="False"
          HorizontalAlignment="Left" VerticalAlignment="Bottom"
          Margin="200,0,0,72"
          Opacity="0.08"
          Stroke="{StaticResource AccentBrush}"
          StrokeThickness="1.5"
          Data="M0,44 L44,0 M14,44 L58,0 M28,44 L72,0" />

    <!-- 工作区主视图：顶栏 / 主体（工具墙·工具台） -->
    <Grid IsVisible="{Binding !IsSettingsVisible}" RowDefinitions="Auto,Auto,*">

      <!-- 顶栏：品牌 + 搜索 + 设置 -->
      <Grid Grid.Column="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="24,16,24,12">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Image Source="avares://Sparrow.App/Assets/sparrow-32.png"
                 Width="22"
                 Height="22"
                 VerticalAlignment="Center" />
          <TextBlock Text="麻雀"
                     FontFamily="{StaticResource DisplayFont}"
                     FontSize="20"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Classes="num"
                     Text="// 工具台"
                     VerticalAlignment="Center"
                     Margin="6,2,0,0" />
        </StackPanel>

        <!-- 全局工具搜索：直接过滤工具墙；最近页输入时自动回墙 -->
        <TextBox Grid.Column="2"
                 Width="320"
                 Text="{Binding ToolQuery, Mode=TwoWay}"
                 PlaceholderText="搜索工具、描述或分类…"
                 FontSize="12"
                 Padding="10,6"
                 VerticalAlignment="Center" />

        <Button Grid.Column="3"
                Classes="small"
                Margin="12,0,0,0"
                Content="设置"
                Click="OnSettingsClick" />
      </Grid>

      <!-- 顶栏分隔线 -->
      <Border Grid.Row="1" Height="1" Margin="24,0,24,0" Background="{StaticResource LineBrush}" />

      <!-- 主体：共享切换行 + 墙态 / 最近页 / 台态 -->
      <Grid Grid.Row="2" Margin="24,16,24,20" RowDefinitions="Auto,*">

        <!-- 切换行提到共享层：最近页也能切回工具墙（原先是卡死的根因） -->
        <Grid x:Name="WallTabRow"
              Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              Margin="0,0,0,16"
              IsVisible="{Binding !IsDetailOpen}">
          <StackPanel Orientation="Horizontal" Spacing="28">
            <Button Classes="hud-tab"
                    Classes.selected="{Binding IsToolsSelected}"
                    Click="OnShowToolsClick">
              <StackPanel>
                <TextBlock Text="工具" />
                <Border Classes="tick" />
              </StackPanel>
            </Button>
            <Button Classes="hud-tab"
                    Classes.selected="{Binding IsRecentOpen}"
                    Click="OnShowRecentClick">
              <StackPanel>
                <TextBlock Text="最近使用" />
                <Border Classes="tick" />
              </StackPanel>
            </Button>
            <Button Classes="hud-tab"
                    Classes.selected="{Binding IsClipboardOpen}"
                    Click="OnShowClipboardClick">
              <StackPanel>
                <TextBlock Text="剪贴板" />
                <Border Classes="tick" />
              </StackPanel>
            </Button>
          </StackPanel>

          <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      Spacing="7"
                      VerticalAlignment="Bottom"
                      IsVisible="{Binding IsToolsSelected}">
            <TextBlock Classes="stat"
                       Text="{Binding VisibleTools.Count}"
                       VerticalAlignment="Bottom" />
            <TextBlock Classes="num"
                       Text="TOOLS"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,3" />
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
          <Grid IsVisible="{Binding !IsDetailOpen}">

          <!-- 墙态：分类 chips + 大卡 + 分组工具网格 -->
          <ScrollViewer IsVisible="{Binding IsWallVisible}">
            <StackPanel>

              <!-- 分类 chips：横向筛选，选中亮琥珀 -->
              <ItemsControl ItemsSource="{Binding Categories}"
                            Margin="0,0,0,20"
                            IsVisible="{Binding IsToolsSelected}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CategoryViewModel">
                    <Button Tag="{Binding}"
                            Click="OnCategoryClick"
                            Classes="hud-chip"
                            Classes.selected="{Binding IsSelected}">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="{Binding DisplayName}" />
                        <TextBlock Classes="num" Text="{Binding Count}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- 分组工具网格：组标题可折叠；搜索时强制全展开 -->
              <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ToolGroupViewModel">
                    <StackPanel Margin="0,0,0,6">

                      <!-- 组标题：琥珀刻度 + 分类名 + 数量 + 折叠状态 -->
                      <Button Classes="group-header"
                              Tag="{Binding}"
                              Click="OnGroupHeaderClick"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Border Classes="hud-tick" />
                          <TextBlock Text="{Binding DisplayName}"
                                     FontSize="13"
                                     FontWeight="SemiBold"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     VerticalAlignment="Center" />
                          <TextBlock Classes="num"
                                     Text="{Binding Tools.Count}"
                                     Margin="4,0,0,0"
                                     VerticalAlignment="Center" />
                          <Path Classes="icon icon-xs"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Stroke="{DynamicResource TextMutedBrush}"
                                IsVisible="{Binding IsExpanded}"
                                Data="{StaticResource IconChevronDown}" />
                          <Path Classes="icon icon-xs"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Stroke="{DynamicResource TextMutedBrush}"
                                IsVisible="{Binding !IsExpanded}"
                                Data="{StaticResource IconChevronRight}" />
                        </StackPanel>
                      </Button>

                      <ItemsControl ItemsSource="{Binding Tools}"
                                    IsVisible="{Binding IsExpanded}"
                                    Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ToolItemViewModel">
                            <Button Tag="{Binding}"
                                    Click="OnToolClick"
                                    Classes="tool-card"
                                    Width="236"
                                    Height="136"
                                    Margin="0,0,16,16"
                                    Padding="0"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch">
                              <Panel>
                                <!-- 取景框四角标 -->
                                <Path Classes="frame" HorizontalAlignment="Left" VerticalAlignment="Top" Data="M0,11 L0,0 L11,0" />
                                <Path Classes="frame" HorizontalAlignment="Right" VerticalAlignment="Top" Data="M0,0 L11,0 L11,11" />
                                <Path Classes="frame" HorizontalAlignment="Left" VerticalAlignment="Bottom" Data="M0,0 L0,11 L11,11" />
                                <Path Classes="frame" HorizontalAlignment="Right" VerticalAlignment="Bottom" Data="M11,0 L11,11 L0,11" />

                                <Grid RowDefinitions="Auto,*,Auto" Margin="16">
                                  <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="40"
                                            Height="40"
                                            CornerRadius="2"
                                            Background="{StaticResource AccentSoftBrush}"
                                            VerticalAlignment="Center">
                                      <Path Classes="icon icon-lg"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="{Binding CategoryLabel, Converter={x:Static converters:IconGeometryConverter.Instance}}" />
                                    </Border>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                      <TextBlock Text="{Binding Name}"
                                                 FontSize="14"
                                                 FontWeight="SemiBold"
                                                 Foreground="{StaticResource TextPrimaryBrush}" />
                                      <TextBlock Text="{Binding CategoryDisplay}"
                                                 FontSize="11"
                                                 Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                  </StackPanel>

                                  <TextBlock Grid.Row="1"
                                             Text="{Binding Description}"
                                             Margin="0,10,0,0"
                                             FontSize="12"
                                             LineHeight="18"
                                             Foreground="{StaticResource TextSecondaryBrush}"
                                             TextWrapping="Wrap"
                                             MaxLines="2" />

                                  <TextBlock Grid.Row="2"
                                             Classes="hint"
                                             Text="打开 →"
                                             HorizontalAlignment="Right"
                                             FontSize="11"
                                             Foreground="{StaticResource AccentBrush}" />
                                </Grid>
                              </Panel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- 墙空态：取景框里的大号麻雀标记 -->
              <StackPanel IsVisible="{Binding IsToolListEmpty}"
                          HorizontalAlignment="Center"
                          Margin="0,64,0,32">
                <Panel Width="128" Height="128" HorizontalAlignment="Center">
                  <Path Stroke="{StaticResource LineStrongBrush}" StrokeThickness="2"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Data="M0,11 L0,0 L11,0" />
                  <Path Stroke="{StaticResource LineStrongBrush}" StrokeThickness="2"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Data="M0,0 L11,0 L11,11" />
                  <Path Stroke="{StaticResource LineStrongBrush}" StrokeThickness="2"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Data="M0,0 L0,11 L11,11" />
                  <Path Stroke="{StaticResource LineStrongBrush}" StrokeThickness="2"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Data="M11,0 L11,11 L0,11" />
                  <Image Source="avares://Sparrow.App/Assets/sparrow-64.png"
                         Width="56" Height="56"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Opacity="0.9" />
                </Panel>
                <TextBlock Text="{Binding EmptyToolMessage}"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="420"
                           Margin="0,20,0,0" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <!-- 最近使用页 -->
          <ScrollViewer IsVisible="{Binding IsRecentVisible}">
            <StackPanel Spacing="16">

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="6">
                  <TextBlock Classes="title" Text="最近使用" />
                  <TextBlock Text="最近打开的工具，以及执行过的结果。点记录可复制结果。"
                             FontSize="12"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="ghost small"
                        Content="清空历史"
                        VerticalAlignment="Top"
                        IsEnabled="{Binding HasHistory}"
                        Click="OnClearHistoryClick" />
              </Grid>

              <!-- 最近工具 -->
              <StackPanel IsVisible="{Binding HasRecentTools}" Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="section" Text="最近工具" />
                  <TextBlock Grid.Column="1"
                             Classes="num"
                             Text="{Binding RecentTools.Count, StringFormat='{}{0} 个'}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding RecentTools}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RecentToolViewModel">
                      <Button Tag="{Binding}"
                              Click="OnRecentToolClick"
                              Classes="tool-card"
                              Width="236"
                              Height="104"
                              Margin="0,0,16,16"
                              Padding="0"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch">
                        <Panel>
                          <!-- 取景框四角标 -->
                          <Path Classes="frame" HorizontalAlignment="Left" VerticalAlignment="Top" Data="M0,11 L0,0 L11,0" />
                          <Path Classes="frame" HorizontalAlignment="Right" VerticalAlignment="Top" Data="M0,0 L11,0 L11,11" />
                          <Path Classes="frame" HorizontalAlignment="Left" VerticalAlignment="Bottom" Data="M0,0 L0,11 L11,11" />
                          <Path Classes="frame" HorizontalAlignment="Right" VerticalAlignment="Bottom" Data="M11,0 L11,11 L0,11" />

                          <Grid ColumnDefinitions="Auto,*,Auto" Margin="16">
                            <Border Width="36"
                                    Height="36"
                                    CornerRadius="2"
                                    Background="{StaticResource AccentSoftBrush}"
                                    VerticalAlignment="Center">
                              <Path Classes="icon icon-md"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="{Binding Tool.CategoryLabel, Converter={x:Static converters:IconGeometryConverter.Instance}}" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        Spacing="3"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                              <TextBlock Text="{Binding Tool.Name}"
                                         FontSize="13"
                                         FontWeight="SemiBold"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock Classes="num"
                                         Text="{Binding TimeLabel}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Classes="hint"
                                       Text="打开 →"
                                       FontSize="11"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center" />
                          </Grid>
                        </Panel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- 执行记录 -->
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="section" Text="执行记录" />
                  <TextBlock Grid.Column="1"
                             Classes="num"
                             Text="{Binding Recent.Count, StringFormat='{}{0} 条'}" />
                </Grid>

                <TextBlock Text="还没有执行记录。去工具墙跑一个工具试试。"
                           IsVisible="{Binding !HasHistory}"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,4,0,0" />

                <ItemsControl ItemsSource="{Binding Recent}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryEntryViewModel">
                      <Button Tag="{Binding}"
                              Click="OnHistoryClick"
                              Classes="ghost"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Padding="12,10"
                              Margin="0,1"
                              ToolTip.Tip="复制结果">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                          <StackPanel Spacing="3">
                            <TextBlock Text="{Binding ToolName}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Preview}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       MaxLines="1"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="1"
                                     Classes="num"
                                     Text="{Binding TimeLabel}"
                                     Margin="12,0,12,0"
                                     VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2"
                                     Text="复制"
                                     FontSize="11"
                                     Foreground="{StaticResource AccentBrush}"
                                     VerticalAlignment="Center" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <!-- 剪贴板页：先只给列表，详情在单独的检视窗口里看 -->
          <Grid x:Name="ClipboardPage" IsVisible="{Binding IsClipboardVisible}">
            <Grid DataContext="{Binding Clipboard}">
              <!-- 左：搜索 / 反馈 / 筛选 / 队列 / 列表 -->
              <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="10">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto">
                  <TextBox x:Name="ClipboardSearchBox"
                           Text="{Binding Query, Mode=TwoWay}"
                           PlaceholderText="搜索内容、标签、来源…">
                    <TextBox.InnerLeftContent>
                      <Path Classes="icon icon-sm"
                            Data="{StaticResource IconSearch}" />
                    </TextBox.InnerLeftContent>
                  </TextBox>
                  <Button Grid.Column="1"
                          Classes="ghost small"
                          Width="30"
                          Padding="0"
                          Margin="8,0,0,0"
                          IsVisible="{Binding CanUndoDelete}"
                          ToolTip.Tip="撤销删除"
                          AutomationProperties.Name="撤销删除"
                          Click="OnClipboardUndoDeleteClick">
                    <Path Classes="icon icon-xs"
                          Data="{StaticResource IconUndo}" />
                  </Button>
                  <Button Grid.Column="2"
                          Classes="ghost small"
                          Width="30"
                          Padding="0"
                          Margin="8,0,0,0"
                          IsVisible="{Binding !IsClearConfirmVisible}"
                          ToolTip.Tip="清空全部历史"
                          AutomationProperties.Name="清空"
                          Click="OnClipboardClearClick">
                    <Path Classes="icon icon-xs"
                          Data="{StaticResource IconTrash}" />
                  </Button>
                  <!-- 危险确认保留文字：图标在这一步没有「确定要删」的语义 -->
                  <Button Grid.Column="2"
                          Classes="ghost small danger"
                          Content="确认清空"
                          Margin="8,0,0,0"
                          IsVisible="{Binding IsClearConfirmVisible}"
                          Click="OnClipboardClearConfirmClick" />
                  <Button Grid.Column="3"
                          Classes="ghost small"
                          Width="30"
                          Padding="0"
                          Margin="6,0,0,0"
                          IsVisible="{Binding IsClearConfirmVisible}"
                          ToolTip.Tip="取消"
                          AutomationProperties.Name="取消"
                          Click="OnClipboardClearCancelClick">
                    <Path Classes="icon icon-xs"
                          Data="{StaticResource IconClose}" />
                  </Button>
                </Grid>

                <!-- 统计归列表：条数 / 容量贴着搜索框，操作反馈在右 -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                  <TextBlock Classes="num"
                             Text="{Binding Summary}"
                             VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding StatusText}"
                             IsVisible="{Binding HasStatus}"
                             Margin="12,0,0,0"
                             FontSize="10"
                             Foreground="{StaticResource AccentBrush}"
                             VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto">
                  <ItemsControl ItemsSource="{Binding Kinds}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ClipboardFilterViewModel">
                        <Button Classes="hud-chip"
                                Margin="0,0,6,6"
                                Classes.selected="{Binding IsSelected}"
                                Tag="{Binding}"
                                Click="OnClipboardKindClick">
                          <TextBlock Text="{Binding Name}" />
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Button Grid.Column="1"
                          Classes="ghost small"
                          Content="{Binding ExclusionButtonLabel}"
                          IsEnabled="{Binding CanToggleExclusion}"
                          Margin="8,0,6,6"
                          VerticalAlignment="Top"
                          ToolTip.Tip="选中一个来源后，让它之后的复制不进历史"
                          Click="OnClipboardExclusionClick" />

                  <ComboBox Grid.Column="2"
                            ItemsSource="{Binding SourceFilters}"
                            SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                            MinWidth="118"
                            Margin="0,0,0,6"
                            VerticalAlignment="Top" />
                </Grid>

                <ItemsControl Grid.Row="3"
                              ItemsSource="{Binding TagFilters}"
                              IsVisible="{Binding HasTagFilters}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ClipboardFilterViewModel">
                      <Button Classes="hud-chip"
                              Margin="0,0,6,6"
                              Classes.selected="{Binding IsSelected}"
                              Tag="{Binding}"
                              Click="OnClipboardTagFilterClick">
                        <TextBlock Text="{Binding Name}" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="4"
                        IsVisible="{Binding HasQueue}"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,8">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border Classes="hud-tick" Height="11" />
                        <TextBlock Text="粘贴队列"
                                   Classes="section"
                                   VerticalAlignment="Center" />
                      </StackPanel>

                      <ScrollViewer Grid.Column="1"
                                    Margin="10,0"
                                    VerticalScrollBarVisibility="Disabled"
                                    HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Queue}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ClipboardQueueItemViewModel">
                              <Button Classes="hud-chip"
                                      Content="{Binding Label}"
                                      Tag="{Binding}"
                                      ToolTip.Tip="点击移出队列"
                                      Click="OnClipboardQueueRemoveClick" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>

                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <Button Classes="ghost small"
                                Content="复制下一条"
                                ToolTip.Tip="写入剪贴板，自己在目标应用按 Ctrl+V"
                                Click="OnClipboardCopyNextClick" />
                        <Button Classes="ghost small"
                                Content="清空"
                                Click="OnClipboardQueueClearClick" />
                      </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding QueueHint}"
                               Margin="8,0,0,0"
                               FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}" />
                  </StackPanel>
                </Border>

                <Border Grid.Row="5"
                        Classes="panel"
                        Padding="4">
                  <Grid>
                    <ScrollViewer IsVisible="{Binding HasItems}">
                      <!-- 虚拟化：Rows 是「分组头 + 条目」拍平后的集合，只实现视口内的行 -->
                      <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.DataTemplates>
                          <!-- 分组头：琥珀刻度 + 标题 + 发丝线 + 条数 -->
                          <DataTemplate DataType="vm:ClipboardGroupViewModel"
                                        x:DataType="vm:ClipboardGroupViewModel">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="8,6,8,4">
                              <Border Classes="hud-tick" Height="10" />
                              <TextBlock Grid.Column="1"
                                         Text="{Binding Title}"
                                         FontSize="10"
                                         FontWeight="SemiBold"
                                         LetterSpacing="0.8"
                                         Margin="6,0,0,0"
                                         VerticalAlignment="Center"
                                         Foreground="{StaticResource TextMutedBrush}" />
                              <Border Grid.Column="2"
                                      Classes="hud-line"
                                      Margin="10,0"
                                      VerticalAlignment="Center" />
                              <TextBlock Grid.Column="3"
                                         Classes="num"
                                         Text="{Binding Items.Count}"
                                         VerticalAlignment="Center" />
                            </Grid>
                          </DataTemplate>

                          <!-- 条目 -->
                          <DataTemplate DataType="vm:ClipboardEntryViewModel"
                                        x:DataType="vm:ClipboardEntryViewModel">
                            <Border Margin="2,1"
                                    Padding="8,7"
                                    CornerRadius="8"
                                    Background="Transparent"
                                    Cursor="Hand"
                                    Classes="clip-row"
                                    Classes.selected="{Binding IsSelected}"
                                    Tag="{Binding}"
                                    Loaded="OnClipboardRowLoaded"
                                    Tapped="OnClipboardItemClick"
                                    DoubleTapped="OnClipboardItemDoubleTapped"
                                    PointerPressed="OnClipboardItemPointerPressed"
                                    PointerMoved="OnClipboardItemPointerMoved"
                                    PointerReleased="OnClipboardItemPointerReleased">
                              <Border.Styles>
                                <Style Selector="Border.clip-row:pointerover">
                                  <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                                </Style>
                                <Style Selector="Border.clip-row.selected">
                                  <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                </Style>
                                <!-- 行内动作平时压暗，hover / 选中才提亮 -->
                                <Style Selector="Border.clip-row Button.row-action">
                                  <Setter Property="Opacity" Value="0.5" />
                                  <Setter Property="Transitions">
                                    <Transitions>
                                      <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                                    </Transitions>
                                  </Setter>
                                </Style>
                                <Style Selector="Border.clip-row:pointerover Button.row-action">
                                  <Setter Property="Opacity" Value="1" />
                                </Style>
                                <Style Selector="Border.clip-row.selected Button.row-action">
                                  <Setter Property="Opacity" Value="1" />
                                </Style>
                                <!-- 和快取面板一致：悬停时图标转琥珀 -->
                                <Style Selector="Border.clip-row Button.row-action:pointerover Path.icon">
                                  <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                </Style>
                              </Border.Styles>
                              <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                                <!-- 选中标记：左侧 2px 琥珀竖条 -->
                                <Border Width="2"
                                        Height="24"
                                        CornerRadius="1"
                                        Background="{StaticResource AccentBrush}"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding IsSelected}" />

                                <Border Grid.Column="1"
                                        Width="38"
                                        Height="38"
                                        CornerRadius="6"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        ClipToBounds="True">
                                  <Panel>
                                    <Path Classes="icon icon-sm"
                                          Data="{StaticResource IconLink}"
                                          IsVisible="{Binding IsLink}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                    <Path Classes="icon icon-sm"
                                          Data="{StaticResource IconText}"
                                          IsVisible="{Binding IsTextKind}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                    <Path Classes="icon icon-sm"
                                          Data="{StaticResource IconImage}"
                                          IsVisible="{Binding IsImageKind}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                    <!-- 文件条目优先用系统真图标，取不到才画类型线框 -->
                                    <Path Classes="icon icon-sm"
                                          Data="{StaticResource IconFile}"
                                          IsVisible="{Binding ShowFileKindIcon}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                    <Image Source="{Binding FileIconPng, Converter={x:Static converters:ByteArrayToBitmapConverter.Instance}}"
                                           IsVisible="{Binding HasFileIcon}"
                                           Stretch="Uniform"
                                           Margin="4" />
                                    <Image Source="{Binding ThumbnailPath, Converter={x:Static converters:ByteArrayToBitmapConverter.Instance}, ConverterParameter=thumb}"
                                           Stretch="UniformToFill"
                                           IsVisible="{Binding HasThumbnail}" />
                                  </Panel>
                                </Border>

                                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Preview}"
                                             FontSize="12"
                                             TextTrimming="CharacterEllipsis"
                                             Foreground="{StaticResource TextPrimaryBrush}" />
                                  <TextBlock Text="{Binding TagLine}"
                                             FontSize="10"
                                             TextTrimming="CharacterEllipsis"
                                             Foreground="{StaticResource AccentBrush}"
                                             IsVisible="{Binding HasTags}" />
                                  <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding TimeLabel}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="·"
                                               FontSize="10"
                                               IsVisible="{Binding HasSource}"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                    <!--
                                      来源用图标而不是文字：这一行右边还挤着 6 个常驻按钮，
                                      文字来源会把预览挤没。拿不到真图标时回退到进程名首字母。
                                    -->
                                    <Panel Width="14"
                                           Height="14"
                                           IsVisible="{Binding HasSource}"
                                           ToolTip.Tip="{Binding SourceLabel}">
                                      <Border Background="{StaticResource SurfaceRaisedBrush}"
                                              BorderBrush="{StaticResource LineBrush}"
                                              BorderThickness="1"
                                              CornerRadius="3"
                                              IsVisible="{Binding !HasSourceIcon}">
                                        <TextBlock Text="{Binding SourceInitial}"
                                                   FontSize="8"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                      </Border>
                                      <Image Source="{Binding SourceIconPng, Converter={x:Static converters:ByteArrayToBitmapConverter.Instance}}"
                                             IsVisible="{Binding HasSourceIcon}"
                                             Stretch="Uniform"
                                             Margin="1" />
                                    </Panel>
                                  </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="3"
                                        Classes="ghost small"
                                        Width="30"
                                        Height="26"
                                        Padding="0"
                                        ToolTip.Tip="查看详情（也可以双击这一行）"
                                        AutomationProperties.Name="查看详情"
                                        Tag="{Binding}"
                                        Click="OnClipboardOpenDetailClick">
                                  <Path Classes="icon icon-xs"
                                        Data="{StaticResource IconEye}" />
                                </Button>

                                <Button Grid.Column="4"
                                        Classes="ghost small row-action"
                                        Width="26"
                                        Height="26"
                                        Padding="0"
                                        ToolTip.Tip="复制"
                                        AutomationProperties.Name="复制"
                                        Tag="{Binding}"
                                        Click="OnClipboardRowCopyClick">
                                  <Path Classes="icon icon-xs"
                                        Data="{StaticResource IconCopy}" />
                                </Button>

                                <Button Grid.Column="5"
                                        Classes="ghost small row-action"
                                        Width="26"
                                        Height="26"
                                        Padding="0"
                                        IsVisible="{Binding CanOpen}"
                                        ToolTip.Tip="用默认程序打开"
                                        AutomationProperties.Name="打开"
                                        Tag="{Binding}"
                                        Click="OnClipboardRowOpenClick">
                                  <Path Classes="icon icon-xs"
                                        Data="{StaticResource IconOpen}" />
                                </Button>

                                <Button Grid.Column="6"
                                        Classes="ghost small row-action"
                                        Width="26"
                                        Height="26"
                                        Padding="0"
                                        ToolTip.Tip="加入 / 移出顺序粘贴队列（Ctrl+点击整行也可以）"
                                        AutomationProperties.Name="顺序粘贴队列"
                                        Tag="{Binding}"
                                        Click="OnClipboardQueueToggleClick">
                                  <TextBlock Classes="num"
                                             Text="{Binding QueueBadge}"
                                             FontSize="11"
                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                </Button>

                                <Button Grid.Column="7"
                                        Classes="ghost small row-action"
                                        Width="26"
                                        Height="26"
                                        Padding="0"
                                        ToolTip.Tip="收藏 / 取消收藏"
                                        AutomationProperties.Name="收藏"
                                        Tag="{Binding}"
                                        Click="OnClipboardFavoriteClick">
                                  <Path Classes="icon icon-xs star"
                                        Classes.favorite="{Binding IsFavorite}"
                                        Data="{StaticResource IconStar}" />
                                </Button>

                                <Button Grid.Column="8"
                                        Classes="ghost small row-action"
                                        Width="26"
                                        Height="26"
                                        Padding="0"
                                        ToolTip.Tip="删除（可撤销）"
                                        AutomationProperties.Name="删除"
                                        Tag="{Binding}"
                                        Click="OnClipboardRowDeleteClick">
                                  <Path Classes="icon icon-xs"
                                        Data="{StaticResource IconTrash}" />
                                </Button>
                              </Grid>
                            </Border>
                                  </DataTemplate>
                        </ItemsControl.DataTemplates>
                      </ItemsControl>
                    </ScrollViewer>

                    <StackPanel IsVisible="{Binding IsEmpty}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                      <TextBlock Text="剪贴板还是空的"
                                 HorizontalAlignment="Center"
                                 FontSize="12"
                                 Foreground="{StaticResource TextSecondaryBrush}" />
                      <TextBlock Text="复制点什么，这里会按时间自动分叠"
                                 HorizontalAlignment="Center"
                                 FontSize="10"
                                 Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>

            </Grid>

            <!-- 剪贴板详情覆盖层：和快捷键面板一致，不再开独立窗口 -->
            <Panel x:Name="ClipboardDetailLayer"
                   IsVisible="False"
                   DataContext="{Binding Clipboard}">
              <Border Background="#CC07090B"
                      PointerPressed="OnClipboardDetailBackdropPressed" />
              <Border Margin="10"
                      CornerRadius="10"
                      BorderBrush="{StaticResource LineStrongBrush}"
                      BorderThickness="1"
                      ClipToBounds="True"
                      Background="{StaticResource WindowBgGradientBrush}">
                <views:ClipboardDetailView x:Name="ClipboardDetailViewHost"
                                           CloseRequested="OnClipboardDetailCloseRequested"
                                           Copied="OnClipboardDetailCopied" />
              </Border>
            </Panel>
          </Grid>
        </Grid>

        <!-- 台态：单个工具的工作区，占满整宽 -->
        <Grid IsVisible="{Binding IsDetailOpen}" RowDefinitions="Auto,Auto,Auto,*">

            <!-- 面包屑 + 工具头：动作按钮放右侧，紧贴当前工具 -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="ghost small"
                        Click="OnBackToWallClick"
                        VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="3">
                    <Path Classes="icon icon-xs"
                          Data="{StaticResource IconChevronLeft}" />
                    <TextBlock Text="返回" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>

                <Path Classes="icon icon-md"
                      VerticalAlignment="Center"
                      Stroke="{DynamicResource AccentBrush}"
                      Data="{Binding SelectedTool.CategoryLabel, Converter={x:Static converters:IconGeometryConverter.Instance}}" />

                <TextBlock Classes="title"
                           Text="{Binding SelectedTool.Name}"
                           VerticalAlignment="Center" />

                <Border Classes="chip" VerticalAlignment="Center">
                  <TextBlock Text="{Binding SelectedTool.CategoryDisplay}"
                             Classes="num" />
                </Border>
              </StackPanel>

              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="8"
                          VerticalAlignment="Center">
                <Button Content="保存"
                        ToolTip.Tip="把图片结果保存为文件"
                        IsVisible="{Binding HasImageResult}"
                        IsEnabled="{Binding !IsExecuting}"
                        Click="OnSaveResultClick" />
                <Button Classes="ghost"
                        Width="32"
                        Padding="0"
                        ToolTip.Tip="{Binding CopyAllHint}"
                        AutomationProperties.Name="复制全部结果"
                        IsEnabled="{Binding !IsExecuting}"
                        Click="OnCopyClick">
                  <Path Classes="icon icon-xs"
                        Data="{StaticResource IconCopy}" />
                </Button>
                <Button Classes="accent"
                        Content="{Binding ExecuteLabel}"
                        ToolTip.Tip="执行当前工具"
                        IsEnabled="{Binding !IsExecuting}"
                        Click="OnExecuteClick" />
              </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1"
                       Classes="caption"
                       Text="{Binding SelectedTool.Description}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />

            <!-- 参数：行内控件，不占整栏 -->
            <StackPanel Grid.Row="2" IsVisible="{Binding HasParameters}" Margin="0,12,0,0">
              <TextBlock Classes="section" Text="参数" Margin="0,0,0,6" />

              <ItemsControl ItemsSource="{Binding Parameters}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ParameterViewModel">
                    <StackPanel Spacing="5" Margin="0,0,24,8">

                      <!-- 开关型：label 跟在开关后面 -->
                      <StackPanel Orientation="Horizontal"
                                  Spacing="8"
                                  IsVisible="{Binding IsToggle}">
                        <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Label}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                      </StackPanel>

                      <!-- 下拉 / 文本：label 在上 -->
                      <StackPanel Spacing="5" IsVisible="{Binding !IsToggle}">
                        <TextBlock Text="{Binding Label}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <ComboBox ItemsSource="{Binding Choices}"
                                  SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                  IsVisible="{Binding IsChoice}"
                                  MinWidth="140"
                                  HorizontalAlignment="Left">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ParameterChoice">
                              <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox Text="{Binding Value, Mode=TwoWay}"
                                 IsVisible="{Binding IsText}"
                                 PlaceholderText="{Binding Hint}"
                                 Classes.multiline="{Binding IsMultiline}"
                                 MinWidth="220"
                                 HorizontalAlignment="Left" />
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- 左右分栏：左输入 / 右结果 -->
            <Grid Grid.Row="3"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="16"
                  Margin="0,12,0,0">
              <Panel Grid.Column="0">

                <!-- 输入：文本工具给编辑框，图片/无输入工具给一条提示 -->
                <TextBox Text="{Binding InputText, Mode=TwoWay}"
                         AcceptsReturn="True"
                         MinHeight="64"
                         IsVisible="{Binding IsTextInput}"
                         PlaceholderText="{Binding InputHint}"
                         VerticalContentAlignment="Top" />

            <Border IsVisible="{Binding !IsTextInput}"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    HorizontalAlignment="Stretch">
              <Grid RowDefinitions="*,Auto,Auto,Auto" RowSpacing="8">
                <!-- 当前图：原图按比例铺满，左右箭头切换 -->
                <Panel Grid.Row="0" IsVisible="{Binding IsImagesInput}">
                  <!-- Viewbox 负责缩放；Canvas 用原图尺寸，框坐标直接用原图像素 -->
                  <Viewbox Stretch="Uniform">
                    <Canvas Width="{Binding CurrentImage.Input.Width}"
                            Height="{Binding CurrentImage.Input.Height}">
                      <Image Source="{Binding CurrentImage.PreviewBytes, Converter={x:Static converters:ByteArrayToBitmapConverter.Instance}, ConverterParameter=preview}"
                             Width="{Binding CurrentImage.Input.Width}"
                             Height="{Binding CurrentImage.Input.Height}"
                             Stretch="Fill"
                             Cursor="Hand"
                             ToolTip.Tip="点击全屏查看"
                             Tag="{Binding CurrentImage}"
                             Tapped="OnPreviewInputImageClick" />

                      <!-- 识别框画在当前图对应的那段结果上 -->
                      <ItemsControl Canvas.Left="0"
                                    Canvas.Top="0"
                                    Width="{Binding CurrentImage.Input.Width}"
                                    Height="{Binding CurrentImage.Input.Height}"
                                    ItemsSource="{Binding CurrentSection.Lines}"
                                    IsVisible="{Binding CurrentSection.ShowBoxes}">
                        <ItemsControl.Styles>
                          <Style Selector="Rectangle.box">
                            <!-- 透明而不是不填：Shape 没有 Fill 区域就不参与命中，点框就失效了。
                                 画刷必须用 DynamicResource——控件级 Styles 里 StaticResource
                                 拿不到 App 级资源，会在窗口构造时抛 KeyNotFound。 -->
                            <Setter Property="Fill" Value="Transparent" />
                            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="StrokeThickness" Value="2" />
                          </Style>
                          <Style Selector="Rectangle.box.selected">
                            <!-- 选中靠边框变粗 + 虚线，不再用填充色，避免盖住图片内容 -->
                            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="StrokeThickness" Value="3" />
                            <Setter Property="StrokeDashArray" Value="4,2" />
                          </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <Canvas />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <!-- Canvas 只认直接子元素，而条目外面还有一层 ContentPresenter；
                                 改用 TranslateTransform 定位，绕开附加属性的容器限制 -->
                            <Rectangle Classes="box"
                                       Classes.selected="{Binding IsSelected}"
                                       Width="{Binding Width}"
                                       Height="{Binding Height}"
                                       Stroke="{StaticResource AccentBrush}"
                                       StrokeThickness="2"
                                       Cursor="Hand"
                                       ToolTip.Tip="点击选中 / 取消，选中后可一起复制"
                                       Tapped="OnOcrBoxTapped">
                              <Rectangle.RenderTransform>
                                <TranslateTransform X="{Binding X}" Y="{Binding Y}" />
                              </Rectangle.RenderTransform>
                            </Rectangle>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Canvas>
                  </Viewbox>

                  <Button Classes="ghost"
                          Width="28"
                          Height="28"
                          Padding="0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          IsEnabled="{Binding CanGoPreviousImage}"
                          ToolTip.Tip="上一张"
                          AutomationProperties.Name="上一张"
                          Click="OnPreviousImageClick">
                    <Path Classes="icon icon-xs"
                          Data="{StaticResource IconChevronLeft}" />
                  </Button>

                  <Button Classes="ghost"
                          Width="28"
                          Height="28"
                          Padding="0"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          IsEnabled="{Binding CanGoNextImage}"
                          ToolTip.Tip="下一张"
                          AutomationProperties.Name="下一张"
                          Click="OnNextImageClick">
                    <Path Classes="icon icon-xs"
                          Data="{StaticResource IconChevronRight}" />
                  </Button>

                  <Button Classes="ghost small"
                          Width="24"
                          Padding="0"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          Margin="2"
                          ToolTip.Tip="移除当前这张"
                          AutomationProperties.Name="移除当前这张"
                          IsVisible="{Binding HasInputImages}"
                          Click="OnRemoveCurrentImageClick">
                    <Path Classes="icon icon-xs"
                          Data="{StaticResource IconClose}" />
                  </Button>
                </Panel>

                <!-- 计数 -->
                <TextBlock Grid.Row="1"
                           Text="{Binding ImageCounter}"
                           IsVisible="{Binding IsImagesInput}"
                           HorizontalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}" />

                <!-- 小缩略图条：点哪张跳哪张 -->
                <ScrollViewer Grid.Row="2"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              IsVisible="{Binding IsImagesInput}">
                  <ItemsControl x:Name="InputImagesStrip"
                                ItemsSource="{Binding InputImages}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:InputImageViewModel">
                        <Border Width="52"
                                Height="36"
                                CornerRadius="4"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                ClipToBounds="True"
                                Cursor="Hand"
                                ToolTip.Tip="{Binding Name}"
                                Tag="{Binding}"
                                Tapped="OnSelectImageClick">
                          <Image Source="{Binding PreviewBytes, Converter={x:Static converters:ByteArrayToBitmapConverter.Instance}, ConverterParameter=preview}"
                                 Stretch="UniformToFill" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding InputHint}"
                             VerticalAlignment="Center"
                             TextWrapping="Wrap"
                             FontSize="12"
                             Foreground="{StaticResource TextMutedBrush}" />
                  <StackPanel Grid.Column="1"
                              Orientation="Horizontal"
                              Spacing="8"
                              Margin="12,0,0,0">
                    <!-- 选中若干识别框后才出现：一次复制多行 -->
                    <Button Classes="ghost small"
                            Content="{Binding CurrentSection.SelectionLabel}"
                            IsVisible="{Binding CurrentSection.HasSelection, FallbackValue=False}"
                            ToolTip.Tip="把选中的识别框按顺序复制"
                            Click="OnCopySelectionClick" />
                    <Button x:Name="ChooseImagesButton"
                            Classes="ghost small"
                            Width="28"
                            Padding="0"
                            ToolTip.Tip="添加图片…（可多选）"
                            AutomationProperties.Name="添加图片"
                            IsVisible="{Binding IsImagesInput}"
                            Click="OnChooseImagesClick">
                      <Path Classes="icon icon-xs"
                            Data="{StaticResource IconPlus}" />
                    </Button>
                    <Button Classes="ghost small"
                            Width="28"
                            Padding="0"
                            ToolTip.Tip="粘贴剪贴板里的图片"
                            AutomationProperties.Name="粘贴剪贴板"
                            IsVisible="{Binding IsImagesInput}"
                            Click="OnPasteImageClick">
                      <Path Classes="icon icon-xs"
                            Data="{StaticResource IconPaste}" />
                    </Button>
                    <Button x:Name="ChooseFilesButton"
                            Classes="ghost small"
                            Width="28"
                            Padding="0"
                            ToolTip.Tip="选择文件…"
                            AutomationProperties.Name="选择文件"
                            IsVisible="{Binding IsFilesInput}"
                            Click="OnChooseFilesClick">
                      <Path Classes="icon icon-xs"
                            Data="{StaticResource IconFile}" />
                    </Button>
                    <Button Classes="ghost small"
                            Width="28"
                            Padding="0"
                            ToolTip.Tip="清除已添加的图片"
                            AutomationProperties.Name="清除图片"
                            IsVisible="{Binding CanClearInputImages}"
                            Click="OnClearInputImagesClick">
                      <Path Classes="icon icon-xs"
                            Data="{StaticResource IconTrash}" />
                    </Button>
                    <Button Classes="ghost small"
                            Width="28"
                            Padding="0"
                            ToolTip.Tip="清除拖入的图片"
                            AutomationProperties.Name="清除拖入图片"
                            IsVisible="{Binding CanClearDroppedImage}"
                            Click="OnClearDroppedImageClick">
                      <Path Classes="icon icon-xs"
                            Data="{StaticResource IconTrash}" />
                    </Button>
                    <Button Classes="ghost small"
                            Width="28"
                            Padding="0"
                            ToolTip.Tip="清除拖入的文件"
                            AutomationProperties.Name="清除拖入文件"
                            IsVisible="{Binding CanClearDroppedFiles}"
                            Click="OnClearDroppedFilesClick">
                      <Path Classes="icon icon-xs"
                            Data="{StaticResource IconTrash}" />
                    </Button>
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>

              </Panel>

              <!-- 结果：右栏 -->
              <Border Grid.Column="1"
                      Classes="panel"
                      Padding="16">
              <Grid RowDefinitions="Auto,Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,10">
                  <TextBlock Classes="section" Text="结果" />

                  <!-- 多图时才有：只看当前这张 / 看全部 -->
                  <StackPanel Grid.Column="1"
                              Orientation="Horizontal"
                              Spacing="4"
                              Margin="0,0,12,0"
                              IsVisible="{Binding CanSwitchSectionView}">
                    <Button Classes="ghost small"
                            Classes.selected="{Binding IsCurrentSectionView}"
                            Content="当前这张"
                            ToolTip.Tip="只显示左侧当前图片的识别结果"
                            Click="OnShowCurrentSectionClick" />
                    <Button Classes="ghost small"
                            Classes.selected="{Binding ShowAllSections}"
                            Content="全部"
                            ToolTip.Tip="显示所有图片的识别结果"
                            Click="OnShowAllSectionsClick" />
                  </StackPanel>

                  <StackPanel Grid.Column="2"
                              Orientation="Horizontal"
                              Spacing="4"
                              Margin="0,0,12,0"
                              IsVisible="{Binding HasSvgResult}">
                    <Button Classes="ghost small"
                            Classes.selected="{Binding IsSvgPreviewVisible}"
                            Content="预览"
                            Click="OnSvgPreviewClick" />
                    <Button Classes="ghost small"
                            Classes.selected="{Binding IsSvgSourceVisible}"
                            Content="源码"
                            Click="OnSvgSourceClick" />
                  </StackPanel>

                  <TextBlock Grid.Column="3"
                             Text="{Binding ResultSummary}"
                             IsVisible="{Binding HasResult}"
                             FontSize="11"
                             Foreground="{StaticResource TextMutedBrush}"
                             VerticalAlignment="Center" />
                </Grid>

                <!-- 错误：红色左边条 + 一行人话 -->
                <Border Grid.Row="1"
                        IsVisible="{Binding HasError}"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8"
                        Margin="0,0,0,8">
                  <Grid ColumnDefinitions="Auto,*">
                    <Border Width="3"
                            Margin="0,2"
                            CornerRadius="1.5"
                            Background="{StaticResource DangerBrush}" />
                    <TextBlock Grid.Column="1"
                               Margin="10,0,0,0"
                               Text="{Binding ErrorText}"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                  </Grid>
                </Border>

                <!-- 多图识别：分段列表，每段能对上是哪张图 -->
                <ScrollViewer Grid.Row="2" IsVisible="{Binding HasSections}">
                  <ItemsControl ItemsSource="{Binding VisibleSections}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TextSectionViewModel">
                        <Border Margin="0,0,0,8"
                                Padding="12,10"
                                CornerRadius="8"
                                Background="{StaticResource SurfaceRaisedBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1">
                          <StackPanel Spacing="6">
                            <!-- 标题行：名称 + 框开关 + 复制本条 + 展开 -->
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
                              <TextBlock Text="{Binding Title}"
                                         VerticalAlignment="Center"
                                         FontSize="12"
                                         FontWeight="SemiBold"
                                         TextTrimming="CharacterEllipsis"
                                         Foreground="{StaticResource TextPrimaryBrush}" />

                              <Button Grid.Column="1"
                                      Classes="ghost small"
                                      Classes.selected="{Binding ShowBoxes}"
                                      Width="24"
                                      Padding="0"
                                      IsVisible="{Binding HasLines}"
                                      ToolTip.Tip="显示 / 隐藏识别框（会切到这张图）"
                                      AutomationProperties.Name="识别框"
                                      Tag="{Binding}"
                                      Click="OnToggleSectionBoxesClick">
                                <Path Classes="icon icon-xs"
                                      Data="{StaticResource IconEye}" />
                              </Button>

                              <Button Grid.Column="2"
                                      Classes="ghost small"
                                      Width="24"
                                      Padding="0"
                                      ToolTip.Tip="只复制这一条识别结果"
                                      AutomationProperties.Name="复制这一条"
                                      IsVisible="{Binding !IsFailed}"
                                      Tag="{Binding}"
                                      Click="OnCopySectionClick">
                                <Path Classes="icon icon-xs"
                                      Data="{StaticResource IconCopy}" />
                              </Button>

                              <Button Grid.Column="3"
                                      Classes="ghost small"
                                      Width="24"
                                      Padding="0"
                                      ToolTip.Tip="展开 / 折叠"
                                      AutomationProperties.Name="展开"
                                      Tag="{Binding}"
                                      Click="OnToggleSectionClick">
                                <Path Classes="icon icon-xs"
                                      Data="{StaticResource IconChevronDown}" />
                              </Button>
                            </Grid>

                            <!-- 折叠态：一行摘要 -->
                            <SelectableTextBlock Text="{Binding Preview}"
                                                 IsVisible="{Binding !IsExpanded}"
                                                 FontSize="12"
                                                 TextWrapping="Wrap"
                                                 Foreground="{StaticResource TextSecondaryBrush}" />

                            <!-- 展开态：全文（原图和识别框看左侧轮播，右侧不重复显示图片） -->
                            <StackPanel IsVisible="{Binding IsExpanded}" Spacing="8">
                              <SelectableTextBlock Text="{Binding Text}"
                                                   IsVisible="{Binding !IsFailed}"
                                                   FontSize="12"
                                                   LineHeight="18"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />

                              <TextBlock Text="{Binding Body}"
                                         IsVisible="{Binding IsFailed}"
                                         FontSize="12"
                                         TextWrapping="Wrap"
                                         Foreground="{StaticResource DangerBrush}" />
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>

                <!-- 文本 / OCR 结果 -->
                <ScrollViewer Grid.Row="2" IsVisible="{Binding IsTextResultVisible}">
                  <SelectableTextBlock Text="{Binding ResultText}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="13"
                                       LineHeight="20"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" />
                </ScrollViewer>

                <!-- SVG 源码 -->
                <ScrollViewer Grid.Row="2" IsVisible="{Binding IsSvgSourceVisible}">
                  <SelectableTextBlock Text="{Binding ResultText}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="13"
                                       LineHeight="20"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" />
                </ScrollViewer>

                <!-- SVG 预览 -->
                <Border Grid.Row="2"
                        IsVisible="{Binding IsSvgPreviewVisible}"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10"
                        ClipToBounds="True">
                  <Image Source="{Binding SvgPreviewPng, Converter={x:Static converters:ByteArrayToBitmapConverter.Instance}, ConverterParameter=preview}"
                         Stretch="Uniform"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
                </Border>

                <!-- 图片结果（缩放 / 格式转换） -->
                <Border Grid.Row="2"
                        IsVisible="{Binding HasImageResult}"
                        Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10"
                        ClipToBounds="True">
                  <Image Source="{Binding ImageResultPng, Converter={x:Static converters:ByteArrayToBitmapConverter.Instance}, ConverterParameter=preview}"
                         Stretch="Uniform"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
                </Border>

                <!-- 空态：既没结果也没错误时才显示 -->
                <TextBlock Grid.Row="2"
                           IsVisible="{Binding IsResultEmpty}"
                           Text="执行后结果显示在这里"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Grid>
            </Border>
            </Grid>
          </Grid>

        </Grid>
      </Grid>
    </Grid>

    <!-- 设置视图 -->
    <Grid IsVisible="{Binding IsSettingsVisible}" RowDefinitions="Auto,*">
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="24,16,24,8">
        <Button Grid.Column="0"
                Classes="ghost"
                Content="← 返回"
                Click="OnBackClick" />
        <TextBlock Grid.Column="1"
                   Classes="title"
                   Text="设置"
                   VerticalAlignment="Center"
                   Margin="12,0,0,0" />
      </Grid>

      <views:SettingsView Grid.Row="1" DataContext="{Binding Settings}" />
    </Grid>

    <!-- 图片集大图预览：点缩略图打开，点任意处 / Esc 关闭 -->
    <Border IsVisible="{Binding IsImagePreviewVisible}"
            Background="#D9000000"
            PointerPressed="OnCloseImagePreviewClick"
            Cursor="Hand">
      <Image Source="{Binding PreviewImagePng, Converter={x:Static converters:ByteArrayToBitmapConverter.Instance}, ConverterParameter=preview}"
             Stretch="Uniform"
             Margin="48"
             IsHitTestVisible="False" />
    </Border>

  </Panel>
</Window>
