<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sparrow.App.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- 图标几何：放 Application.Resources，DataTemplate 里也能 StaticResource 到 -->
        <ResourceInclude Source="avares://Sparrow.App/Styles/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <!-- 放在 Fluent 之后：同优先级下后加载的样式覆盖默认外观 -->
    <StyleInclude Source="avares://Sparrow.App/Styles/Theme.axaml" />
  </Application.Styles>

</Application>
