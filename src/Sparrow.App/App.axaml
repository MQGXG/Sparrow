<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sparrow.App.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- 图标几何：放 Application.Resources，DataTemplate 里也能 StaticResource 到 -->
        <ResourceInclude Source="avares://Sparrow.App/Styles/Icons.axaml" />
        <!-- 自绘窗口装饰：Avalonia 12 用 Window.WindowDecorationsTheme 接管标题栏按钮 -->
        <ResourceInclude Source="avares://Sparrow.App/Styles/WindowDecorations.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!--
        ============================================================
        主题字典：唯一的颜色来源（深色 / 浅色各一套，key 完全相同）。
        所有控件样式与界面只引用这些语义 token，且必须用 DynamicResource，
        这样切换 RequestedThemeVariant 时颜色会即时刷新，无需重启。
        琥珀是品牌识别色：深色用亮琥珀做文字 / 图标，浅色换成深一档的
        「墨琥珀」保证对比度；填充用的琥珀在两套主题里保持不变。
        ============================================================
      -->
      <ResourceDictionary.ThemeDictionaries>

        <!-- ==================== 深色（默认，保持原有识别度） ==================== -->
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="BgBrush" Color="#0B0E13" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#12171F" />
          <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#1A212C" />
          <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#242D3A" />

          <SolidColorBrush x:Key="LineBrush" Color="#2B3543" />
          <SolidColorBrush x:Key="LineStrongBrush" Color="#3D4959" />
          <SolidColorBrush x:Key="OverlayBrush" Color="#CC0B0E13" />
          <SolidColorBrush x:Key="ScrimBrush" Color="#E6000000" />

          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E9EEF6" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9BA8BA" />
          <SolidColorBrush x:Key="TextMutedBrush" Color="#8695A8" />

          <SolidColorBrush x:Key="AccentBrush" Color="#E5A44C" />
          <SolidColorBrush x:Key="AccentInkBrush" Color="#E5A44C" />
          <SolidColorBrush x:Key="AccentFillBrush" Color="#E5A44C" />
          <SolidColorBrush x:Key="AccentHoverBrush" Color="#F0B463" />
          <SolidColorBrush x:Key="AccentPressedBrush" Color="#C98C3A" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#2C2318" />
          <SolidColorBrush x:Key="AccentBorderBrush" Color="#5C4A26" />
          <SolidColorBrush x:Key="AccentOnBrush" Color="#1A1206" />
          <SolidColorBrush x:Key="AccentSelectionBrush" Color="#20E5A44C" />

          <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
          <SolidColorBrush x:Key="DangerBgBrush" Color="#2A1517" />
          <SolidColorBrush x:Key="DangerLineBrush" Color="#5C2A2E" />

          <SolidColorBrush x:Key="ScrollThumbBrush" Color="#333D4C" />
          <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#465263" />

          <LinearGradientBrush x:Key="WindowBgGradientBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#0D1118" Offset="0" />
            <GradientStop Color="#0A0D12" Offset="1" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="SurfaceGradientBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#151B25" Offset="0" />
            <GradientStop Color="#10141B" Offset="1" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="PanelGradientBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#161C26" Offset="0" />
            <GradientStop Color="#10151D" Offset="1" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#F0B463" Offset="0" />
            <GradientStop Color="#DEA142" Offset="1" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="AccentGradientHoverBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#F5BF76" Offset="0" />
            <GradientStop Color="#E5A94D" Offset="1" />
          </LinearGradientBrush>

          <ImageBrush x:Key="DotGridBrush"
                      Source="avares://Sparrow.App/Assets/dot-grid.png"
                      TileMode="Tile"
                      DestinationRect="0,0,32,32"
                      Stretch="None" />

          <Color x:Key="SystemAccentColor">#E5A44C</Color>
          <Color x:Key="SystemAccentColorLight1">#F0B463</Color>
          <Color x:Key="SystemAccentColorLight2">#F7CE94</Color>
          <Color x:Key="SystemAccentColorLight3">#FBE6C6</Color>
          <Color x:Key="SystemAccentColorDark1">#C98C3A</Color>
          <Color x:Key="SystemAccentColorDark2">#A9712A</Color>
          <Color x:Key="SystemAccentColorDark3">#86561C</Color>
        </ResourceDictionary>

        <!-- ==================== 浅色（白天办公，琥珀降一档做墨色） ==================== -->
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="BgBrush" Color="#F7F8FA" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#EDEFF3" />

          <SolidColorBrush x:Key="LineBrush" Color="#E2E5EA" />
          <SolidColorBrush x:Key="LineStrongBrush" Color="#C9CFD8" />
          <SolidColorBrush x:Key="OverlayBrush" Color="#990B0E13" />
          <SolidColorBrush x:Key="ScrimBrush" Color="#CC000000" />

          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#141A22" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4E5A6A" />
          <SolidColorBrush x:Key="TextMutedBrush" Color="#7A8796" />

          <SolidColorBrush x:Key="AccentBrush" Color="#A96A16" />
          <SolidColorBrush x:Key="AccentInkBrush" Color="#A96A16" />
          <SolidColorBrush x:Key="AccentFillBrush" Color="#E5A44C" />
          <SolidColorBrush x:Key="AccentHoverBrush" Color="#8A5410" />
          <SolidColorBrush x:Key="AccentPressedBrush" Color="#6E4310" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#FBF1E2" />
          <SolidColorBrush x:Key="AccentBorderBrush" Color="#E3C79A" />
          <SolidColorBrush x:Key="AccentOnBrush" Color="#1A1206" />
          <SolidColorBrush x:Key="AccentSelectionBrush" Color="#30A96A16" />

          <SolidColorBrush x:Key="DangerBrush" Color="#C0283A" />
          <SolidColorBrush x:Key="DangerBgBrush" Color="#FDECEF" />
          <SolidColorBrush x:Key="DangerLineBrush" Color="#F2C4CC" />

          <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C9CFD8" />
          <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#AAB4C2" />

          <LinearGradientBrush x:Key="WindowBgGradientBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#F4F6F9" Offset="1" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="SurfaceGradientBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#FAFBFC" Offset="1" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="PanelGradientBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#F9FAFC" Offset="1" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#F0B463" Offset="0" />
            <GradientStop Color="#DEA142" Offset="1" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="AccentGradientHoverBrush" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#F5BF76" Offset="0" />
            <GradientStop Color="#E5A94D" Offset="1" />
          </LinearGradientBrush>

          <ImageBrush x:Key="DotGridBrush"
                      Source="avares://Sparrow.App/Assets/dot-grid-light.png"
                      TileMode="Tile"
                      DestinationRect="0,0,32,32"
                      Stretch="None" />

          <Color x:Key="SystemAccentColor">#A96A16</Color>
          <Color x:Key="SystemAccentColorLight1">#C0812A</Color>
          <Color x:Key="SystemAccentColorLight2">#D69B45</Color>
          <Color x:Key="SystemAccentColorLight3">#E8BC80</Color>
          <Color x:Key="SystemAccentColorDark1">#8A5410</Color>
          <Color x:Key="SystemAccentColorDark2">#6E4310</Color>
          <Color x:Key="SystemAccentColorDark3">#57340C</Color>
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <!-- 放在 Fluent 之后：同优先级下后加载的样式覆盖默认外观 -->
    <StyleInclude Source="avares://Sparrow.App/Styles/Theme.axaml" />
  </Application.Styles>

</Application>
