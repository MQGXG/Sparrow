<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sparrow.App.App"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <FluentTheme />
    <!-- 放在 Fluent 之后：同优先级下后加载的样式覆盖默认外观 -->
    <StyleInclude Source="avares://Sparrow.App/Styles/Theme.axaml" />
  </Application.Styles>

</Application>
