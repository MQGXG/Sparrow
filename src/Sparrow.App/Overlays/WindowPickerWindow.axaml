<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sparrow.App.Overlays.WindowPickerWindow"
        Title="选择窗口"
        WindowDecorations="None"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Cursor="None"
        Focusable="True"
        RequestedThemeVariant="Dark">

  <Grid x:Name="Root" Background="#14000000">

    <!-- 顶部提示：告诉你现在该做什么 -->
    <Border VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Margin="0,32,0,0"
            Padding="14,8"
            CornerRadius="10"
            Background="{DynamicResource OverlayBrush}"
            BorderBrush="{DynamicResource LineStrongBrush}"
            BorderThickness="1">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock x:Name="HintText"
                   FontSize="12"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   VerticalAlignment="Center" />
        <Border Classes="kbd">
          <TextBlock Text="Esc" />
        </Border>
      </StackPanel>
    </Border>

    <!-- 跟随鼠标的图钉：与标题栏指示共用同一套精制图钉徽记 -->
    <Canvas>
      <Border x:Name="PinGlyph"
              Width="34"
              Height="34"
              CornerRadius="11"
              Background="{DynamicResource SurfaceGradientBrush}"
              BorderBrush="{DynamicResource AccentBrush}"
              BorderThickness="1.2"
              BoxShadow="0 4 12 0 #99000000"
              IsHitTestVisible="False"
              IsVisible="False">
        <Viewbox Width="24" Height="24"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
          <Canvas Width="24" Height="24">
            <Path Data="{StaticResource IconPinEmblem}"
                  Fill="#FF000000"
                  Opacity="0.35"
                  Canvas.Left="0"
                  Canvas.Top="1.2" />
            <Path Data="{StaticResource IconPinEmblem}"
                  Fill="{DynamicResource AccentGradientBrush}"
                  Stroke="{DynamicResource AccentPressedBrush}"
                  StrokeThickness="0.5" />
            <Path Data="{StaticResource IconPinRim}"
                  Stroke="#FFFFFF"
                  StrokeThickness="0.9"
                  Opacity="0.5" />
            <Path Data="{StaticResource IconPinGlint}"
                  Stroke="#FFFFFF"
                  StrokeThickness="1.1"
                  StrokeLineCap="Round"
                  Opacity="0.75" />
            <Path Data="M10.9 9.4 L11.6 17.4"
                  Stroke="#FFFFFF"
                  StrokeThickness="0.8"
                  StrokeLineCap="Round"
                  Opacity="0.35" />
          </Canvas>
        </Viewbox>
      </Border>
    </Canvas>
  </Grid>
</Window>
