<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sparrow.App.Overlays.RecordingSetupWindow"
        Title="Sparrow Recording Setup"
        Width="780"
        SizeToContent="Height"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

  <Window.Styles>
    <Style Selector="TextBlock.caption">
      <Setter Property="Foreground" Value="#9A9A9A" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="Foreground" Value="#848484" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="RadioButton">
      <Setter Property="Foreground" Value="#DDDDDD" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#DDDDDD" />
    </Style>
    <Style Selector="TextBox.field">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="#1FFFFFFF" />
      <Setter Property="BorderBrush" Value="#2AFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#EEEEEE" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="#1FFFFFFF" />
      <Setter Property="BorderBrush" Value="#2AFFFFFF" />
      <Setter Property="Foreground" Value="#E6E6E6" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="#E5484D" />
      <Setter Property="BorderBrush" Value="#E5484D" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Window.Styles>

  <Border Background="#FF171717"
          BorderBrush="#2AFFFFFF"
          BorderThickness="1"
          CornerRadius="14"
          Padding="22,18"
          BoxShadow="0 14 40 0 #99000000">
    <StackPanel Spacing="12">

      <Border Background="Transparent"
              Cursor="SizeAll"
              PointerPressed="OnTitlePointerPressed">
        <TextBlock Text="屏幕录制"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="White" />
      </Border>

      <!-- 模式 -->
      <StackPanel Orientation="Horizontal" Spacing="22">
        <RadioButton x:Name="RegionMode" Content="区域" IsChecked="True" />
        <RadioButton x:Name="WindowMode" Content="窗口" />
        <RadioButton x:Name="FullscreenMode" Content="全屏" />
        <CheckBox x:Name="CursorCheck"
                  Content="鼠标画进画面"
                  IsChecked="True"
                  Margin="14,0,0,0" />
      </StackPanel>

      <Border Height="1" Background="#1FFFFFFF" />

      <!-- 画面与编码 -->
      <TextBlock Classes="section" Text="画面与编码" />

      <Grid ColumnDefinitions="76,160,76,160,76,*"
            RowDefinitions="Auto,Auto,Auto,Auto"
            ColumnSpacing="10"
            RowSpacing="10">

        <TextBlock Grid.Row="0" Grid.Column="0" Classes="caption" Text="格式" />
        <ComboBox Grid.Row="0" Grid.Column="1"
                  x:Name="FormatBox"
                  SelectedIndex="0"
                  SelectionChanged="OnFormatChanged"
                  HorizontalAlignment="Stretch">
          <ComboBoxItem>MP4</ComboBoxItem>
          <ComboBoxItem>MKV</ComboBoxItem>
          <ComboBoxItem>MOV</ComboBoxItem>
          <ComboBoxItem>GIF</ComboBoxItem>
          <ComboBoxItem>APNG</ComboBoxItem>
        </ComboBox>

        <TextBlock Grid.Row="0" Grid.Column="2" Classes="caption" Text="质量" />
        <ComboBox Grid.Row="0" Grid.Column="3"
                  x:Name="QualityBox"
                  SelectedIndex="3"
                  HorizontalAlignment="Stretch">
          <ComboBoxItem>原画</ComboBoxItem>
          <ComboBoxItem>超清</ComboBoxItem>
          <ComboBoxItem>高清</ComboBoxItem>
          <ComboBoxItem>清晰</ComboBoxItem>
          <ComboBoxItem>普清</ComboBoxItem>
          <ComboBoxItem>一般</ComboBoxItem>
        </ComboBox>

        <TextBlock Grid.Row="0" Grid.Column="4" Classes="caption" Text="帧率" />
        <ComboBox Grid.Row="0" Grid.Column="5"
                  x:Name="FpsBox"
                  SelectedIndex="0"
                  HorizontalAlignment="Stretch">
          <ComboBoxItem>30 帧/秒</ComboBoxItem>
          <ComboBoxItem>60 帧/秒</ComboBoxItem>
        </ComboBox>

        <TextBlock Grid.Row="1" Grid.Column="0" Classes="caption" Text="编码器" />
        <ComboBox Grid.Row="1" Grid.Column="1"
                  x:Name="EncoderBox"
                  SelectedIndex="0"
                  HorizontalAlignment="Stretch" />
        <TextBlock Grid.Row="1" Grid.Column="2"
                   Grid.ColumnSpan="4"
                   Classes="caption"
                   TextTrimming="CharacterEllipsis"
                   Text="自动按显卡选硬编（QSV / NVENC / AMF / MF），不可用时回退 x264" />

        <TextBlock Grid.Row="2" Grid.Column="0" Classes="caption" Text="编码级别" />
        <ComboBox Grid.Row="2" Grid.Column="1"
                  x:Name="PresetBox"
                  SelectedIndex="2"
                  HorizontalAlignment="Stretch">
          <ComboBoxItem>最快</ComboBoxItem>
          <ComboBoxItem>很快</ComboBoxItem>
          <ComboBoxItem>非常快</ComboBoxItem>
          <ComboBoxItem>较快</ComboBoxItem>
          <ComboBoxItem>中等</ComboBoxItem>
        </ComboBox>

        <TextBlock Grid.Row="2" Grid.Column="2" Classes="caption" Text="GOP（秒）" />
        <TextBox Grid.Row="2" Grid.Column="3"
                 x:Name="GopBox"
                 Classes="field"
                 Text="0"
                 PlaceholderText="0 = 默认" />

        <TextBlock Grid.Row="3" Grid.Column="0" Classes="caption" Text="延时开始" />
        <ComboBox Grid.Row="3" Grid.Column="1"
                  x:Name="CountdownBox"
                  SelectedIndex="0"
                  HorizontalAlignment="Stretch">
          <ComboBoxItem>不延时</ComboBoxItem>
          <ComboBoxItem>3 秒</ComboBoxItem>
          <ComboBoxItem>5 秒</ComboBoxItem>
          <ComboBoxItem>10 秒</ComboBoxItem>
        </ComboBox>

        <TextBlock Grid.Row="3" Grid.Column="2" Classes="caption" Text="时长（分钟）" />
        <TextBox Grid.Row="3" Grid.Column="3"
                 x:Name="DurationBox"
                 Classes="field"
                 Text="0"
                 PlaceholderText="0 = 不限" />
      </Grid>

      <Border Height="1" Background="#1FFFFFFF" />

      <!-- 光标高亮 -->
      <TextBlock Classes="section" Text="光标高亮" />

      <StackPanel Orientation="Horizontal" Spacing="18">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="caption" Text="半径" />
          <TextBox x:Name="CursorRadiusBox" Classes="field" Text="22" Width="84" />
          <TextBlock Classes="caption" Text="px" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="caption" Text="颜色" />
          <ComboBox x:Name="CursorColorBox"
                    SelectedIndex="0"
                    Width="110"
                    Height="32"
                    VerticalAlignment="Center">
            <ComboBoxItem>琥珀</ComboBoxItem>
            <ComboBoxItem>白色</ComboBoxItem>
            <ComboBoxItem>红色</ComboBoxItem>
            <ComboBoxItem>绿色</ComboBoxItem>
            <ComboBoxItem>蓝色</ComboBoxItem>
          </ComboBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="caption" Text="透明度" />
          <Slider x:Name="CursorOpacitySlider"
                  Minimum="50"
                  Maximum="255"
                  Value="210"
                  Width="150"
                  VerticalAlignment="Center" />
        </StackPanel>

        <CheckBox x:Name="CursorShadowCheck" Content="阴影" />
      </StackPanel>

      <Border Height="1" Background="#1FFFFFFF" />

      <!-- 输出 -->
      <TextBlock Classes="section" Text="输出" />

      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="76,*,Auto" ColumnSpacing="10">
          <TextBlock Grid.Column="0" Classes="caption" Text="保存到" />
          <TextBox Grid.Column="1"
                   x:Name="OutputDirectoryBox"
                   Classes="field" />
          <Button Grid.Column="2"
                  Classes="secondary"
                  Content="选择…"
                  Click="OnPickOutputDirectory" />
        </Grid>

        <Grid ColumnDefinitions="76,*,Auto" ColumnSpacing="10">
          <TextBlock Grid.Column="0" Classes="caption" Text="文件名" />
          <TextBox Grid.Column="1"
                   x:Name="BaseNameBox"
                   Classes="field"
                   Text="Sparrow" />
          <TextBlock Grid.Column="2"
                     Classes="caption"
                     Text="自动追加时间戳" />
        </Grid>

        <!-- GIF / APNG 专用：视频格式时隐藏 -->
        <Grid x:Name="AnimationOptions"
              ColumnDefinitions="76,160,76,160"
              ColumnSpacing="10">
          <TextBlock Grid.Column="0" Classes="caption" Text="动画帧率" />
          <ComboBox Grid.Column="1"
                    x:Name="GifFpsBox"
                    SelectedIndex="1"
                    HorizontalAlignment="Stretch">
            <ComboBoxItem>10 帧/秒</ComboBoxItem>
            <ComboBoxItem>15 帧/秒</ComboBoxItem>
            <ComboBoxItem>20 帧/秒</ComboBoxItem>
          </ComboBox>

          <TextBlock Grid.Column="2" Classes="caption" Text="动画尺寸" />
          <ComboBox Grid.Column="3"
                    x:Name="GifWidthBox"
                    SelectedIndex="1"
                    HorizontalAlignment="Stretch">
            <ComboBoxItem>480 px</ComboBoxItem>
            <ComboBoxItem>720 px</ComboBoxItem>
            <ComboBoxItem>1080 px</ComboBoxItem>
          </ComboBox>
        </Grid>

        <!-- 水印：和输出放同一段，减少一个孤立分区 -->
        <Grid ColumnDefinitions="76,*,Auto" ColumnSpacing="10">
          <TextBlock Grid.Column="0" Classes="caption" Text="水印" />
          <TextBlock Grid.Column="1"
                     x:Name="WatermarkSummary"
                     Text="未设置"
                     Classes="caption"
                     TextTrimming="CharacterEllipsis" />
          <Button Grid.Column="2"
                  Classes="secondary"
                  Content="编辑水印…"
                  Click="OnEditWatermarkClick" />
        </Grid>
      </StackPanel>

      <!-- 音频：GIF / APNG 没有音轨，整段隐藏 -->
      <StackPanel x:Name="AudioSection" Spacing="12">
        <Border Height="1" Background="#1FFFFFFF" />
        <TextBlock Classes="section" Text="音频" />
        <StackPanel x:Name="AudioOptions" Orientation="Horizontal" Spacing="20">
          <CheckBox x:Name="SystemAudio" Content="系统声音" />
          <CheckBox x:Name="Microphone" Content="麦克风" />
          <CheckBox x:Name="CameraCheck"
                    Content="摄像头"
                    IsEnabled="False"
                    Opacity="0.45"
                    ToolTip.Tip="画中画需要摄像头设备；检测到设备后会启用" />
        </StackPanel>
      </StackPanel>

      <!-- 底部动作 -->
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="10">
        <Button Classes="secondary" Content="恢复默认" Click="OnRestoreDefaults" />
        <Button Classes="secondary" Content="取消" Click="OnCancelClick" />
        <Button Classes="primary" Content="开始录制" Click="OnStartClick" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
