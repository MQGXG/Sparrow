<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sparrow.App.Overlays.RecordingSetupWindow"
        Title="Sparrow Recording Setup"
        Width="700"
        SizeToContent="Height"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

  <Window.Styles>
    <Style Selector="TextBlock.caption">
      <Setter Property="Foreground" Value="#999999" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="RadioButton">
      <Setter Property="Foreground" Value="#DDDDDD" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#DDDDDD" />
    </Style>
  </Window.Styles>

  <Border Background="#F21A1A1A"
          BorderBrush="#33FFFFFF"
          BorderThickness="1"
          CornerRadius="14"
          Padding="18"
          BoxShadow="0 12 32 0 #88000000">
    <StackPanel Spacing="16">

      <TextBlock Text="屏幕录制"
                 FontSize="17"
                 FontWeight="SemiBold"
                 Foreground="White" />

      <!-- 模式：区域 / 窗口 / 全屏 -->
      <StackPanel Orientation="Horizontal" Spacing="18">
        <RadioButton x:Name="RegionMode" Content="区域" IsChecked="True" />
        <RadioButton x:Name="WindowMode" Content="窗口" />
        <RadioButton x:Name="FullscreenMode" Content="全屏" />
      </StackPanel>

      <!-- 格式 / 质量 / 帧率 -->
      <Grid ColumnDefinitions="Auto,150,Auto,150,Auto,140"
            RowDefinitions="Auto,Auto"
            ColumnSpacing="10"
            RowSpacing="10">

        <TextBlock Grid.Row="0" Grid.Column="0" Classes="caption" Text="格式" />
        <ComboBox Grid.Row="0" Grid.Column="1"
                  x:Name="FormatBox"
                  SelectedIndex="0"
                  HorizontalAlignment="Stretch">
          <ComboBoxItem>MP4</ComboBoxItem>
          <ComboBoxItem>GIF</ComboBoxItem>
        </ComboBox>

        <TextBlock Grid.Row="0" Grid.Column="2" Classes="caption" Text="质量" />
        <ComboBox Grid.Row="0" Grid.Column="3"
                  x:Name="QualityBox"
                  SelectedIndex="3"
                  HorizontalAlignment="Stretch">
          <ComboBoxItem>原画</ComboBoxItem>
          <ComboBoxItem>超清</ComboBoxItem>
          <ComboBoxItem>高清</ComboBoxItem>
          <ComboBoxItem>清晰</ComboBoxItem>
          <ComboBoxItem>普清</ComboBoxItem>
          <ComboBoxItem>一般</ComboBoxItem>
        </ComboBox>

        <TextBlock Grid.Row="1" Grid.Column="0" Classes="caption" Text="帧率" />
        <ComboBox Grid.Row="1" Grid.Column="1"
                  x:Name="FpsBox"
                  SelectedIndex="0"
                  HorizontalAlignment="Stretch">
          <ComboBoxItem>30 帧/秒</ComboBoxItem>
          <ComboBoxItem>60 帧/秒</ComboBoxItem>
        </ComboBox>

        <TextBlock Grid.Row="1" Grid.Column="2" Classes="caption" Text="鼠标" />
        <CheckBox Grid.Row="1" Grid.Column="3"
                  x:Name="CursorCheck"
                  Content="画进画面"
                  IsChecked="True" />
      </Grid>

      <!-- 编码级别 / 延时 / 录制时长 / GOP -->
      <Grid ColumnDefinitions="Auto,150,Auto,150,Auto,140"
            RowDefinitions="Auto,Auto"
            ColumnSpacing="10"
            RowSpacing="10">
        <TextBlock Grid.Row="0" Grid.Column="0" Classes="caption" Text="编码级别" />
        <ComboBox Grid.Row="0" Grid.Column="1"
                  x:Name="PresetBox"
                  SelectedIndex="2"
                  HorizontalAlignment="Stretch">
          <ComboBoxItem>最快</ComboBoxItem>
          <ComboBoxItem>很快</ComboBoxItem>
          <ComboBoxItem>非常快</ComboBoxItem>
          <ComboBoxItem>较快</ComboBoxItem>
          <ComboBoxItem>中等</ComboBoxItem>
        </ComboBox>

        <TextBlock Grid.Row="0" Grid.Column="2" Classes="caption" Text="延时开始" />
        <ComboBox Grid.Row="0" Grid.Column="3"
                  x:Name="CountdownBox"
                  SelectedIndex="0"
                  HorizontalAlignment="Stretch">
          <ComboBoxItem>不延时</ComboBoxItem>
          <ComboBoxItem>3 秒</ComboBoxItem>
          <ComboBoxItem>5 秒</ComboBoxItem>
          <ComboBoxItem>10 秒</ComboBoxItem>
        </ComboBox>

        <TextBlock Grid.Row="0" Grid.Column="4" Classes="caption" Text="时长（分钟）" />
        <TextBox Grid.Row="0" Grid.Column="5"
                 x:Name="DurationBox"
                 Text="0"
                 PlaceholderText="0 = 不限" />

        <TextBlock Grid.Row="1" Grid.Column="0" Classes="caption" Text="GOP（秒）" />
        <TextBox Grid.Row="1" Grid.Column="1"
                 x:Name="GopBox"
                 Text="0"
                 PlaceholderText="0 = 默认" />
      </Grid>

      <!-- 光标高亮参数 -->
      <Grid ColumnDefinitions="Auto,80,Auto,120,Auto,120,Auto"
            ColumnSpacing="8">
        <TextBlock Grid.Column="0" Classes="caption" Text="半径" />
        <TextBox Grid.Column="1" x:Name="CursorRadiusBox" Text="22" />

        <TextBlock Grid.Column="2" Classes="caption" Text="颜色" />
        <ComboBox Grid.Column="3" x:Name="CursorColorBox" SelectedIndex="0">
          <ComboBoxItem>琥珀</ComboBoxItem>
          <ComboBoxItem>白色</ComboBoxItem>
          <ComboBoxItem>红色</ComboBoxItem>
          <ComboBoxItem>绿色</ComboBoxItem>
          <ComboBoxItem>蓝色</ComboBoxItem>
        </ComboBox>

        <TextBlock Grid.Column="4" Classes="caption" Text="透明度" />
        <Slider Grid.Column="5"
                x:Name="CursorOpacitySlider"
                Minimum="50"
                Maximum="255"
                Value="210" />

        <CheckBox Grid.Column="6" x:Name="CursorShadowCheck" Content="阴影" />
      </Grid>

      <!-- 保存目录 / 文件名 -->
      <Grid ColumnDefinitions="Auto,*,Auto"
            RowDefinitions="Auto,Auto"
            ColumnSpacing="10"
            RowSpacing="10">
        <TextBlock Grid.Row="0" Grid.Column="0" Classes="caption" Text="保存到" />
        <TextBox Grid.Row="0" Grid.Column="1"
                 x:Name="OutputDirectoryBox" />
        <Button Grid.Row="0" Grid.Column="2"
                Content="选择…"
                Click="OnPickOutputDirectory"
                Padding="12,6" />

        <TextBlock Grid.Row="1" Grid.Column="0" Classes="caption" Text="文件名" />
        <TextBox Grid.Row="1" Grid.Column="1"
                 x:Name="BaseNameBox"
                 Text="Sparrow" />
        <TextBlock Grid.Row="1" Grid.Column="2"
                   Classes="caption"
                   Text="自动追加时间戳" />
      </Grid>

      <!-- GIF 参数与水印 -->
      <Grid ColumnDefinitions="Auto,150,Auto,150"
            RowDefinitions="Auto,Auto"
            ColumnSpacing="10"
            RowSpacing="10">

        <TextBlock Grid.Row="0" Grid.Column="0" Classes="caption" Text="GIF 帧率" />
        <ComboBox Grid.Row="0" Grid.Column="1"
                  x:Name="GifFpsBox"
                  SelectedIndex="1"
                  HorizontalAlignment="Stretch">
          <ComboBoxItem>10 帧/秒</ComboBoxItem>
          <ComboBoxItem>15 帧/秒</ComboBoxItem>
          <ComboBoxItem>20 帧/秒</ComboBoxItem>
        </ComboBox>

        <TextBlock Grid.Row="0" Grid.Column="2" Classes="caption" Text="GIF 尺寸" />
        <ComboBox Grid.Row="0" Grid.Column="3"
                  x:Name="GifWidthBox"
                  SelectedIndex="1"
                  HorizontalAlignment="Stretch">
          <ComboBoxItem>480 px</ComboBoxItem>
          <ComboBoxItem>720 px</ComboBoxItem>
          <ComboBoxItem>1080 px</ComboBoxItem>
        </ComboBox>

        <TextBlock Grid.Row="1" Grid.Column="0" Classes="caption" Text="水印" />
        <Button Grid.Row="1" Grid.Column="1"
                Content="编辑水印…"
                Click="OnEditWatermarkClick"
                Padding="12,6" />
        <TextBlock Grid.Row="1" Grid.Column="2"
                   Grid.ColumnSpan="2"
                   x:Name="WatermarkSummary"
                   Text="未设置"
                   Classes="caption"
                   TextWrapping="Wrap" />
      </Grid>

      <!-- 音频 / 摄像头 -->
      <StackPanel Orientation="Horizontal" Spacing="20">
        <CheckBox x:Name="SystemAudio" Content="系统声音" />
        <CheckBox x:Name="Microphone" Content="麦克风" />
        <CheckBox x:Name="CameraCheck"
                  Content="摄像头"
                  IsEnabled="False"
                  Opacity="0.45"
                  ToolTip.Tip="画中画需要摄像头设备；检测到设备后会启用" />
      </StackPanel>

      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="10">
        <Button Content="恢复默认"
                Click="OnRestoreDefaults"
                Padding="12,6" />
        <Button Content="取消" Click="OnCancelClick" Padding="16,6" />
        <Button Content="开始录制"
                Click="OnStartClick"
                Padding="18,6"
                Background="#FF4D4F"
                Foreground="White" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
