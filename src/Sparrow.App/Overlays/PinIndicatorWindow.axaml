<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sparrow.App.Overlays.PinIndicatorWindow"
        Title="Pin"
        Width="32"
        Height="32"
        WindowDecorations="None"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Cursor="Hand"
        RequestedThemeVariant="Dark">

  <Window.Styles>
    <!-- 底板：深色玻璃圆盘 + 琥珀描边 + 投影 -->
    <Style Selector="Border.pin-plate">
      <Setter Property="Background" Value="{DynamicResource SurfaceGradientBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
      <Setter Property="BoxShadow" Value="0 3 10 0 #99000000" />
    </Style>
    <Style Selector="Border.pin-plate.removing">
      <Setter Property="Background" Value="{DynamicResource DangerBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>
  </Window.Styles>

  <Grid x:Name="Root" Background="Transparent">
    <Border x:Name="Plate"
            Classes="pin-plate"
            CornerRadius="16"
            BorderThickness="1" />

    <!-- 常态：单色渐变图钉 + 钉帽高光 -->
    <Panel x:Name="PinGlyph" IsHitTestVisible="False">
      <Viewbox Width="18" Height="18"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center">
        <Canvas Width="24" Height="24">
          <Path Data="{StaticResource IconPinBadge}"
                Fill="#40000000"
                Canvas.Top="0.8" />
          <Path Data="{StaticResource IconPinBadge}"
                Fill="{DynamicResource AccentGradientBrush}"
                Stroke="{DynamicResource AccentPressedBrush}"
                StrokeThickness="0.4" />
          <Path Data="{StaticResource IconPinBadgeGlint}"
                Stroke="#FFFFFF"
                StrokeThickness="1"
                StrokeLineCap="Round"
                Opacity="0.55" />
        </Canvas>
      </Viewbox>
    </Panel>

    <!-- 悬停：危险色圆环 + 矢量叉，明确「点一下取消置顶」 -->
    <Panel x:Name="CloseGlyph" IsVisible="False" IsHitTestVisible="False">
      <Ellipse Width="18" Height="18"
               Fill="{DynamicResource DangerBgBrush}"
               Stroke="{DynamicResource DangerBrush}"
               StrokeThickness="1.1" />
      <Path Classes="icon icon-sm"
            Data="{StaticResource IconClose}"
            Stroke="{DynamicResource DangerBrush}"
            StrokeThickness="1.8" />
    </Panel>
  </Grid>
</Window>
