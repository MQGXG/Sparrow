<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Sparrow.App</AssemblyName>
    <RootNamespace>Sparrow.App</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- 编译绑定：绑定错误在编译期暴露，而不是运行时静默失败 -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- exe 图标（任务栏 / 资源管理器）。托盘和窗口共用 Assets 里的 PNG -->
    <ApplicationIcon>Assets\sparrow.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 图标资源：托盘用 32px，窗口 / 空态用 64px；exe 用多尺寸 sparrow.ico -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Interop.UIAutomationClient" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Svg.Skia" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sparrow.Plugin.Sdk\Sparrow.Plugin.Sdk.csproj" />
  </ItemGroup>

  <!--
    构建期插件依赖：只保证 plugins/ 先编译，并让插件的 CopyPluginToHost
    把产物复制到 $(OutDir)plugins/<PluginId>/。
    这不是运行时引用：ReferenceOutputAssembly=false，插件 DLL 不会进 App 根目录，
    删插件目录仍然等于删干净。
    用 glob 而不是逐个列项目，加插件不需要改 App.csproj。
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\plugins\**\*.csproj" Exclude="..\..\plugins\**\bin\**;..\..\plugins\**\obj\**" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- 让测试能直接验证 DIB→PNG 这类内部转换，不用把实现细节暴露成 public -->
    <InternalsVisibleTo Include="Sparrow.Tests" />
  </ItemGroup>

  <!--
    删除插件目录后，bin/.../plugins 里的旧副本不会自动消失，应用会继续加载它。
    每次构建后按仓库 plugins/ 的目录名对齐一次：输出里有、源码里没有的直接删掉。
  -->
  <UsingTask TaskName="PruneStalePluginOutput" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceRoot ParameterType="System.String" Required="true" />
      <HostRoot ParameterType="System.String" Required="true" />
      <Removed ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Collections.Generic" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var expected = Directory.GetDirectories(SourceRoot);

        var stale = new List<string>();
        if (Directory.Exists(HostRoot))
        {
            foreach (var dir in Directory.GetDirectories(HostRoot))
            {
                var name = Path.GetFileName(dir);
                var keep = expected.Any(source =>
                    string.Equals(Path.GetFileName(source), name, StringComparison.OrdinalIgnoreCase));

                if (!keep)
                    stale.Add(dir);
            }
        }

        foreach (var dir in stale)
            Directory.Delete(dir, recursive: true);

        Removed = string.Join(";", stale);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="RemoveStalePluginOutput" AfterTargets="Build">
    <PruneStalePluginOutput SourceRoot="$(MSBuildProjectDirectory)\..\..\plugins" HostRoot="$(MSBuildProjectDirectory)\$(OutDir)plugins">
      <Output TaskParameter="Removed" PropertyName="_RemovedPluginDirs" />
    </PruneStalePluginOutput>

    <Message Importance="normal" Text="清理已删除插件的输出：$(_RemovedPluginDirs)" Condition="'$(_RemovedPluginDirs)' != ''" />
  </Target>

  <!--
    插件不在运行时引用：上面的 ProjectReference 只是构建顺序，
    ReferenceOutputAssembly=false，插件程序集不会成为 App 的依赖。
    插件产物由 plugins/Directory.Build.targets 复制到 $(OutDir)plugins/<PluginId>/。
  -->

</Project>
