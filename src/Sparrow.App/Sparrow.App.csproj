<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Sparrow.App</AssemblyName>
    <RootNamespace>Sparrow.App</RootNamespace>
    <!-- WGC（Windows.Graphics.Capture）需要 Windows SDK 投影 -->
    <TargetFramework>$(SparrowHostTargetFramework)</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- 编译绑定：绑定错误在编译期暴露，而不是运行时静默失败 -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- exe 图标（任务栏 / 资源管理器）。托盘和窗口共用 Assets 里的 PNG -->
    <ApplicationIcon>Assets\sparrow.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 图标资源：托盘用 32px，窗口 / 空态用 64px；exe 用多尺寸 sparrow.ico -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 局域网互传：MIME 表随程序集嵌入，代码按资源名读取 -->
    <EmbeddedResource Include="Services\LanShare\MimeTypes.json" />
  </ItemGroup>

  <ItemGroup>
    <!--
      屏幕录制的编码器：随包分发会比 NuGet 还原更稳定。
      ffmpeg 只在缺失时才需要手工补，仓库里不放二进制（.gitignore 忽略）。
      必须连同 avcodec/avformat 等 DLL 一起复制：FormatFactory 构建是动态链接的。
    -->
    <None Include="..\..\tools\ffmpeg\**\*.*"
          Link="tools\ffmpeg\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\tools\ffmpeg')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Interop.UIAutomationClient" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Svg.Skia" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="Velopack" />
    <!-- 本地翻译引擎：llama.cpp 的 .NET 封装 + CPU 后端（宿主能力，插件不各自引） -->
    <PackageReference Include="LLamaSharp" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sparrow.Plugin.Sdk\Sparrow.Plugin.Sdk.csproj" />
    <!-- 来源：Lertaro (MIT)。只用于 MFT 索引 / 列式 Snapshot / 查询。 -->
    <ProjectReference Include="..\third_party\Lertaro\Core\Core.csproj" />
    <!-- 索引服务是独立 exe：只保证构建顺序，不作为运行时程序集引用。 -->
    <ProjectReference Include="..\Sparrow.IndexService\Sparrow.IndexService.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <!--
    构建期插件依赖：只保证 plugins/ 先编译，并让插件的 CopyPluginToHost
    把产物复制到 $(OutDir)plugins/<PluginId>/。
    这不是运行时引用：ReferenceOutputAssembly=false，插件 DLL 不会进 App 根目录，
    删插件目录仍然等于删干净。
    用 glob 而不是逐个列项目，加插件不需要改 App.csproj。
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\plugins\**\*.csproj" Exclude="..\..\plugins\**\bin\**;..\..\plugins\**\obj\**" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- 让测试能直接验证 DIB→PNG 这类内部转换，不用把实现细节暴露成 public -->
    <InternalsVisibleTo Include="Sparrow.Tests" />
  </ItemGroup>

  <!--
    删除插件目录后，bin/.../plugins 里的旧副本不会自动消失，应用会继续加载它。
    每次构建后按仓库 plugins/ 的目录名对齐一次：输出里有、源码里没有的直接删掉。
  -->
  <UsingTask TaskName="PruneStalePluginOutput" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceRoot ParameterType="System.String" Required="true" />
      <HostRoot ParameterType="System.String" Required="true" />
      <Removed ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Collections.Generic" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var expected = Directory.GetDirectories(SourceRoot);

        var stale = new List<string>();
        if (Directory.Exists(HostRoot))
        {
            foreach (var dir in Directory.GetDirectories(HostRoot))
            {
                var name = Path.GetFileName(dir);
                var keep = expected.Any(source =>
                    string.Equals(Path.GetFileName(source), name, StringComparison.OrdinalIgnoreCase));

                if (!keep)
                    stale.Add(dir);
            }
        }

        foreach (var dir in stale)
            Directory.Delete(dir, recursive: true);

        Removed = string.Join(";", stale);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="RemoveStalePluginOutput" AfterTargets="Build">
    <PruneStalePluginOutput SourceRoot="$(MSBuildProjectDirectory)\..\..\plugins" HostRoot="$(MSBuildProjectDirectory)\$(OutDir)plugins">
      <Output TaskParameter="Removed" PropertyName="_RemovedPluginDirs" />
    </PruneStalePluginOutput>

    <Message Importance="normal" Text="清理已删除插件的输出：$(_RemovedPluginDirs)" Condition="'$(_RemovedPluginDirs)' != ''" />
  </Target>

  <!--
    插件不在运行时引用：上面的 ProjectReference 只是构建顺序，
    ReferenceOutputAssembly=false，插件程序集不会成为 App 的依赖。
    插件产物由 plugins/Directory.Build.targets 复制到 $(OutDir)plugins/<PluginId>/。
  -->
  <!--
    本地推理后端默认把各平台 native 库都拷进输出（约 26MB）。
    应用只发 Windows：非 win-x64 的运行库在构建后删掉；带 RID 的 publish 本来就只取 win-x64。
  -->
  <Target Name="TrimForeignRuntimeAssets" AfterTargets="Build">
    <ItemGroup>
      <_ForeignRuntimeFiles Include="$(TargetDir)runtimes\**\*" Exclude="$(TargetDir)runtimes\win-x64\**\*" />
    </ItemGroup>

    <!-- 只删文件：MSBuild 的通配符不返回目录，空目录留着不占空间 -->
    <Delete Files="@(_ForeignRuntimeFiles)" ContinueOnError="true" />
  </Target>

  <!--
    索引服务是独立 exe：构建后复制到 $(OutDir)index-service/，
    设置页从这里安装/卸载。服务负责 MFT + USN，宿主只读它写出的 .idx。
  -->
  <Target Name="CopyIndexServiceOutput" AfterTargets="Build">
    <ItemGroup>
      <_IndexServiceFiles Include="$(MSBuildProjectDirectory)\..\Sparrow.IndexService\bin\$(Configuration)\net10.0-windows\**\*.*" />
    </ItemGroup>

    <Copy SourceFiles="@(_IndexServiceFiles)"
          DestinationFolder="$(OutDir)index-service\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
