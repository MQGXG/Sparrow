<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Sparrow.App</AssemblyName>
    <RootNamespace>Sparrow.App</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- 编译绑定：绑定错误在编译期暴露，而不是运行时静默失败 -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- exe 图标（任务栏 / 资源管理器）。托盘和窗口共用 Assets 里的 PNG -->
    <ApplicationIcon>Assets\sparrow.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 图标资源：托盘加载 avares://Sparrow.App/Assets/sparrow-32.png -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Svg.Skia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sparrow.Plugin.Sdk\Sparrow.Plugin.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 让测试能直接验证 DIB→PNG 这类内部转换，不用把实现细节暴露成 public -->
    <InternalsVisibleTo Include="Sparrow.Tests" />
  </ItemGroup>

  <!--
    ★ 这里刻意没有任何插件引用。
    插件由 plugins/Directory.Build.targets 自己复制到 $(OutDir)plugins/<PluginId>/。
    加一个新工具不需要碰这个文件——这是「加插件不改宿主」的构建层保证。
  -->

</Project>
