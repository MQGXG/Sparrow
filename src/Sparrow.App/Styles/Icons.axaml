<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    图标源文件：界面里所有「动作 / 状态」图标都在这里，XAML 只引用 key，不再内联 path。

    统一规范（改图标时逐条对照）：
      · 画布 24×24，安全区 20×20（四周留 2px）
      · 只画 stroke，不填充；线宽 1.5，圆头圆角
      · 圆角半径 2；端点尽量落 0.5 格，保证 13/16/18/20px 缩放后不糊
      · 颜色由 Path.icon 样式控制，这里不出现任何颜色
      · 命名 Icon<用途>，一个图形只保留一份
  -->

  <!-- ============ 动作 ============ -->
  <StreamGeometry x:Key="IconSearch">M10.5 4.5a6.25 6.25 0 1 0 0 12.5 6.25 6.25 0 0 0 0-12.5z M15.2 15.2 20 20</StreamGeometry>
  <StreamGeometry x:Key="IconEye">M2.75 12C5.2 8.3 8.4 6.5 12 6.5s6.8 1.8 9.25 5.5c-2.45 3.7-5.65 5.5-9.25 5.5S5.2 15.7 2.75 12Z M12 9.6a2.4 2.4 0 1 0 0 4.8 2.4 2.4 0 0 0 0-4.8z</StreamGeometry>
  <StreamGeometry x:Key="IconCopy">M8.5 8.5V6.2A1.7 1.7 0 0 1 10.2 4.5h7.6a1.7 1.7 0 0 1 1.7 1.7v7.6a1.7 1.7 0 0 1-1.7 1.7h-2.3 M4.5 10.2A1.7 1.7 0 0 1 6.2 8.5h7.6a1.7 1.7 0 0 1 1.7 1.7v7.6a1.7 1.7 0 0 1-1.7 1.7H6.2a1.7 1.7 0 0 1-1.7-1.7z</StreamGeometry>
  <StreamGeometry x:Key="IconPaste">M12 3.75V14 M7.75 9.75 12 14l4.25-4.25 M4.5 20h15</StreamGeometry>
  <StreamGeometry x:Key="IconOpen">M13.5 4.5h6v6 M19.5 4.5 11 13 M18 14.5V18a1.75 1.75 0 0 1-1.75 1.75H5.75A1.75 1.75 0 0 1 4 18V7.5a1.75 1.75 0 0 1 1.75-1.75H10</StreamGeometry>
  <StreamGeometry x:Key="IconTrash">M4 6.5h16 M9.5 6.5V4.6a1.1 1.1 0 0 1 1.1-1.1h2.8a1.1 1.1 0 0 1 1.1 1.1v1.9 M6.6 6.5l.85 12.1a1.6 1.6 0 0 0 1.6 1.5h6.1a1.6 1.6 0 0 0 1.6-1.5l.85-12.1 M10 10.5V17 M14 10.5V17</StreamGeometry>
  <StreamGeometry x:Key="IconStar">M12 3.9 13.9 9.7 20 9.7 15 13.3 16.9 19.1 12 15.5 7.1 19.1 9 13.3 4 9.7 10.1 9.7Z</StreamGeometry>
  <StreamGeometry x:Key="IconClose">M6.5 6.5 17.5 17.5 M17.5 6.5 6.5 17.5</StreamGeometry>
  <!-- 省略号：点是实心的，配合 Path.icon-dot 使用 -->
  <StreamGeometry x:Key="IconMore">M6.2 12a0.95 0.95 0 1 0 1.9 0 0.95 0.95 0 1 0-1.9 0 M11.05 12a0.95 0.95 0 1 0 1.9 0 0.95 0.95 0 1 0-1.9 0 M15.9 12a0.95 0.95 0 1 0 1.9 0 0.95 0.95 0 1 0-1.9 0</StreamGeometry>

  <!-- ============ 导航 ============ -->
  <StreamGeometry x:Key="IconChevronDown">M7.5 10 12 14.5 16.5 10</StreamGeometry>
  <StreamGeometry x:Key="IconChevronRight">M10 7.5 14.5 12 10 16.5</StreamGeometry>
  <StreamGeometry x:Key="IconChevronLeft">M14 7.5 9.5 12 14 16.5</StreamGeometry>

  <!-- ============ 动作（补齐） ============ -->
  <!-- 设置：六齿齿轮，顶栏与设置入口共用 -->
  <StreamGeometry x:Key="IconSettings">M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 0 1 0 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 0 1 0-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z</StreamGeometry>
  <!-- 撤销：回转箭头，用于「撤销删除」 -->
  <StreamGeometry x:Key="IconUndo">M8 5.5 4 9.5l4 4 M4.5 9.5h9.5a5.5 5.5 0 0 1 0 11h-3</StreamGeometry>
  <!-- 刷新：环形箭头，用于重新扫描 / 重新加载 -->
  <StreamGeometry x:Key="IconRefresh">M20 12a8 8 0 1 1-2.34-5.66 M20 4.5V9.5h-5</StreamGeometry>
  <!-- 画笔：标注模式入口 -->
  <StreamGeometry x:Key="IconPen">M4.5 19.5l1-4L16 5a1.8 1.8 0 0 1 2.6 0l.9.9a1.8 1.8 0 0 1 0 2.6L9 19l-4.5.5z M13.6 6.4 17.6 10.4</StreamGeometry>
  <StreamGeometry x:Key="IconPlus">M12 5.5v13 M5.5 12h13</StreamGeometry>
  <StreamGeometry x:Key="IconCheck">M5 12.5 10 17.5 19 7</StreamGeometry>
  <!-- 图钉：钉帽 + 钉身，用于把快速面板置顶 -->
  <StreamGeometry x:Key="IconPin">M16 9V4h1a1 1 0 0 0 0-2H7a1 1 0 0 0 0 2h1v5c0 1.66-1.34 3-3 3v2h6v7.5l1 1 1-1V14h6v-2c-1.66 0-3-1.34-3-3z</StreamGeometry>
  <!-- 描边图钉：标题栏指示 / 拾取光标共用，避免 Segoe MDL2 字体图标在不同系统上发虚或变方块 -->
  <StreamGeometry x:Key="IconPinOutline">M8 3.5H16 M6.5 9 L8 3.5 H16 L17.5 9 L12 12 Z M12 12 V20.5</StreamGeometry>

  <!-- ============ 精制图钉徽记（标题栏指示 / 拾取光标共用） ============
       拆成 4 层几何，由窗口分别填充渐变、描边与高光，做出立体感；
       单色线框版本（IconPinOutline）保留给其它小尺寸场景。 -->
  <!-- 钉体：扁圆钉帽 + 收窄钉身 + 针尖，三段共用一个填充 -->
  <StreamGeometry x:Key="IconPinEmblem">M5.8 5.7 a6.2 3.3 0 1 0 12.4 0 a6.2 3.3 0 1 0 -12.4 0 Z M9.6 8.2 H14.4 L12.9 18.2 H11.1 Z M10.9 18.2 H13.1 L12 21.6 Z</StreamGeometry>
  <!-- 钉帽内圈：细高光环 -->
  <StreamGeometry x:Key="IconPinRim">M7.6 5.7 a4.4 2.1 0 1 0 8.8 0 a4.4 2.1 0 1 0 -8.8 0</StreamGeometry>
  <!-- 钉帽左上：短弧高光 -->
  <StreamGeometry x:Key="IconPinGlint">M8.2 4.3 a4.3 2.1 0 0 1 4.6 -0.8</StreamGeometry>

  <!-- ============ 类型标识（与工具墙的取景框语言一致，只画轮廓） ============ -->
  <StreamGeometry x:Key="IconLink">M10.5 13.5a4.5 4.5 0 0 0 6.36 0l3-3a4.5 4.5 0 0 0-6.36-6.36l-1.5 1.5 M13.5 10.5a4.5 4.5 0 0 0-6.36 0l-3 3a4.5 4.5 0 0 0 6.36 6.36l1.5-1.5</StreamGeometry>
  <StreamGeometry x:Key="IconText">M7 18 12 6l5 12 M9.2 14h5.6</StreamGeometry>
  <StreamGeometry x:Key="IconImage">M4.5 6.5A1.5 1.5 0 0 1 6 5h12a1.5 1.5 0 0 1 1.5 1.5v11A1.5 1.5 0 0 1 18 19H6a1.5 1.5 0 0 1-1.5-1.5z M4.5 15.5 9 11l3.5 3.5L15 12l4.5 4.5 M9 9.5a1.2 1.2 0 1 0 0-2.4 1.2 1.2 0 0 0 0 2.4z</StreamGeometry>
  <StreamGeometry x:Key="IconFile">M13 3.5H7A1.5 1.5 0 0 0 5.5 5v14A1.5 1.5 0 0 0 7 20.5h10a1.5 1.5 0 0 0 1.5-1.5V9 M13 3.5V9h5.5</StreamGeometry>
