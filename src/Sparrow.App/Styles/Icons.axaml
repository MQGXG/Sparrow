<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    图标源文件：界面里所有「动作 / 状态」图标都在这里，XAML 只引用 key，不再内联 path。

    统一规范（改图标时逐条对照）：
      · 画布 24×24，安全区 20×20（四周留 2px）
      · 只画 stroke，不填充；线宽 1.5，圆头圆角
      · 圆角半径 2；端点尽量落 0.5 格，保证 13/16/18/20px 缩放后不糊
      · 颜色由 Path.icon 样式控制，这里不出现任何颜色
      · 命名 Icon<用途>，一个图形只保留一份
  -->

  <!-- ============ 动作 ============ -->
  <StreamGeometry x:Key="IconSearch">M10.5 4.5a6.25 6.25 0 1 0 0 12.5 6.25 6.25 0 0 0 0-12.5z M15.2 15.2 20 20</StreamGeometry>
  <StreamGeometry x:Key="IconEye">M2.75 12C5.2 8.3 8.4 6.5 12 6.5s6.8 1.8 9.25 5.5c-2.45 3.7-5.65 5.5-9.25 5.5S5.2 15.7 2.75 12Z M12 9.6a2.4 2.4 0 1 0 0 4.8 2.4 2.4 0 0 0 0-4.8z</StreamGeometry>
  <StreamGeometry x:Key="IconCopy">M8.5 8.5V6.2A1.7 1.7 0 0 1 10.2 4.5h7.6a1.7 1.7 0 0 1 1.7 1.7v7.6a1.7 1.7 0 0 1-1.7 1.7h-2.3 M4.5 10.2A1.7 1.7 0 0 1 6.2 8.5h7.6a1.7 1.7 0 0 1 1.7 1.7v7.6a1.7 1.7 0 0 1-1.7 1.7H6.2a1.7 1.7 0 0 1-1.7-1.7z</StreamGeometry>
  <StreamGeometry x:Key="IconPaste">M12 3.75V14 M7.75 9.75 12 14l4.25-4.25 M4.5 20h15</StreamGeometry>
  <StreamGeometry x:Key="IconOpen">M13.5 4.5h6v6 M19.5 4.5 11 13 M18 14.5V18a1.75 1.75 0 0 1-1.75 1.75H5.75A1.75 1.75 0 0 1 4 18V7.5a1.75 1.75 0 0 1 1.75-1.75H10</StreamGeometry>
  <StreamGeometry x:Key="IconTrash">M4 6.5h16 M9.5 6.5V4.6a1.1 1.1 0 0 1 1.1-1.1h2.8a1.1 1.1 0 0 1 1.1 1.1v1.9 M6.6 6.5l.85 12.1a1.6 1.6 0 0 0 1.6 1.5h6.1a1.6 1.6 0 0 0 1.6-1.5l.85-12.1 M10 10.5V17 M14 10.5V17</StreamGeometry>
  <StreamGeometry x:Key="IconStar">M12 3.9 13.9 9.7 20 9.7 15 13.3 16.9 19.1 12 15.5 7.1 19.1 9 13.3 4 9.7 10.1 9.7Z</StreamGeometry>
  <StreamGeometry x:Key="IconClose">M6.5 6.5 17.5 17.5 M17.5 6.5 6.5 17.5</StreamGeometry>
  <!-- 省略号：点是实心的，配合 Path.icon-dot 使用 -->
  <StreamGeometry x:Key="IconMore">M6.2 12a0.95 0.95 0 1 0 1.9 0 0.95 0.95 0 1 0-1.9 0 M11.05 12a0.95 0.95 0 1 0 1.9 0 0.95 0.95 0 1 0-1.9 0 M15.9 12a0.95 0.95 0 1 0 1.9 0 0.95 0.95 0 1 0-1.9 0</StreamGeometry>

  <!-- ============ 导航 ============ -->
  <StreamGeometry x:Key="IconChevronDown">M7.5 10 12 14.5 16.5 10</StreamGeometry>
  <StreamGeometry x:Key="IconChevronRight">M10 7.5 14.5 12 10 16.5</StreamGeometry>
  <StreamGeometry x:Key="IconChevronLeft">M14 7.5 9.5 12 14 16.5</StreamGeometry>

  <!-- ============ 设置行 ============ -->
  <StreamGeometry x:Key="IconPower">M12 3.5V11 M6.9 6.4A7.5 7.5 0 1 0 17.1 6.4</StreamGeometry>
  <StreamGeometry x:Key="IconClipboard">M9 3.5h6a1 1 0 0 1 1 1v2H8v-2a1 1 0 0 1 1-1z M8 6.5H7A1.5 1.5 0 0 0 5.5 8v10.5A1.5 1.5 0 0 0 7 20h10a1.5 1.5 0 0 0 1.5-1.5V8A1.5 1.5 0 0 0 17 6.5h-1</StreamGeometry>
  <StreamGeometry x:Key="IconCalendar">M4.5 7.5A1.5 1.5 0 0 1 6 6h12a1.5 1.5 0 0 1 1.5 1.5v11A1.5 1.5 0 0 1 18 20H6a1.5 1.5 0 0 1-1.5-1.5z M4.5 10.5h15 M8.5 3.5V7.5 M15.5 3.5V7.5</StreamGeometry>
  <StreamGeometry x:Key="IconStorage">M12 3.5 20 7.5v9L12 20.5 4 16.5v-9z M4 7.5 12 11.5l8-4 M12 11.5v9</StreamGeometry>
  <StreamGeometry x:Key="IconClock">M12 4.5a7.5 7.5 0 1 0 0 15 7.5 7.5 0 0 0 0-15z M12 8.5V12l2.6 1.9</StreamGeometry>
  <StreamGeometry x:Key="IconSparkle">M12 3.9 13.9 8.9 18.6 10.8 13.9 12.7 12 17.7 10.1 12.7 5.4 10.8 10.1 8.9z M18.3 15.5 19.1 17.4 21 18.2 19.1 19 18.3 20.9 17.5 19 15.6 18.2 17.5 17.4z</StreamGeometry>

</ResourceDictionary>
