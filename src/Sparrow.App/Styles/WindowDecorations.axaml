<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:chrome="using:Avalonia.Controls.Chrome"
                    xmlns:templates="using:Avalonia.Markup.Xaml.Templates">

  <!--
    自绘窗口装饰（Avalonia 12）。
    框架默认模板会在顶栏画「窗口标题」，和工作区的品牌行重复；
    标题栏按钮又是固定的 45×30，和 48px 顶栏不齐。
    这里用 Window.WindowDecorationsTheme 接管整套装饰：
    - 顶栏只在 Underlay 留一块透明拖动区，不画标题文字；
    - 最小化 / 最大化 / 关闭按 46×48 铺满，hover 用应用的幽灵按钮语言；
    - 边框 / 阴影沿用 Fluent 的几何，避免最大化时露出白边。
  -->

  <!-- 标题栏按钮：透明底，hover 浮出 SurfaceHover，图标跟随 Foreground -->
  <ControlTheme x:Key="SparrowCaptionButton" TargetType="Button">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#9BA8BA" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="(WindowDecorationProperties.ElementRole)" Value="DecorationsElement" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="#242D3A" />
      <Setter Property="Foreground" Value="#E9EEF6" />
    </Style>

    <Style Selector="^:pressed">
      <Setter Property="Background" Value="#12171F" />
    </Style>
  </ControlTheme>

  <!-- 关闭按钮：hover 用系统红的语义色 -->
  <ControlTheme x:Key="SparrowCloseCaptionButton"
                TargetType="Button"
                BasedOn="{StaticResource SparrowCaptionButton}">
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="#C42B1C" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="#9E2114" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="SparrowWindowDecorations" TargetType="{x:Type chrome:WindowDrawnDecorations}">
    <Setter Property="DefaultTitleBarHeight" Value="48" />
    <Setter Property="DefaultFrameThickness" Value="1" />
    <Setter Property="DefaultShadowThickness" Value="8" />
    <Setter Property="Template">
      <templates:WindowDrawnDecorationsTemplate>
        <chrome:WindowDrawnDecorationsContent>

          <chrome:WindowDrawnDecorationsContent.Underlay>
            <Panel x:Name="PART_UnderlayWrapper">
              <Border x:Name="PART_WindowBorder"
                      Background="Transparent"
                      BorderThickness="{TemplateBinding FrameThickness}"
                      BorderBrush="#2B3543"
                      IsHitTestVisible="False" />

              <!-- 透明标题栏：只提供拖动 / 命中区域，文案由窗口自己的品牌行负责 -->
              <Panel x:Name="PART_TitleBar"
                     VerticalAlignment="Top"
                     Height="{TemplateBinding TitleBarHeight}"
                     Background="Transparent"
                     IsVisible="{TemplateBinding HasTitleBar}"
                     WindowDecorationProperties.ElementRole="TitleBar" />
            </Panel>
          </chrome:WindowDrawnDecorationsContent.Underlay>

          <chrome:WindowDrawnDecorationsContent.Overlay>
            <Panel x:Name="PART_OverlayWrapper">
              <StackPanel x:Name="PART_OverlayPanel"
                          VerticalAlignment="Top"
                          HorizontalAlignment="Right"
                          Height="{TemplateBinding TitleBarHeight}"
                          IsVisible="{TemplateBinding HasTitleBar}"
                          Orientation="Horizontal">

                <Button x:Name="PART_FullScreenButton"
                        Classes="caption"
                        IsVisible="False"
                        Theme="{StaticResource SparrowCaptionButton}"
                        WindowDecorationProperties.ElementRole="FullScreenButton">
                  <Path Width="10"
                        Height="10"
                        Stretch="Uniform"
                        Stroke="{Binding $parent[Button].Foreground}"
                        StrokeThickness="1.2"
                        Data="M1,4 L1,1 L4,1 M6,1 L9,1 L9,4 M9,6 L9,9 L6,9 M4,9 L1,9 L1,6" />
                </Button>

                <Button x:Name="PART_MinimizeButton"
                        Classes="caption"
                        Theme="{StaticResource SparrowCaptionButton}"
                        WindowDecorationProperties.ElementRole="MinimizeButton">
                  <Path Width="11"
                        Stroke="{Binding $parent[Button].Foreground}"
                        StrokeThickness="1"
                        Data="M0,5 L11,5" />
                </Button>

                <Button x:Name="PART_MaximizeButton"
                        Classes="caption"
                        Theme="{StaticResource SparrowCaptionButton}"
                        WindowDecorationProperties.ElementRole="MaximizeButton">
                  <Panel Width="11" Height="11">
                    <Path x:Name="MaximizeButtonPath"
                          Stretch="Uniform"
                          Stroke="{Binding $parent[Button].Foreground}"
                          StrokeThickness="1"
                          Data="M0.5,0.5 L10.5,0.5 L10.5,10.5 L0.5,10.5 Z" />
                    <Path x:Name="RestoreButtonPath"
                          Stretch="Uniform"
                          IsVisible="False"
                          Stroke="{Binding $parent[Button].Foreground}"
                          StrokeThickness="1"
                          Data="M2.5,2.5 L2.5,0.5 L10.5,0.5 L10.5,8.5 L8.5,8.5 M0.5,2.5 L8.5,2.5 L8.5,10.5 L0.5,10.5 Z" />
                  </Panel>
                </Button>

                <Button x:Name="PART_CloseButton"
                        Classes="caption close"
                        Theme="{StaticResource SparrowCloseCaptionButton}"
                        WindowDecorationProperties.ElementRole="CloseButton">
                  <Path Width="11"
                        Height="11"
                        Stretch="Uniform"
                        Stroke="{Binding $parent[Button].Foreground}"
                        StrokeThickness="1.1"
                        Data="M0.5,0.5 L10.5,10.5 M10.5,0.5 L0.5,10.5" />
                </Button>
              </StackPanel>
            </Panel>
          </chrome:WindowDrawnDecorationsContent.Overlay>

          <!-- 全屏时顶部悬浮条：只保留退出全屏和关闭 -->
          <chrome:WindowDrawnDecorationsContent.FullscreenPopover>
            <Panel Height="{TemplateBinding DefaultTitleBarHeight}"
                   VerticalAlignment="Top"
                   Background="#12171F"
                   WindowDecorationProperties.ElementRole="DecorationsElement">
              <StackPanel HorizontalAlignment="Right"
                          Orientation="Horizontal">
                <Button x:Name="PART_PopoverFullScreenButton"
                        Classes="caption"
                        IsVisible="False"
                        Theme="{StaticResource SparrowCaptionButton}"
                        WindowDecorationProperties.ElementRole="FullScreenButton">
                  <Path Width="10"
                        Height="10"
                        Stretch="Uniform"
                        Stroke="{Binding $parent[Button].Foreground}"
                        StrokeThickness="1.2"
                        Data="M1,4 L1,1 L4,1 M6,1 L9,1 L9,4 M9,6 L9,9 L6,9 M4,9 L1,9 L1,6" />
                </Button>
                <Button x:Name="PART_PopoverCloseButton"
                        Classes="caption close"
                        Theme="{StaticResource SparrowCloseCaptionButton}"
                        WindowDecorationProperties.ElementRole="CloseButton">
                  <Path Width="11"
                        Height="11"
                        Stretch="Uniform"
                        Stroke="{Binding $parent[Button].Foreground}"
                        StrokeThickness="1.1"
                        Data="M0.5,0.5 L10.5,10.5 M10.5,0.5 L0.5,10.5" />
                </Button>
              </StackPanel>
            </Panel>
          </chrome:WindowDrawnDecorationsContent.FullscreenPopover>

        </chrome:WindowDrawnDecorationsContent>
      </templates:WindowDrawnDecorationsTemplate>
    </Setter>

    <!-- 阴影：四周留出 8px，给窗口外边距和投影 -->
    <Style Selector="^:has-shadow /template/ Panel#PART_UnderlayWrapper">
      <Setter Property="Margin" Value="{TemplateBinding ShadowThickness}" />
    </Style>
    <Style Selector="^:has-shadow /template/ Border#PART_WindowBorder">
      <Setter Property="BoxShadow" Value="0 2 10 2 #80000000" />
    </Style>
    <Style Selector="^:has-shadow /template/ Panel#PART_OverlayWrapper">
      <Setter Property="Margin" Value="{TemplateBinding ShadowThickness}" />
    </Style>

    <!-- 边框：标题栏和按钮内缩 1px，避免压住外框 -->
    <Style Selector="^:has-border /template/ Panel#PART_TitleBar">
      <Setter Property="Margin" Value="1,1,1,0" />
    </Style>
    <Style Selector="^:has-border /template/ StackPanel#PART_OverlayPanel">
      <Setter Property="Margin" Value="0,1,1,0" />
    </Style>

    <!-- 最大化：换成「还原」图标 -->
    <Style Selector="^:maximized /template/ Path#MaximizeButtonPath">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:maximized /template/ Path#RestoreButtonPath">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- 平台不支持的动作直接隐藏，不留空位 -->
    <Style Selector="^:not(:has-minimize) /template/ Button#PART_MinimizeButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:not(:has-maximize) /template/ Button#PART_MaximizeButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:not(:has-fullscreen) /template/ Button#PART_FullScreenButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:not(:has-fullscreen) /template/ Button#PART_PopoverFullScreenButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="^ /template/ Button:disabled">
      <Setter Property="Opacity" Value="0.25" />
    </Style>

    <!-- 全屏：悬浮条接管 -->
    <Style Selector="^:fullscreen /template/ StackPanel#PART_OverlayPanel">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:fullscreen /template/ Panel#PART_TitleBar">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
