<Project Sdk="Microsoft.NET.Sdk">

  <!--
    来源：Lertaro (MIT)，https://github.com/Lertaro/Lertaro
    仅 vendor 索引相关能力（MFT / Snapshot / 查询），原样保留，便于后续对比上游。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Lertaro.Core</AssemblyName>
    <RootNamespace>Lertaro.Core</RootNamespace>
    <Version>3.5.6</Version>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- IndexV2 reads its memory-mapped snapshot through typed spans over a raw view pointer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PluginSdk\PluginSdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lertaro.Core.Tests" />
    <InternalsVisibleTo Include="Lertaro.App" />
    <InternalsVisibleTo Include="Lertaro.App.Tests" />
    <InternalsVisibleTo Include="Lertaro.Plugins.PinyinAlias.Tests" />
    <!-- Sparrow 宿主与提权索引进程需要直接调用 MFT / Snapshot 的内部 API -->
    <InternalsVisibleTo Include="Sparrow.App" />
    <InternalsVisibleTo Include="Sparrow.IndexBuilder" />
    <InternalsVisibleTo Include="Sparrow.IndexService" />
  </ItemGroup>

</Project>
