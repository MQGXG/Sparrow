<Project>

  <!--
    集中包管理：所有项目的包版本只在这里定义。
    规则见 docs/architecture.md 第五节，任何包升版本都要先改这里。
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDK 唯一允许的日志抽象，不引入具体实现 -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />

    <!-- UI：版本钉死，见 docs/architecture.md 第五节 -->
    <PackageVersion Include="Avalonia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <!-- 图像编解码：版本跟随 Avalonia，勿升 4.x（见 docs/architecture.md） -->
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <!-- SVG 预览：5.1.x 才依赖 SkiaSharp 3.x；5.2 会拉 4.148 与 Avalonia 冲突 -->
    <PackageVersion Include="Svg.Skia" Version="5.1.1" />

    <!-- OCR：PP-OCRv5 本地模型 + PaddleInference（见 docs/plugin-model.md 的 C 档） -->
    <PackageVersion Include="Sdcb.PaddleOCR" Version="3.3.1" />
    <PackageVersion Include="Sdcb.PaddleOCR.Models.Local" Version="3.3.1" />
    <PackageVersion Include="Sdcb.PaddleOCR.Models.LocalV5" Version="3.3.1" />
    <PackageVersion Include="Sdcb.PaddleInference.runtime.win64.mkl" Version="3.3.1.70" />
    <PackageVersion Include="OpenCvSharp4" Version="4.11.0.20250507" />
    <PackageVersion Include="OpenCvSharp4.runtime.win" Version="4.11.0.20250507" />

    <!-- OCR 轻量替代验证：纯 ONNX + SkiaSharp，无 OpenCV/Paddle 原生库 -->
    <PackageVersion Include="RapidOcrNet" Version="4.2.0" />

    <!-- 测试栈：xunit v3（Avalonia.Headless.XUnit 12.1.6 依赖 extensibility.core 3.2.2） -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />

    <!-- 无头 UI 测试：验证键盘路由，不依赖 Win32 按键注入 -->
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.6" />
  </ItemGroup>

</Project>
