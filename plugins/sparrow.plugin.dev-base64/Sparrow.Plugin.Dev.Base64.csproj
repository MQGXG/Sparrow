<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Sparrow.Plugin.Dev.Base64</AssemblyName>
    <RootNamespace>Sparrow.Plugin.Dev.Base64</RootNamespace>
    <Version>1.0.0</Version>
    <Description>Base64 编码 / 解码（支持 URL-safe）</Description>
    <!-- 必须等于 plugin.json 的 id 与目录名 -->
    <PluginId>sparrow.plugin.dev-base64</PluginId>
  </PropertyGroup>

  <ItemGroup>
    <!-- ★ 不能把 SDK 拷进插件目录，否则 ALC 里的 ITool 会和宿主的不一致 -->
    <ProjectReference Include="..\..\src\Sparrow.Plugin.Sdk\Sparrow.Plugin.Sdk.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
