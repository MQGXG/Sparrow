<Project>

  <!--
    所有插件共享的构建行为：把产物复制到宿主输出目录的 plugins/<PluginId>/。

    插件项目只需声明 <PluginId>，不需要知道宿主在哪，也不需要改宿主 csproj。
    这是「加一个目录就能加一个工具」在构建期的保障。

    注意：插件不通过 App 的 ProjectReference 构建，所以开发时需要
    `dotnet build`（整个解决方案）而不是只 build App。
  -->
  <!--
    插件只能引用 Sparrow.Plugin.Sdk。
    一旦某个插件项目引用了宿主，宿主类型就会被带进插件程序集，
    「目录即插件」会静默退化成「编译期内置」——这里直接让构建失败。
  -->
  <Target Name="ForbidHostReference" BeforeTargets="ResolveProjectReferences">
    <PropertyGroup>
      <_ReferencedProjects>@(ProjectReference->'%(Filename)','|')</_ReferencedProjects>
    </PropertyGroup>
    <Error Condition="$([System.String]::Copy('$(_ReferencedProjects)').Contains('Sparrow.App'))"
           Text="插件 $(MSBuildProjectName) 不得引用 Sparrow.App，只能引用 Sparrow.Plugin.Sdk。" />
  </Target>

  <!--
    铁律 1.1：Avalonia 与 Sparrow.Plugin.Ui 必须由宿主解析。
    插件目录里出现副本会让 Control / UI 契约类型分裂，宿主强转失败，
    而且主题资源取不到、ALC 更回收不了。构建期直接失败，别等到运行期静默不显示。
  -->
  <Target Name="ForbidHostUiCopy" BeforeTargets="CopyPluginToHost">
    <ItemGroup>
      <_ForbiddenUiArtifacts Include="$(TargetDir)Avalonia*.dll" />
      <_ForbiddenUiArtifacts Include="$(TargetDir)Sparrow.Plugin.Ui.dll"
                             Condition="Exists('$(TargetDir)Sparrow.Plugin.Ui.dll')" />
    </ItemGroup>
    <Error Condition="'@(_ForbiddenUiArtifacts)' != ''"
           Text="插件 $(MSBuildProjectName) 的产物里出现了 @(_ForbiddenUiArtifacts->'%(Filename)%(Extension)', ', ')：Avalonia 与 Sparrow.Plugin.Ui 必须由宿主解析。请在插件项目里对这两个引用使用 Private=false + ExcludeAssets=runtime。" />
  </Target>

  <Target Name="CopyPluginToHost"
          AfterTargets="Build"
          Condition="'$(PluginId)' != ''">

    <PropertyGroup>
      <!-- 宿主输出目录的 TFM 和插件自己的 TFM 不是一回事：插件是 net10.0，
           宿主是 net10.0-windows...；写死 $(TargetFramework) 会复制到旧目录。 -->
      <_PluginHostDir>$(MSBuildThisFileDirectory)..\src\Sparrow.App\bin\$(Configuration)\$(SparrowHostTargetFramework)\plugins\$(PluginId)</_PluginHostDir>
    </PropertyGroup>

    <ItemGroup>
      <_PluginArtifacts Include="$(TargetDir)**\*" />
      <!-- 铁律 1：SDK 由宿主解析，插件目录里绝不能出现它的副本 -->
      <_PluginArtifacts Remove="$(TargetDir)Sparrow.Plugin.Sdk.*" />
    </ItemGroup>

    <Copy SourceFiles="@(_PluginArtifacts)"
          DestinationFiles="@(_PluginArtifacts->'$(_PluginHostDir)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <Message Importance="normal" Text="插件 $(PluginId) 已同步到 $(_PluginHostDir)" />
  </Target>

</Project>
