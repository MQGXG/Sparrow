<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- 测试项目引用 App，TFM 必须跟着 App 走（WGC 需要 Windows SDK 投影） -->
    <TargetFramework>$(SparrowHostTargetFramework)</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- xunit v3 的测试项目是独立可执行程序 -->
    <OutputType>Exe</OutputType>
    <AssemblyName>Sparrow.Tests</AssemblyName>
    <RootNamespace>Sparrow.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- 测试项目是「宿主侧」的模拟，所以它需要 SDK、UI 契约、插件、以及壳层四个引用 -->
    <ProjectReference Include="..\..\src\Sparrow.Plugin.Sdk\Sparrow.Plugin.Sdk.csproj" />
    <ProjectReference Include="..\..\src\Sparrow.Plugin.Ui\Sparrow.Plugin.Ui.csproj" />
    <ProjectReference Include="..\..\plugins\sparrow.plugin.json-format\Sparrow.Plugin.Json.Format.csproj" />
    <ProjectReference Include="..\..\plugins\sparrow.plugin.dev-base64\Sparrow.Plugin.Dev.Base64.csproj" />
    <ProjectReference Include="..\..\plugins\sparrow.plugin.ocr\Sparrow.Plugin.Ocr.csproj" />
    <ProjectReference Include="..\..\plugins\sparrow.plugin.translate\Sparrow.Plugin.Translate.csproj" />
    <ProjectReference Include="..\..\plugins\sparrow.plugin.svg-prompt\Sparrow.Plugin.Svg.Prompt.csproj" />
    <ProjectReference Include="..\..\plugins\sparrow.plugin.images-convert\Sparrow.Plugin.Images.Convert.csproj" />
    <ProjectReference Include="..\..\plugins\sparrow.plugin.images-resize\Sparrow.Plugin.Images.Resize.csproj" />
    <ProjectReference Include="..\..\plugins\sparrow.plugin.files-hash\Sparrow.Plugin.Files.Hash.csproj" />
    <ProjectReference Include="..\..\plugins\sparrow.plugin.window-pin\Sparrow.Plugin.Window.Pin.csproj" />
    <!-- 只为测 ToolRegistry / PaletteViewModel，不启动 Avalonia -->
    <ProjectReference Include="..\..\src\Sparrow.App\Sparrow.App.csproj" />

    <!-- P3 spike：只保证构建顺序，不把插件程序集引用进测试（否则就不在独立 ALC 里了） -->
    <ProjectReference Include="..\Sparrow.Plugin.UiSpike\Sparrow.Plugin.UiSpike.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <!-- 把 spike 插件产物复制到测试输出，供 PluginLoader 从独立目录加载 -->
  <Target Name="CopyUiSpikePlugin" AfterTargets="Build">
    <ItemGroup>
      <_UiSpikeArtifacts Include="..\Sparrow.Plugin.UiSpike\bin\$(Configuration)\net10.0\Sparrow.Plugin.UiSpike.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_UiSpikeArtifacts)"
          DestinationFolder="$(OutDir)ui-spike"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
